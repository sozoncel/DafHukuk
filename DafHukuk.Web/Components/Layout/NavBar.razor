@code {
    private string CurrentLang => LanguageService.GetCurrentLanguage();
    private bool isMobileMenuOpen = false;
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
        await ManageBodyScroll();
    }

    private async Task CloseMobileMenu()
    {
        if (isMobileMenuOpen)
        {
            isMobileMenuOpen = false;
            await ManageBodyScroll();
        }
    }

    // Menü açıldığında arkanın kaymasını (scroll) önleyen kod
    private async Task ManageBodyScroll()
    {
        try
        {
            if (isMobileMenuOpen)
                await JS.InvokeVoidAsync("eval", "document.body.style.overflow = 'hidden';");
            else
                await JS.InvokeVoidAsync("eval", "document.body.style.overflow = '';");
        }
        catch { }
    }

