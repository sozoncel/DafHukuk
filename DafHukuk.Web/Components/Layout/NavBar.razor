@inject ILanguageService LanguageService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<header class="header" id="site-header">
    <div class="nav-inner">
        @* 2. Madde için Not: Logo görseli Image 2'deki gibi iki satırlı olanla değiştirilmelidir *@
        @* <a href="@GetLocalizedUrl("")" class="logo-link"><div class="logo">@GetText("siteName")</div></a> *@
        <a href="@GetLocalizedUrl("")" class="logo-link">
            <div class="logo">
                <div class="logo-main">DAF</div>
                <div class="logo-sub">Hukuk & Danışmanlık</div>
            </div>
        </a>

        <nav class="menu">
            <div class="underline-effect">
                <a href="@GetLocalizedUrl("hakkimizda")">@GetText("about")</a>
                <a href="@GetLocalizedUrl("ekibimiz")">@GetText("team")</a>

                @* Hizmetlerimiz Dropdown Yapısı *@
          @*       <div class="nav-item dropdown">
                    <a href="@GetLocalizedUrl("hizmetlerimiz")" class="dropdown-toggle">@GetText("services")</a>
                    <div class="dropdown-menu">
                        <a href="@GetLocalizedUrl("hizmetlerimiz/genel-hizmetler")">@GetText("genelHizmetler")</a>
                        <a href="@GetLocalizedUrl("hizmetlerimiz/ozel-danismanlik")">@GetText("ozelDanismanlik")</a>
                        <a href="@GetLocalizedUrl("hizmetlerimiz/uzman-gorusu")">@GetText("uzmanGorusu")</a>
                        <a href="@GetLocalizedUrl("hizmetlerimiz/arabuluculuk")">@GetText("arabuluculuk")</a>
                    </div>
                </div> *@

                <div class="nav-item dropdown">
                    <a href="@GetLocalizedUrl("hizmetlerimiz")" class="dropdown-toggle">@GetText("services")</a>
                    <div class="dropdown-menu">
                        @* Genel Hizmetler ve Alt Menüsü *@
                        <div class="dropdown-submenu">
                            <a href="@GetLocalizedUrl("hizmetlerimiz/genel-hizmetler")" class="submenu-toggle">@GetText("genelHizmetler") <i class="fas fa-chevron-right"></i></a>
                            <div class="submenu-content">
                                <a href="@GetLocalizedUrl("hizmetlerimiz/genel-hizmetler/ceza-hukuku")">@GetText("cezaHukuku")</a>
                                <a href="@GetLocalizedUrl("hizmetlerimiz/genel-hizmetler/idare-vergi")">@GetText("idareVergi")</a>
                                <a href="@GetLocalizedUrl("hizmetlerimiz/genel-hizmetler/kabahatler")">@GetText("kabahatler")</a>
                                <a href="@GetLocalizedUrl("hizmetlerimiz/genel-hizmetler/anayasa-aihm")">@GetText("anayasaAihm")</a>
                                @* Dökümandaki diğer 12 maddeyi buraya ekleyebilirsin *@
                            </div>
                        </div>

                        @* Özel Danışmanlık ve Alt Menüsü *@
                        <div class="dropdown-submenu">
                            <a href="@GetLocalizedUrl("hizmetlerimiz/ozel-danismanlik")" class="submenu-toggle">@GetText("ozelDanismanlik") <i class="fas fa-chevron-right"></i></a>
                            <div class="submenu-content">
                                <a href="@GetLocalizedUrl("hizmetlerimiz/ozel-danismanlik/osb-kobi")">@GetText("osbKobi")</a>
                                <a href="@GetLocalizedUrl("hizmetlerimiz/ozel-danismanlik/savunma-sanayi")">@GetText("savunmaSanayi")</a>
                                <a href="@GetLocalizedUrl("hizmetlerimiz/ozel-danismanlik/yesil-finans")">@GetText("yesilFinans")</a>
                                @* Dökümandaki diğer 12 maddeyi buraya ekleyebilirsin *@
                            </div>
                        </div>

                        <a href="@GetLocalizedUrl("hizmetlerimiz/uzman-gorusu")">@GetText("uzmanGorusu")</a>
                        <a href="@GetLocalizedUrl("hizmetlerimiz/arabuluculuk")">@GetText("arabuluculuk")</a>
                    </div>
                </div>

                <a href="@GetLocalizedPartners()">@GetText("partners")</a>
                <a href="@GetLocalizedUrl("yayinlar")">@GetText("publications")</a>
                <a href="@GetLocalizedUrl("kariyer")">@GetText("career")</a>
                <a href="@GetLocalizedUrl("iletisim")">@GetText("contact")</a>
            </div>
        </nav>

        <div class="right-actions">
            <div class="language-Selection">
                <a href="@GetLanguageChangeUrl("en")"
                   class="navbar-lang-link @(CurrentLang == "en" ? "active" : "")"
                   @onclick="@(() => OnLanguageClick("en"))">
                    <img src="/img/Ortak/flag-en.svg" alt="EN" class="flag-icon">
                    <span>EN</span>
                </a>

                <a href="@GetLanguageChangeUrl("ar")"
                   class="navbar-lang-link @(CurrentLang == "ar" ? "active" : "")"
                   @onclick="@(() => OnLanguageClick("ar"))">
                    <img src="/img/Ortak/flag-ar.png" alt="AR" class="flag-icon">
                    <span>AR</span>
                </a>

                <a href="@GetLanguageChangeUrl("tr")"
                   class="navbar-lang-link @(CurrentLang == "tr" ? "active" : "")"
                   @onclick="@(() => OnLanguageClick("tr"))">
                    <img src="/img/Ortak/flag-tr.svg" alt="TR" class="flag-icon">
                    <span>TR</span>
                </a>
            </div>
            <button type="button" class="search-trigger" id="search-trigger">
                <i class="fa fa-search"></i>
            </button>
        </div>

        <div class="mobile-menu-btn" id="mobile-menu-btn">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
    @* ... Search Bar Kodları Mevcut Haliyle Kalacak ... *@
</header>

@code {
    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["home"] = "Ana Sayfa",
            ["about"] = "Hakkımızda",
            ["services"] = "Hizmetlerimiz",
            ["genelHizmetler"] = "Genel Hizmetler",
            ["ozelDanismanlik"] = "Özel Danışmanlık Hizmet Paketleri",
            ["uzmanGorusu"] = "Uzman Görüşü (Adli Bilimler)",
            ["arabuluculuk"] = "Arabuluculuk",
            ["team"] = "Ekibimiz",
            ["partners"] = "Çözüm Ortakları",
            ["publications"] = "Yayınlar",
            ["career"] = "Kariyer",
            ["contact"] = "İletişim",
            ["siteName"] = "DAF Hukuk & Danışmanlık",
            ["search"] = "Ara",
            ["searchPlaceholder"] = "İçerik Arayın..."
        },
        ["en"] = new()
        {
            ["home"] = "Home",
            ["about"] = "About Us",
            ["services"] = "Services",
            ["genelHizmetler"] = "General Services",
            ["ozelDanismanlik"] = "Special Consultancy Packages",
            ["uzmanGorusu"] = "Expert Opinion",
            ["arabuluculuk"] = "Mediation",
            ["team"] = "Our Team",
            ["partners"] = "Partners",
            ["publications"] = "Publications",
            ["career"] = "Careers",
            ["contact"] = "Contact",
            ["siteName"] = "DAF Law & Consultancy",
            ["search"] = "Search",
            ["searchPlaceholder"] = "Search Content..."
        },
        ["ar"] = new()
        {
            ["home"] = "الصفحة الرئيسية",
            ["about"] = "من نحن",
            ["services"] = "خدماتنا",
            ["genelHizmetler"] = "الخدمات العامة",
            ["ozelDanismanlik"] = "حزم الاستشارات الخاصة",
            ["uzmanGorusu"] = "رأي الخبراء",
            ["arabuluculuk"] = "الوساطة",
            ["team"] = "فريقنا",
            ["partners"] = "الشركاء",
            ["publications"] = "منشورات",
            ["career"] = "وظائف",
            ["contact"] = "اتصل بنا",
            ["siteName"] = "داف للمحاماة والاستشارات",
            ["search"] = "بحث",
            ["searchPlaceholder"] = "ابحث عن المحتوى..."
        }
    };

    private string GetText(string key) => (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key)) ? Translations[CurrentLang][key] : key;
    private string GetLocalizedUrl(string path) => LanguageService.GetLocalizedUrl(path);
    private string GetLocalizedPartners() => CurrentLang switch { "en" => "/en/partners", "ar" => "/ar/partners", _ => "/cozum-ortaklari" };
    private string GetLanguageChangeUrl(string newLang) => $"/language/change?lang={newLang}&returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).AbsolutePath)}";
    private async Task OnLanguageClick(string newLang) => await JS.InvokeVoidAsync("eval", $@"document.cookie = 'user_language={newLang}; path=/; max-age=31536000; SameSite=Lax';");
}