    private string GetLocalizedUrl(string path) => LanguageService.GetLocalizedUrl(path);
    private string GetLocalizedPartners() => CurrentLang switch { "en" => "/en/partners", "ar" => "/ar/partners", _ => "/cozum-ortaklari" };
    private string GetLanguageChangeUrl(string newLang) => $"/language/change?lang={newLang}&returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).AbsolutePath)}";
    private async Task OnLanguageClick(string newLang) => await JS.InvokeVoidAsync("eval", $@"document.cookie = 'user_language={newLang}; path=/; max-age=31536000; SameSite=Lax';");
