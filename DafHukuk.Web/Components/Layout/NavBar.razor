@inject ILanguageService LanguageService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<!--Üst Menü Başlangıcı-->
<header class="header" id="site-header">

    <div class="nav-inner">
        <a href="@GetLocalizedUrl("")" class="logo-link"><div class="logo">@GetText("siteName")</div></a>
        <nav class="menu">
            <div class="underline-effect">
                <a href="@GetLocalizedUrl("hakkimizda")">@GetText("about")</a>
                <a href="@GetLocalizedUrl("hizmetlerimiz")">@GetText("services")</a>
                <a href="@GetLocalizedUrl("ekibimiz")">@GetText("team")</a>
                <a href="@GetLocalizedUrl("duyurular")">@GetText("announcements")</a>
                <a href="@GetLocalizedUrl("yayinlar")">@GetText("publications")</a>
                <a href="@GetLocalizedUrl("etkinlikler")">@GetText("events")</a>
                <a href="@GetLocalizedUrl("kariyer")">@GetText("career")</a>
                <a href="@GetLocalizedUrl("iletisim")">@GetText("contact")</a>
            </div>
        </nav>

        <div class="right-actions">
            <!--Dil Seçim Kısmı-->
            <div class="language-Selection">
                <a href="@GetLanguageChangeUrl("en")"
                   class="navbar-lang-link @(CurrentLang == "en" ? "active" : "")"
                   @onclick="@(() => OnLanguageClick("en"))">
                    <img src="/img/Ortak/flag-en.svg" alt="EN" class="flag-icon">
                    <span>EN</span>
                </a>

                <a href="@GetLanguageChangeUrl("ar")"
                   class="navbar-lang-link @(CurrentLang == "ar" ? "active" : "")"
                   @onclick="@(() => OnLanguageClick("ar"))">
                    <img src="/img/Ortak/flag-ar.png" alt="AR" class="flag-icon">
                    <span>AR</span>
                </a>

                <a href="@GetLanguageChangeUrl("tr")"
                   class="navbar-lang-link @(CurrentLang == "tr" ? "active" : "")"
                   @onclick="@(() => OnLanguageClick("tr"))">
                    <img src="/img/Ortak/flag-tr.svg" alt="TR" class="flag-icon">
                    <span>TR</span>
                </a>
            </div>
            <!--Arama Kısmı-->
            <button type="button" class="search-trigger" id="search-trigger">
                <i class="fa fa-search"></i>
            </button>
        </div>

        <!--Mobile Menu Button-->
        <div class="mobile-menu-btn" id="mobile-menu-btn">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>

    <!--Desktop Search Bar-->
    <div class="desktop-search-bar" id="desktop-search-bar">
        <div class="search-bar-inner">
            <input type="text"
                   class="search-input"
                   placeholder="@GetText("searchPlaceholder")"
                   id="desktop-search-input">
            <button type="button" class="search-close-btn" id="desktop-search-close">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>

    <!--Mobile Menu-->
    <div id="mobile-menu">
        <div class="mobile-menu-close" id="mobile-menu-close">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>

        <!--Mobile Search Trigger-->
        <div class="mobile-search-trigger" id="mobile-search-trigger">
            <i class="fa fa-search"></i>
            <span>@GetText("search")</span>
        </div>

        <a href="@GetLocalizedUrl("")">@GetText("home")</a>
        <a href="@GetLocalizedUrl("hakkimizda")">@GetText("about")</a>
        <a href="@GetLocalizedUrl("hizmetlerimiz")">@GetText("services")</a>
        <a href="@GetLocalizedUrl("ekibimiz")">@GetText("team")</a>
        <a href="@GetLocalizedUrl("duyurular")">@GetText("announcements")</a>
        <a href="@GetLocalizedUrl("yayinlar")">@GetText("publications")</a>
        <a href="@GetLocalizedUrl("etkinlikler")">@GetText("events")</a>
        <a href="@GetLocalizedUrl("kariyer")">@GetText("career")</a>
        <a href="@GetLocalizedUrl("iletisim")">@GetText("contact")</a>

        <div class="mobile-lang-links">
            <a href="@GetLanguageChangeUrl("en")"
               class="@(CurrentLang == "en" ? "active" : "")"
               @onclick="@(() => OnLanguageClick("en"))">
                <img src="/img/Ortak/flag-en.svg" alt="EN" class="flag-icon">
                <span>EN</span>
            </a>
            <a href="@GetLanguageChangeUrl("ar")"
               class="@(CurrentLang == "ar" ? "active" : "")"
               @onclick="@(() => OnLanguageClick("ar"))">
                <img src="/img/Ortak/flag-ar.png" alt="AR" class="flag-icon">
                <span>AR</span>
            </a>
            <a href="@GetLanguageChangeUrl("tr")"
               class="@(CurrentLang == "tr" ? "active" : "")"
               @onclick="@(() => OnLanguageClick("tr"))">
                <img src="/img/Ortak/flag-tr.svg" alt="TR" class="flag-icon">
                <span>TR</span>
            </a>
        </div>
    </div>

    <div class="mobile-overlay" id="mobile-overlay"></div>
</header>

<!--Mobile Search Overlay-->
<div class="mobile-search-overlay" id="mobile-search-overlay">
    <div class="mobile-search-close" id="mobile-search-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </div>
    <div class="mobile-search-content">
        <input type="text"
               class="mobile-search-input"
               placeholder="@GetText("searchPlaceholder")"
               id="mobile-search-input">
    </div>
</div>

@code {
    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override void OnInitialized()
    {
        // URL değişikliğinde navbar'ı güncelle
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Memory leak önlemek için event'i temizle
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["home"] = "Ana Sayfa",
            ["about"] = "Hakkımızda",
            ["services"] = "Hizmetlerimiz",
            ["team"] = "Ekibimiz",
            ["announcements"] = "Duyurular",
            ["publications"] = "Yayınlar",
            ["events"] = "Etkinlikler",
            ["career"] = "Kariyer",
            ["contact"] = "İletişim",
            ["siteName"] = "DAF Hukuk ve Danışmanlık",
            ["search"] = "Ara",
            ["searchPlaceholder"] = "İçerik Arayın..."
        },
        ["en"] = new()
        {
            ["home"] = "Home",
            ["about"] = "About Us",
            ["services"] = "Services",
            ["team"] = "Our Team",
            ["announcements"] = "Announcements",
            ["publications"] = "Publications",
            ["events"] = "Events",
            ["career"] = "Careers",
            ["contact"] = "Contact",
            ["siteName"] = "DAF LAW FIRM",
            ["search"] = "Search",
            ["searchPlaceholder"] = "Search Content..."
        },
        ["ar"] = new()
        {
            ["home"] = "الصفحة الرئيسية",
            ["about"] = "من نحن",
            ["services"] = "خدماتنا",
            ["team"] = "فريقنا",
            ["announcements"] = "إعلانات",
            ["publications"] = "منشورات",
            ["events"] = "فعاليات",
            ["career"] = "وظائف",
            ["contact"] = "اتصل بنا",
            ["siteName"] = "داف للمحاماة",
            ["search"] = "بحث",
            ["searchPlaceholder"] = "ابحث عن المحتوى..."
        }
    };

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];
        return key;
    }

    private string GetLocalizedUrl(string path)
    {
        return LanguageService.GetLocalizedUrl(path);
    }
    private string GetLanguageChangeUrl(string newLang)
    {
        var uri = new Uri(Navigation.Uri);
        var currentPath = uri.AbsolutePath + uri.Query;
        return $"/language/change?lang={newLang}&returnUrl={Uri.EscapeDataString(currentPath)}";
    }

    private async Task OnLanguageClick(string newLang)
    {
        await JS.InvokeVoidAsync("eval", $@"
            document.cookie = 'user_language={newLang}; path=/; max-age=31536000; SameSite=Lax';
        ");
    }
}