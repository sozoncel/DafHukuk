@page "/hizmetlerimiz/{slug}"
@page "/en/services/{slug}"
@page "/ar/services/{slug}"

@page "/duyurular/{slug}"
@page "/en/announcements/{slug}"
@page "/ar/announcements/{slug}"

@page "/etkinlikler/{slug}"
@page "/en/events/{slug}"
@page "/ar/events/{slug}"

@page "/yayinlar/{slug}"
@page "/en/publications/{slug}"
@page "/ar/publications/{slug}"

@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@inject DafHukuk.Service.Interfaces.IPostService PostService
@inject DafHukuk.Service.ILanguageService LanguageService
@inject NavigationManager NavManager

@code {
    [Parameter] public string slug { get; set; } = string.Empty;

    private Post? currentPost;
    private Post? featuredPost;
    private List<Post> allPosts = new();

    private string PageType = "Services";
    private List<Post> servicePosts = new();
    private List<Post> otherPostsInSameCategory = new();

    private List<Post> relatedPosts = new();
    private List<Category> distinctCategories = new();
    private bool ShowingAll = false;
    private int InitialDisplayCount = 8;
    private int CurrentFilterCategory = 0;

    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allPosts = await PostService.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hata PostService.GetAll(): {ex.Message}");
            allPosts = new List<Post>();
        }

        var prefix = GetPostUrlPrefix();
        PageType = prefix switch
        {
            "hizmetlerimiz" or "services" => "Services",
            "duyurular" or "announcements" => "Announcements",
            "etkinlikler" or "events" => "Events",
            "yayinlar" or "publications" or "yayınlar" => "Publications",
            _ => "Unknown"
        };

        currentPost = GetPostBySlug(slug);

        if (currentPost != null)
        {
            if (PageType == "Services")
            {
                servicePosts = allPosts
                    .Where(p => p.Category != null &&
                                (string.Equals(p.Category.Name_TR?.Trim(), "Hizmetlerimiz", StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(p.Category.Name_EN?.Trim(), "Our Services", StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(p.Category.Name_AR?.Trim(), "خدماتنا", StringComparison.OrdinalIgnoreCase))
                                && p.Id != currentPost.Id && p.IsActive)
                    .OrderBy(p => GetPostTitle(p))
                    .ToList();
            }
            else if (currentPost.Category != null)
            {
                otherPostsInSameCategory = allPosts
                    .Where(p => p.Category != null &&
                                p.Category.Id == currentPost.Category.Id &&
                                p.Id != currentPost.Id && p.IsActive)
                    .OrderByDescending(p => p.PublishedDate)
                    .Take(10)
                    .ToList();
            }
        }

        var dateCutOff = DateTime.Now.AddMonths(-12);
        var recent = allPosts
            .Where(p => p.Id != currentPost?.Id &&
                        p.PublishedDate >= dateCutOff &&
                        p.IsActive &&
                        HasContentInCurrentLanguage(p))
            .ToList();

        var candidateList = recent.Any()
            ? recent
            : allPosts.Where(p => p.Id != currentPost?.Id &&
                                 p.IsActive &&
                                 HasContentInCurrentLanguage(p))
                     .ToList();

        if (candidateList.Any())
        {
            var rnd = new Random();
            featuredPost = candidateList[rnd.Next(candidateList.Count)];
        }

        relatedPosts = allPosts
            .Where(p => p.Id != currentPost?.Id &&
                        p.IsActive &&
                        HasContentInCurrentLanguage(p))
            .OrderByDescending(p => p.PublishedDate)
            .ToList();

        distinctCategories = relatedPosts
            .Select(p => p.Category)
            .Where(c => c != null)
            .DistinctBy(c => c!.Id)
            .OrderBy(c => GetCategoryName(c))
            .ToList()!;
    }

    private bool HasContentInCurrentLanguage(Post post)
    {
        return CurrentLang switch
        {
            "en" => !string.IsNullOrWhiteSpace(post.Title_EN) && !string.IsNullOrWhiteSpace(post.Content_EN),
            "ar" => !string.IsNullOrWhiteSpace(post.Title_AR) && !string.IsNullOrWhiteSpace(post.Content_AR),
            _ => !string.IsNullOrWhiteSpace(post.Title_TR) && !string.IsNullOrWhiteSpace(post.Content_TR)
        };
    }

    // ✅ DÜZELTME: URL decode eklendi
    private string GetPostUrlPrefix()
    {
        var path = NavManager.ToAbsoluteUri(NavManager.Uri).AbsolutePath;

        // URL decode işlemi - %20 gibi encoded karakterleri düzelt
        path = Uri.UnescapeDataString(path).ToLowerInvariant();

        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();

        if (parts.Any() && (parts[0] == "en" || parts[0] == "ar"))
            parts.RemoveAt(0);

        if (parts.Any())
        {
            var firstPart = parts[0].Trim();

            // İngilizce ve Arapça path'leri normalize et
            return firstPart switch
            {
                "our services" or "خدماتنا" => "services",
                _ => firstPart
            };
        }

        return "";
    }

    private Post? GetPostBySlug(string slugValue)
    {
        if (string.IsNullOrWhiteSpace(slugValue)) return null;

        slugValue = slugValue.Trim();
        var posts = allPosts.Where(p => p.IsActive).ToList();

        return CurrentLang switch
        {
            "en" => posts.FirstOrDefault(p => string.Equals(p.Slug_EN, slugValue, StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(p.Slug_TR, slugValue, StringComparison.OrdinalIgnoreCase)),
            "ar" => posts.FirstOrDefault(p => string.Equals(p.Slug_AR, slugValue, StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(p.Slug_TR, slugValue, StringComparison.OrdinalIgnoreCase)),
            _ => posts.FirstOrDefault(p => string.Equals(p.Slug_TR, slugValue, StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(p.Slug_EN, slugValue, StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(p.Slug_AR, slugValue, StringComparison.OrdinalIgnoreCase))
        };
    }

    private string GetFeaturedUrl()
    {
        if (featuredPost == null || featuredPost.Category == null) return "#";
        return GetPostUrl(featuredPost);
    }

    private string GetCategorySlug(Category category)
    {
        if (category == null) return "";

        var categoryName = (category.Name_TR ?? category.Name_EN ?? category.Name_AR ?? "")
            .ToLowerInvariant()
            .Trim();

        return categoryName switch
        {
            "hizmetlerimiz" or "our services" or "خدماتنا"
                => CurrentLang == "en" ? "services"
                 : CurrentLang == "ar" ? "services"
                 : "hizmetlerimiz",

            "duyurular" or "announcements" or "الإعلانات"
                => CurrentLang == "en" ? "announcements"
                 : CurrentLang == "ar" ? "announcements"
                 : "duyurular",

            "etkinlikler" or "events" or "الفعاليات"
                => CurrentLang == "en" ? "events"
                 : CurrentLang == "ar" ? "events"
                 : "etkinlikler",

            "yayınlar" or "yayinlar" or "publications" or "المنشورات"
                => CurrentLang == "en" ? "publications"
                 : CurrentLang == "ar" ? "publications"
                 : "yayinlar",

            _ => CurrentLang == "en" ? "publications"
               : CurrentLang == "ar" ? "publications"
               : "yayinlar"
        };
    }

    private string GetPostUrl(Post post)
    {
        if (post?.Category == null) return "#";

        var categorySlug = GetCategorySlug(post.Category);
        var postSlug = CurrentLang switch
        {
            "en" => post.Slug_EN ?? post.Slug_TR,
            "ar" => post.Slug_AR ?? post.Slug_TR,
            _ => post.Slug_TR ?? post.Slug_EN
        };

        if (string.IsNullOrWhiteSpace(postSlug))
        {
            return CurrentLang switch
            {
                "en" => $"/en/{categorySlug}",
                "ar" => $"/ar/{categorySlug}",
                _ => $"/{categorySlug}"
            };
        }

        return CurrentLang switch
        {
            "en" => $"/en/{categorySlug}/{postSlug}",
            "ar" => $"/ar/{categorySlug}/{postSlug}",
            _ => $"/{categorySlug}/{postSlug}"
        };
    }

    private string GetPostTitle(Post post)
    {
        return CurrentLang switch
        {
            "en" => post.Title_EN ?? post.Title_TR,
            "ar" => post.Title_AR ?? post.Title_TR,
            _ => post.Title_TR
        };
    }

    private string GetCategoryName(Category? category)
    {
        if (category == null) return "";
        return CurrentLang switch
        {
            "en" => category.Name_EN ?? category.Name_TR,
            "ar" => category.Name_AR ?? category.Name_TR,
            _ => category.Name_TR
        };
    }

    private System.Globalization.CultureInfo GetCulture()
    {
        return CurrentLang switch
        {
            "en" => new System.Globalization.CultureInfo("en-US"),
            "ar" => new System.Globalization.CultureInfo("ar-SA"),
            _ => new System.Globalization.CultureInfo("tr-TR")
        };
    }

    private void FilterCategory(int categoryId)
    {
        CurrentFilterCategory = categoryId;
        ShowingAll = false;
    }

    private void ShowAll()
    {
        ShowingAll = true;
    }

    private List<Post> GetDisplayedRelatedPosts()
    {
        var filtered = CurrentFilterCategory == 0
            ? relatedPosts
            : relatedPosts.Where(p => p.CategoryId == CurrentFilterCategory).ToList();

        if (ShowingAll)
        {
            return filtered;
        }
        else
        {
            return filtered.Take(InitialDisplayCount).ToList();
        }
    }

    private string GetSummary(Post post)
    {
        var content = CurrentLang switch
        {
            "en" => post.Content_EN ?? post.Content_TR,
            "ar" => post.Content_AR ?? post.Content_TR,
            _ => post.Content_TR
        };

        if (string.IsNullOrWhiteSpace(content)) return "";

        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", String.Empty);

        return plainText.Length <= 150
            ? plainText
            : plainText.Substring(0, 150) + "...";
    }

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["home"] = "Ana Sayfa",
            ["services"] = "Hizmetlerimiz",
            ["announcements"] = "Duyurular",
            ["events"] = "Etkinlikler",
            ["publications"] = "Yayınlar",
            ["selectService"] = "Hizmet Seçin",
            ["selectAnnouncement"] = "Duyuru Seçin",
            ["selectEvent"] = "Etkinlik Seçin",
            ["selectPublication"] = "Yayın Seçin",
            ["noOtherServices"] = "Başka hizmet bulunamadı.",
            ["noOtherContent"] = "Bu kategoride başka içerik bulunamadı.",
            ["suggestedContent"] = "Önerilen İçerik",
            ["featuredPublications"] = "Öne Çıkan Yayınlar",
            ["noFeatured"] = "Önerilen içerik bulunamadı.",
            ["notFound"] = "İçerik bulunamadı.",
            ["relatedContent"] = "İlgili İçerikler",
            ["showAll"] = "Tümünü Göster",
            ["noRelatedContent"] = "İlgili içerik bulunamadı."
        },
        ["en"] = new()
        {
            ["home"] = "Home",
            ["services"] = "Services",
            ["announcements"] = "Announcements",
            ["events"] = "Events",
            ["publications"] = "Publications",
            ["selectService"] = "Select Service",
            ["selectAnnouncement"] = "Select Announcement",
            ["selectEvent"] = "Select Event",
            ["selectPublication"] = "Select Publication",
            ["noOtherServices"] = "No other services found.",
            ["noOtherContent"] = "No other content found in this category.",
            ["suggestedContent"] = "Suggested Content",
            ["featuredPublications"] = "Featured Publications",
            ["noFeatured"] = "No suggested content found.",
            ["notFound"] = "Content not found.",
            ["relatedContent"] = "Related Content",
            ["showAll"] = "Show All",
            ["noRelatedContent"] = "No related content found."
        },
        ["ar"] = new()
        {
            ["home"] = "الرئيسية",
            ["services"] = "خدماتنا",
            ["announcements"] = "الإعلانات",
            ["events"] = "الفعاليات",
            ["publications"] = "المنشورات",
            ["selectService"] = "اختر الخدمة",
            ["selectAnnouncement"] = "اختر الإعلان",
            ["selectEvent"] = "اختر الفعالية",
            ["selectPublication"] = "اختر المنشور",
            ["noOtherServices"] = "لا توجد خدمات أخرى.",
            ["noOtherContent"] = "لا يوجد محتوى آخر في هذه الفئة.",
            ["suggestedContent"] = "محتوى مقترح",
            ["featuredPublications"] = "المنشورات المميزة",
            ["noFeatured"] = "لا يوجد محتوى مقترح.",
            ["notFound"] = "المحتوى غير موجود.",
            ["relatedContent"] = "المحتوى ذو الصلة",
            ["showAll"] = "عرض الكل",
            ["noRelatedContent"] = "لا توجد محتويات ذات صلة."
        }
    };

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];
        return key;
    }
}

<PageTitle>@(GetPostTitle(currentPost ?? new Post()))</PageTitle>

<section class="dph-hero-wrapper">
    <div class="dph-hero-bg-image" style="background-image: url('@currentPost?.CoverImageUrl');"></div>
    <div class="dph-hero-overlay-layer"></div>

    <div class="dph-hero-inner-container">
        <div class="dph-hero-text-content">
            <span class="dph-category-badge">@GetCategoryName(currentPost?.Category)</span>
            <h1 class="dph-main-title">@GetPostTitle(currentPost ?? new Post())</h1>

            <nav class="dph-breadcrumb-wrapper">
                <a href="@LanguageService.GetLocalizedUrl("/")" class="dph-breadcrumb-item">@GetText("home")</a>
                <span class="dph-breadcrumb-divider">/</span>
                @switch (PageType)
                {
                    case "Services":
                        <a href="@LanguageService.GetLocalizedUrl("hizmetlerimiz")" class="dph-breadcrumb-item">@GetText("services")</a>
                        break;
                    case "Announcements":
                        <a href="@LanguageService.GetLocalizedUrl("duyurular")" class="dph-breadcrumb-item">@GetText("announcements")</a>
                        break;
                    case "Events":
                        <a href="@LanguageService.GetLocalizedUrl("etkinlikler")" class="dph-breadcrumb-item">@GetText("events")</a>
                        break;
                    case "Publications":
                        <a href="@LanguageService.GetLocalizedUrl("yayinlar")" class="dph-breadcrumb-item">@GetText("publications")</a>
                        break;
                }
                <span class="dph-breadcrumb-divider">/</span>
                <span class="dph-breadcrumb-active">@GetPostTitle(currentPost ?? new Post())</span>
            </nav>
        </div>
    </div>
</section>

<section class="dph-content-wrapper">
    <div class="dph-content-inner-container">
        <div class="dph-two-column-layout">

            <article class="dph-primary-content-area">
                @if (currentPost != null)
                {
                    <div class="dph-article-body">
                        @((MarkupString)(CurrentLang == "en" ? currentPost.Content_EN ?? currentPost.Content_TR : CurrentLang == "ar" ? currentPost.Content_AR ?? currentPost.Content_TR : currentPost.Content_TR))
                    </div>
                }
                else
                {
                    <div class="dph-alert-box">
                        <i class="fas fa-info-circle"></i>
                        <span>@GetText("notFound")</span>
                    </div>
                }
            </article>

            <aside class="dph-secondary-sidebar">

                @if (PageType == "Services")
                {
                    <div class="dph-dropdown-container">
                        <button class="dph-dropdown-trigger" type="button" data-bs-toggle="dropdown">
                            <span>@GetText("selectService")</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dph-dropdown-list">
                            @foreach (var post in servicePosts)
                            {
                                <li>
                                    <a class="dropdown-item dph-dropdown-option" href="@GetPostUrl(post)">
                                        @GetPostTitle(post)
                                    </a>
                                </li>
                            }
                            @if (!servicePosts.Any())
                            {
                                <li><span class="dropdown-item dph-dropdown-empty">@GetText("noOtherServices")</span></li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="dph-dropdown-container">
                        <button class="dph-dropdown-trigger" type="button" data-bs-toggle="dropdown">
                            <span>@(PageType == "Announcements" ? GetText("selectAnnouncement") : PageType == "Events" ? GetText("selectEvent") : GetText("selectPublication"))</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dph-dropdown-list">
                            @foreach (var post in otherPostsInSameCategory)
                            {
                                <li>
                                    <a class="dropdown-item dph-dropdown-option" href="@GetPostUrl(post)">
                                        @GetPostTitle(post)
                                    </a>
                                </li>
                            }
                            @if (!otherPostsInSameCategory.Any())
                            {
                                <li><span class="dropdown-item dph-dropdown-empty">@GetText("noOtherContent")</span></li>
                            }
                        </ul>
                    </div>
                }

                <div class="dph-suggested-section">
                    <h3 class="dph-sidebar-heading">@GetText("suggestedContent")</h3>

                    @if (featuredPost != null)
                    {
                        <a href="@GetFeaturedUrl()" class="dph-featured-item">
                            <div class="dph-featured-img-container">
                                <img src="@featuredPost.CoverImageUrl" alt="@GetPostTitle(featuredPost)" class="dph-featured-thumbnail">
                                <div class="dph-featured-date-badge">
                                    <span class="dph-date-number">@featuredPost.PublishedDate.Day</span>
                                    <span class="dph-date-text">@featuredPost.PublishedDate.ToString("MMM", GetCulture())</span>
                                </div>
                            </div>
                            <div class="dph-featured-details">
                                @if (featuredPost.Category != null)
                                {
                                    <span class="dph-featured-label">@GetCategoryName(featuredPost.Category)</span>
                                }
                                <h4 class="dph-featured-heading">@GetPostTitle(featuredPost)</h4>
                                <p class="dph-featured-summary">@GetSummary(featuredPost)</p>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="dph-alert-box">
                            <i class="fas fa-info-circle"></i>
                            <span>@GetText("noFeatured")</span>
                        </div>
                    }
                </div>
            </aside>
        </div>

        <section class="partner-related-content">
            <div class="related-content-wrapper">
                <div class="related-section-header">
                    <span class="related-section-badge">@GetText("relatedContent")</span>
                    <h2 class="related-section-title">@GetText("relatedContent")</h2>
                </div>

                <div class="related-tabs-container">
                    <button class="@(CurrentFilterCategory == 0 ? "related-tab active" : "related-tab")"
                            @onclick="() => FilterCategory(0)">
                        <span>@GetText("showAll")</span>
                    </button>

                    @foreach (var cat in distinctCategories)
                    {
                        <button class="@(CurrentFilterCategory == cat.Id ? "related-tab active" : "related-tab")"
                                @onclick="() => FilterCategory(cat.Id)">
                            <span>@GetCategoryName(cat)</span>
                        </button>
                    }
                </div>

                <div class="related-posts-grid">
                    @if (!GetDisplayedRelatedPosts().Any())
                    {
                        <div class="empty-posts-state">
                            <i class="bi bi-inbox"></i>
                            <p>@GetText("noRelatedContent")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var p in GetDisplayedRelatedPosts())
                        {
                            var url = GetPostUrl(p);
                            var categoryName = GetCategoryName(p.Category);

                            <a href="@url" class="related-post-card">
                                <div class="post-card-image-wrapper">
                                    <img src="@(string.IsNullOrEmpty(p.CoverImageUrl) ? "/img/placeholder.jpg" : p.CoverImageUrl)"
                                         alt="@GetPostTitle(p)"
                                         class="post-card-image" />
                                    <div class="post-card-overlay"></div>
                                </div>
                                <div class="post-card-content">
                                    <span class="post-card-date">
                                        <i class="bi bi-calendar3"></i>
                                        @p.PublishedDate.ToString("dd MMM yyyy", GetCulture())
                                    </span>
                                    <h3 class="post-card-title">@GetPostTitle(p)</h3>
                                    <span class="post-category-tag" data-category="@categoryName">@categoryName</span>
                                </div>
                            </a>
                        }
                    }
                </div>

                @if (GetDisplayedRelatedPosts().Count() < (CurrentFilterCategory == 0 ? relatedPosts : relatedPosts.Where(p => p.CategoryId == CurrentFilterCategory).ToList()).Count() && !ShowingAll && relatedPosts.Any())
                {
                    <div class="load-more-wrapper">
                        <button class="load-more-button" @onclick="ShowAll">
                            <span>@GetText("showAll")</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                }
            </div>
        </section>
    </div>
</section>