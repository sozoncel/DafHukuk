@inject ILanguageService LanguageService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<footer class="footer">
    <div class="footer-container">
        <div class="footer-top">
            <div class="footer-column footer-brand">
                <h2 class="footer-logo">@GetText("siteName")</h2>
                <h3 class="footer-title">@GetText("newsletterTitle")</h3>
                <p class="footer-description">@GetText("newsletterDesc")</p>
                <a href="#" class="footer-cta-button">
                    @GetText("newsletterButton")
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
            <div class="footer-column">
                <h4 class="footer-column-title" data-target="bizi-tanıyın">@GetText("getToKnowUs")<span class="mobile-toggle-icon"></span></h4>
                <ul class="footer-links" id="bizi-tanıyın">
                    <li><a href="@GetLocalizedUrl("hakkimizda")">@GetText("about")</a></li>
                    <li><a href="@GetLocalizedUrl("hizmetlerimiz")">@GetText("services")</a></li>
                    <li><a href="#">@GetText("awards")</a></li>
                    <li><a href="@GetLocalizedUrl("ekibimiz")">@GetText("team")</a></li>
                    <li><a href="@GetLocalizedUrl("kariyer")">@GetText("career")</a></li>
                    <li><a href="@GetLocalizedUrl("iletisim")">@GetText("contact")</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h4 class="footer-column-title" data-target="duyurular">@GetText("newsAndPublications")<span class="mobile-toggle-icon"></span></h4>
                <ul class="footer-links" id="duyurular">
                    <li><a href="@GetLocalizedUrl("duyurular")">@GetText("announcements")</a></li>
                    <li><a href="@GetLocalizedUrl("yayinlar")">@GetText("publications")</a></li>
                    <li><a href="@GetLocalizedUrl("etkinlikler")">@GetText("events")</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h4 class="footer-column-title">@GetText("followUs")</h4>
                <div class="footer-social">
                    <a href="#" class="social-link" aria-label="LinkedIn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-bottom-left">
                <div class="footer-language">
                    <a href="@GetLanguageChangeUrl("en")"
                       class="footer-lang-link @(CurrentLang == "en" ? "active" : "")"
                       @onclick="@(() => OnLanguageClick("en"))">
                        <img src="/img/Ortak/flag-en.svg" alt="EN" class="flag-icon">
                        <span>EN</span>
                    </a>
                    <a href="@GetLanguageChangeUrl("ar")"
                       class="footer-lang-link @(CurrentLang == "ar" ? "active" : "")"
                       @onclick="@(() => OnLanguageClick("ar"))">
                        <img src="/img/Ortak/flag-ar.png" alt="AR" class="flag-icon">
                        <span>AR</span>
                    </a>
                    <a href="@GetLanguageChangeUrl("tr")"
                       class="footer-lang-link @(CurrentLang == "tr" ? "active" : "")"
                       @onclick="@(() => OnLanguageClick("tr"))">
                        <img src="/img/Ortak/flag-tr.svg" alt="TR" class="flag-icon">
                        <span>TR</span>
                    </a>
                </div>
                <div class="footer-legal">
                    <a href="#">@GetText("cookiePreferences")</a>
                    <span class="separator">|</span>
                    <a href="#">@GetText("termsAndConditions")</a>
                </div>
            </div>
            <div class="footer-bottom-right">
                <p class="footer-copyright">@GetText("copyright")</p>
            </div>
        </div>
    </div>
</footer>

@code {
    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override void OnInitialized()
    {
        // URL değişikliğinde footer'ı güncelle
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Memory leak önlemek için event'i temizle
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["newsletterTitle"] = "Bültenimize kaydolun",
            ["newsletterDesc"] = "Güncel sektörel yayınlar ve duyurular için bültenimize kaydolun.",
            ["newsletterButton"] = "BÜLTENİMİZE KAYDOLUN",
            ["getToKnowUs"] = "Bizi Tanıyın",
            ["about"] = "Hakkımızda",
            ["services"] = "Hizmetlerimiz",
            ["awards"] = "Ödüllerimiz",
            ["team"] = "Ekibimiz",
            ["career"] = "Kariyer",
            ["contact"] = "İletişim",
            ["siteName"] = "Daf Hukuk",
            ["newsAndPublications"] = "Duyurular & Yayınlar",
            ["announcements"] = "Duyurular",
            ["publications"] = "Yayınlar",
            ["events"] = "Etkinlikler",
            ["followUs"] = "Takip et",
            ["cookiePreferences"] = "Çerez Tercihleri",
            ["termsAndConditions"] = "Hüküm ve Koşullar",
            ["copyright"] = "© Daf Hukuk 2025. Tüm hakları saklıdır."
        },
        ["en"] = new()
        {
            ["newsletterTitle"] = "Subscribe to our newsletter",
            ["newsletterDesc"] = "Subscribe to our newsletter for current sector publications and announcements.",
            ["newsletterButton"] = "SUBSCRIBE TO OUR NEWSLETTER",
            ["getToKnowUs"] = "Get to Know Us",
            ["about"] = "About Us",
            ["services"] = "Services",
            ["awards"] = "Awards",
            ["team"] = "Our Team",
            ["career"] = "Careers",
            ["contact"] = "Contact",
            ["siteName"] = "DAF LAW FIRM",
            ["newsAndPublications"] = "News & Publications",
            ["announcements"] = "Announcements",
            ["publications"] = "Publications",
            ["events"] = "Events",
            ["followUs"] = "Follow Us",
            ["cookiePreferences"] = "Cookie Preferences",
            ["termsAndConditions"] = "Terms and Conditions",
            ["copyright"] = "© Daf Hukuk 2025. All rights reserved."
        },
        ["ar"] = new()
        {
            ["newsletterTitle"] = "اشترك في نشرتنا الإخبارية",
            ["newsletterDesc"] = "اشترك في نشرتنا الإخبارية للحصول على المنشورات والإعلانات القطاعية الحالية.",
            ["newsletterButton"] = "اشترك في نشرتنا الإخبارية",
            ["getToKnowUs"] = "تعرف علينا",
            ["about"] = "من نحن",
