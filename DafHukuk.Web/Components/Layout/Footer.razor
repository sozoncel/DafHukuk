@inject ILanguageService LanguageService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<footer class="footer">
    <div class="footer-container">
        <div class="footer-top">
            <div class="footer-column footer-brand">
                <h2 class="footer-logo">@GetText("siteName")</h2>
                <h3 class="footer-title">@GetText("newsletterTitle")</h3>
                <p class="footer-description">@GetText("newsletterDesc")</p>
                <a href="#" class="footer-cta-button">
                    @GetText("newsletterButton")
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
            <div class="footer-column">
                <h4 class="footer-column-title" data-target="bizi-tanıyın">@GetText("getToKnowUs")<span class="mobile-toggle-icon"></span></h4>
                <ul class="footer-links" id="bizi-tanıyın">
                    <li><a href="@GetLocalizedUrl("hakkimizda")">@GetText("about")</a></li>
                    <li><a href="@GetLocalizedUrl("hizmetlerimiz")">@GetText("services")</a></li>
                    <li><a href="@GetLocalizedUrl("ekibimiz")">@GetText("team")</a></li>
                    <li><a href="@GetLocalizedPartners()">@GetText("partners")</a></li>
                    <li><a href="@GetLocalizedUrl("kariyer")">@GetText("career")</a></li>
                    <li><a href="@GetLocalizedUrl("iletisim")">@GetText("contact")</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h4 class="footer-column-title" data-target="duyurular">@GetText("newsAndPublications")<span class="mobile-toggle-icon"></span></h4>
                <ul class="footer-links" id="duyurular">
                    <li><a href="@GetLocalizedUrl("yayinlar")">@GetText("publications")</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h4 class="footer-column-title">@GetText("followUs")</h4>
                <div class="footer-social">
                    <a href="#" class="social-link" aria-label="LinkedIn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <span class="footer-info">
                “Ziyaret ettiğiniz bu internet sitesi 1136 sayılı Avukatlık Kanunu ve Yönetmeliği ile Hukuk Uyuşmazlıklarında Arabuluculuk Kanunu Yönetmeliği’nde yer alan reklâm yasağı hükümleri çerçevesinde sadece bilgi verme amacı ile tasarlanmıştır. Bu sitede yer alan bilgiler tavsiye niteliğinde değildir. Ayrıca bu sitedeki bilgilere dayanılarak yapılacak iş ve eylemlerden sorumlu olmadığımızı ilan ederiz.”
                © DAF Hukuk ve Danışmanlık 2025. Tüm hakları saklıdır.
            </span>
        </div>
    </div>
</footer>

@code {
