@inject NavigationManager Navigation

<div class="admin-sidebar" id="admin-sidebar">
    <div class="sidebar-header">
        <div class="brand-container">
            <div class="brand-icon">
                <i class="bi bi-shield-shaded"></i>
            </div>
            <div class="brand-text">
                <h1 class="brand-title">DAF HUKUK</h1>
                <p class="brand-subtitle">Yönetim Paneli</p>
            </div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section">
            <div class="nav-section-title">
                <i class="bi bi-speedometer2"></i>
                <span>Genel Bakış</span>
            </div>

            <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All">
                <div class="nav-link-icon">
                    <i class="bi bi-house-door"></i>
                </div>
                <div class="nav-link-content">
                    <span class="nav-link-title">Dashboard</span>
                    <span class="nav-link-desc">Özet paneli</span>
                </div>
                <div class="nav-link-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </NavLink>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">
                <i class="bi bi-collection"></i>
                <span>İçerik Yönetimi</span>
            </div>

            <NavLink class="nav-link" href="/admin/yonetim">
                <div class="nav-link-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div class="nav-link-content">
                    <span class="nav-link-title">İçerikler</span>
                    <span class="nav-link-desc">Yazılar & Duyurular</span>
                </div>
                <div class="nav-link-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </NavLink>

            <NavLink class="nav-link" href="/admin/duzenle">
                <div class="nav-link-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div class="nav-link-content">
                    <span class="nav-link-title">İçerik Düzenle</span>
                    <span class="nav-link-desc">Mevcut içeriği düzenle</span>
                </div>
                <div class="nav-link-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </NavLink>

            <NavLink class="nav-link" href="/admin/avukatlar">
                <div class="nav-link-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="nav-link-content">
                    <span class="nav-link-title">Avukatlar</span>
                    <span class="nav-link-desc">Ekle & Düzenle</span>
                </div>
                <div class="nav-link-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </NavLink>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">
                <i class="bi bi-gear"></i>
                <span>Sistem</span>
            </div>

            <button class="nav-link nav-link-logout" @onclick="Logout">
                <div class="nav-link-icon">
                    <i class="bi bi-box-arrow-left"></i>
                </div>
                <div class="nav-link-content">
                    <span class="nav-link-title">Çıkış Yap</span>
                    <span class="nav-link-desc">Oturumu kapat</span>
                </div>
                <div class="nav-link-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </button>
        </div>
    </nav>

    <div class="sidebar-footer">
        <div class="user-profile">
            <div class="user-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            <div class="user-info">
                <p class="user-name">Yönetici</p>
                <p class="user-role">Admin</p>
            </div>
        </div>
    </div>
</div>

<!-- MOBİL MENÜ BUTONU -->
<div class="admin-mobile-menu-btn" id="admin-mobile-menu-btn">
    <span></span>
    <span></span>
    <span></span>
</div>

<!-- MOBİL OVERLAY -->
<div class="admin-mobile-overlay" id="admin-mobile-overlay"></div>

@code {
    private void Logout()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }
}