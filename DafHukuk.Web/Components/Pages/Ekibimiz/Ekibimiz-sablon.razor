@page "/ekibimiz/template"
@layout DafHukuk.Web.Components.Layout.MainLayout

<section class="hero-lawyer-section">
    <div class="hero-lawyer-bg">
        <img src="/img/sayfalar/ekibimiz/daff-ekip-01.jpg" alt="Serdar Bek" class="hero-lawyer-photo">
    </div>
    <div class="hero-lawyer-overlay"></div>

    <div class="hero-lawyer-container">
        <div class="hero-lawyer-name-content">
            <h2 class="lawyer-hero-name-upper">Serdar Bek</h2>
            <div class="hero-lawyer-name-wrapper">
                <p class="hero-lawyer-name">Kurucu, Kıdemli ve Yönetici</p>
            </div>
        </div>
    </div>

    <div class="hero-lawyer-sub-nav-bar">
        <div class="row hero-nav-row">
            <div class="col-sm-3 col-6 nav-item-col">
                <span>E-posta</span>
                <p>ornekposta@mail.com</p>
            </div>
            <div class="col-sm-3 col-6 nav-item-col">
                <span>Mobil Telefon</span>
                <p>+90 055 444 33 22</p>
            </div>
            <div class="col-sm-3 col-6 nav-item-col">
                <span>Ofis Telefon</span>
                <p>+90 055 333 44 22</p>
            </div>
            <div class="col-sm-3 col-6 nav-item-col">
                <span>Konum</span>
                <p>İstanbul / Türkiye</p>
            </div>
        </div>
    </div>
</section>

<section class="page-content container">
    <div class="row lawyer-info-row">
        <div class="col-md-6 info-col pr-lg-5">
            <h1 class="info-title">Çalışma Alanları</h1>
            <p class="info-tag">Dava Takibi ve Uyuşmazıkların Çözümü</p>
            <p class="info-tag">Yolsuzlukla Mücadele ve Beyaz Yaka Suçları</p>
            <p class="info-tag">Mevzuata Uyum ve Soruşturma</p>

            <h1 class="info-title mt-4">Eğitim</h1>
            <p class="info-tag">İstanbul Üniversitesi, İşletme Fakültesi - MBA, 1987</p>
            <p class="info-tag">İstanbul Üniversitesi, Hukuk Fakültesi - Lisans, 1984</p>
        </div>
        <div class="col-md-6 info-col pl-lg-5">
            <h1 class="info-title">Dil</h1>
            <p class="info-tag">İngilizce, Türkçe</p>

            <h1 class="info-title mt-4">Baro</h1>
            <p class="info-tag">İstanbul, 1999</p>

            <h1 class="info-title mt-4">Ödüller</h1>
            <ul class="award-list">
                <li>Top Ranked by Chambers and Partners</li>
                <li>Recognised as Highly Regarded by IFLR 1000</li>
                <li>Recognised as Hall of Fame by Legal 500</li>
            </ul>
        </div>
