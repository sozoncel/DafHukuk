@page "/ekibimiz/template"
@layout DafHukuk.Web.Components.Layout.MainLayout
@inject IPostService PostService

@code {
    private List<Post> relatedPosts = new();
    private List<Category> distinctCategories = new();

    protected override async Task OnInitializedAsync()
    {
        var all = await PostService.GetAll();

        // Son içerikler
        relatedPosts = all
            .Where(p => p.Category == null || !p.Category.Name_TR.Equals("Hizmetlerimiz", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.PublishedDate)
            .ToList();

        // Tekil kategoriler
        distinctCategories = relatedPosts
            .Where(p => p.Category != null)
            .Select(p => p.Category!)
            .Distinct()
            .OrderBy(c => c.Name_TR)
            .Where(c => !c.Name_TR.Equals("Hizmetlerimiz", StringComparison.OrdinalIgnoreCase)) 
            .ToList();
    }

    // ------------------------------------------------------------
    //  POST → URL üretici 
    // ------------------------------------------------------------
    private string GetPostUrl(Post p)
    {
        if (p?.Category?.Name_TR == null)
            return "#";

        string category = p.Category.Name_TR.Trim().ToLower();

        return category switch
        {
            "hizmetlerimiz" => $"/hizmetlerimiz/{p.Slug_TR}",
            "duyurular" => $"/duyurular/{p.Slug_TR}",
            "etkinlikler" => $"/etkinlikler/{p.Slug_TR}",
            "yayınlar" => $"/yayinlar/{p.Slug_TR}",
            _ => $"/hizmetlerimiz/{p.Slug_TR}"
        };
    }

    private string GetSummary(Post p)
    {
        if (string.IsNullOrWhiteSpace(p.Content_TR)) return "";
        return p.Content_TR.Length > 120 ? p.Content_TR.Substring(0, 120) + "..." : p.Content_TR;
    }
}


<section class="hero-lawyer-section">
    <div class="hero-lawyer-bg">
        <img src="/img/sayfalar/ekibimiz/daf-ekip-01.jpg" class="hero-lawyer-photo">
    </div>
    <div class="hero-lawyer-overlay"></div>

    <div class="hero-lawyer-container">
        <div class="hero-lawyer-name-content">
            <h2 class="lawyer-hero-name-upper">Serdar Bek</h2>
            <div class="hero-lawyer-name-wrapper">
                <p class="hero-lawyer-name">Kurucu, Kıdemli ve Yönetici</p>
            </div>
        </div>
    </div>

    <div class="hero-lawyer-sub-nav-bar">
        <div class="row hero-nav-row">
            <div class="col-sm-3 col-6 nav-item-col"><span>E-posta</span><p>ornekposta@mail.com</p></div>
            <div class="col-sm-3 col-6 nav-item-col"><span>Mobil Telefon</span><p>+90 055 444 33 22</p></div>
            <div class="col-sm-3 col-6 nav-item-col"><span>Ofis Telefon</span><p>+90 055 333 44 22</p></div>
            <div class="col-sm-3 col-6 nav-item-col"><span>Konum</span><p>İstanbul / Türkiye</p></div>
        </div>
    </div>
</section>



<section class="page-content container">

    <!-- BİYOGRAFİ -->
    <div class="row biography-row mt-5">
        <div class="col-lg-12">
            <h1 class="info-title biography-heading">Biyografi</h1>
            <p class="biography-text">Lorem ipsum dolor...</p>
        </div>
    </div>


    <!-- KATEGORİ TABS -->
    <div class="row related-content-nav-row mt-5 mb-3">
        <div class="col-sm-12">
            <h3 class="related-content-heading">İlişkili İçerikler</h3>

            <ul class="nav nav-tabs custom-tabs" id="categoryTabs">

                <li class="nav-item">
                    <a class="nav-link active" href="javascript:void(0)" onclick="filterCategory(0)">Hepsini Göster</a>
                </li>

                @foreach (var cat in distinctCategories)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="javascript:void(0)"
                           onclick="filterCategory(@cat.Id)">
                            @cat.Name_TR
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>


    <!-- İÇERİK LİSTESİ -->
    <div class="row content-cards-row" id="contentContainer">

        @foreach (var p in relatedPosts)
        {
            var url = GetPostUrl(p);

            <div class="col-lg-4 mb-4 content-card-wrapper"
                 data-category="@p.CategoryId">

                <div class="content-card">

                    <p class="created-Date">@p.PublishedDate.ToString("dd MMMM")</p>

                    <a href="@url" class="content-title-link">
                        <h3 class="textContent">@p.Title_TR</h3>
                    </a>

                    <a href="@url">
                        <button class="content-tag-button">@p.Category?.Name_TR</button>
                    </a>

                    <p class="slug-text">@GetSummary(p)</p>

                </div>
            </div>
        }

    </div>


    <!-- BOŞ MESAJ -->
    <div class="row">
        <div class="col-12 text-center">
            <p id="noContentMessage"
               style="display:none; font-weight:bold; margin-top:20px;">
                Henüz içerik eklenmemiştir.
            </p>
        </div>
    </div>


    <!-- TÜMÜNÜ GÖSTER -->
    <div class="row mt-4 mb-5">
        <div class="col-lg-12 text-center">

            <button id="showAllButton"
                    class="show-all-button"
                    style="display:none"
                    onclick="showAll()">
                Tümünü Göster
            </button>

        </div>
    </div>

</section>
