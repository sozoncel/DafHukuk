@page "/ekibimiz"
@layout DafHukuk.Web.Components.Layout.MainLayout

<section class="hero-ourteam-section">
    <div class="hero-ourteam-bg"></div>
    <div class="hero-ourteam-overlay"></div>

    <div class="hero-ourteam-container">
        <div class="hero-ourteam-title-content">
            <h2 class="ourteam-hero-title-upper">Ekibimiz</h2>
            <div class="hero-ourteam-title-wrapper">
                <h1 class="hero-ourteam-title">Daf Ekibiyle Tanışın</h1>
            </div>
        </div>
    </div>
</section>

<section class="ourteam-content">
    <div class="ourteam-page-content">

        <!-- AÇIKLAMA METNİ -->
        <div class="row info-row">
            <div class="col-lg-12">
                <p class="team-info-text">
                    120’nin üstünde avukat, danışman ve destek birimini bünyesinde barındıran Daf ekibi,
                    çözüm odaklı çalışma anlayışı, yüksek hizmet kalitesi ve müvekkil memnuniyetine bağlılığıyla tanınır.
                </p>
            </div>
        </div>

        <!-- EKİP KARTLARI -->
        <div class="row team-cards-row">

            <div class="col-lg-3 col-md-4 col-sm-6 col-12 team-card-col">
                <div class="avukat-card">
                    <img src="img/sayfalar/ekibimiz/daf-ekip-01.jpg" class="avukat-img" alt="Avukat Serdar Bek">
                    <a href="/ekibimiz/template" class="avukat-name-link">
                        <h3 class="avukat-name">Serdar Bek</h3>
                    </a>
                    <hr class="card-divider">
                    <a href="mailto:serdarbek@daf.com" class="mail-box-link">
                        <i class="fa fa-envelope-o"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-sm-6 col-12 team-card-col">
                <div class="avukat-card">
                    <img src="img/sayfalar/ekibimiz/daf-ekip-02.jpg" class="avukat-img" alt="Avukat Ahmet Yılmaz">
                    <a href="#" class="avukat-name-link"><h3 class="avukat-name">Ahmet Yılmaz</h3></a>
                    <hr class="card-divider">
                    <a href="mailto:ahmetyilmaz@daf.com" class="mail-box-link">
                        <i class="fa fa-envelope-o"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-4 col-sm-6 col-12 team-card-col">
                <div class="avukat-card">
                    <img src="img/sayfalar/ekibimiz/daf-ekip-03.jpg" class="avukat-img" alt="Avukat Davut Ata">
                    <a href="#" class="avukat-name-link"><h3 class="avukat-name">Davut Ata</h3></a>
                    <hr class="card-divider">
                    <a href="mailto:davutata@daf.com" class="mail-box-link">
                        <i class="fa fa-envelope-o"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
