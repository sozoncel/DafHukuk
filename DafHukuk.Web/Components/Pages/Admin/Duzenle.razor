@page "/admin/duzenle/{PostId:int}"
@page "/admin/duzenle"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@GetText("editPageTitle")</h2>
            <p class="text-muted mb-0">@GetText("editPageSubtitle")</p>
        </div>
        <a href="/admin/yonetim" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            @GetText("backToList")
        </a>
    </div>

    @* Post Seçimi (PostId parametresi yoksa) *@
    @if (PostId == 0)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card admin-card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">
                            <i class="bi bi-search me-2"></i>
                            @GetText("selectPostToEdit")
                        </h5>

                        @if (allPosts.Count == 0)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
                                <p class="text-muted">@GetText("noPostsAvailable")</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var p in allPosts)
                                {
                                    <a href="@($"/admin/duzenle/{p.Id}")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="post-select-icon">
                                                <i class="bi bi-file-text"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1">@(p.Title_TR ?? p.Title_EN ?? p.Title_AR ?? "Başlıksız")</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>@p.PublishedDate.ToShortDateString()
                                                    @if (p.Category != null)
                                                    {
                                                        <span class="ms-2 badge" style="background-color: @GetCategoryColorByName(p.Category.Name_TR);">
                                                            @p.Category.Name_TR
                                                        </span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Yükleniyor ve Post Bulunamadı Durumu *@
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@GetText("loading")</span>
                </div>
                <p class="text-muted mt-2">@GetText("loading")</p>
            </div>
        }
        else if (post == null)
        {
            <div class="modern-alert modern-alert-error" role="alert">
                <div class="modern-alert-icon"><i class="bi bi-x-octagon-fill"></i></div>
                <div class="modern-alert-content">
                    <strong>@GetText("errorTitle")</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }
        else
        {
            @* Başarı ve Hata Mesajları *@
            @if (showSuccess)
            {
                <div class="modern-alert modern-alert-success" role="alert">
                    <div class="modern-alert-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="modern-alert-content">
                        <strong>@GetText("successTitle")</strong>
                        <p>@successMessage</p>
                    </div>
                    <button class="modern-alert-close" @onclick="() => showSuccess = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            @if (showError)
            {
                <div class="modern-alert modern-alert-error" role="alert">
                    <div class="modern-alert-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="modern-alert-content">
                        <strong>@GetText("errorTitle")</strong>
                        <p>@errorMessage</p>
                    </div>
                    <button class="modern-alert-close" @onclick="() => showError = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            <div class="row g-4 mb-5">
                <div class="col-lg-4">
                    <div class="card admin-card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-4">
                                <i class="bi bi-info-circle me-2"></i>
                                @GetText("generalInfo")
                            </h5>

                            @* Kategori Seçimi *@
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-folder me-1"></i>
                                    @GetText("category")
                                </label>
                                <select class="form-select" @bind="post.CategoryId">
                                    <option value="0">-- @GetText("selectCategory") --</option>
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c.Id">@GetCategoryName(c)</option>
                                    }
                                </select>
                            </div>

                            @* Kapak Resmi URL *@
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-image me-1"></i>
                                    @GetText("coverImage")
                                </label>
                                <input class="form-control"
                                       @bind="post.CoverImageUrl"
                                       placeholder="https://..." />
                                <div class="mt-3 image-preview-wrapper">
                                    <img src="@GetPreviewImage()"
                                         class="img-fluid rounded"
                                         alt="@GetText("preview")" />
                                </div>
                            </div>

                            @* Yayın Tarihi *@
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @GetText("publishDate")
                                </label>
                                <InputDate class="form-control" @bind-Value="post.PublishedDate" />
                            </div>

                            @* Aktif/Pasif Durumu *@
                            <div class="mb-3">
                                <label class="form-label d-block mb-2">
                                    <i class="bi bi-activity me-1"></i>
                                    @GetText("activeState")
                                </label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isActiveSwitch" @bind="post.IsActive">
                                    <label class="form-check-label" for="isActiveSwitch">
                                        @(post.IsActive? GetText("active") : GetText("passive"))
                                    </label>
                                </div>
                            </div>

                            @* Kaydedilecek Diller *@
                            <div class="mb-4">
                                <label class="form-label d-block mb-2">
                                    <i class="bi bi-translate me-1"></i>
                                    @GetText("languagesToSave")
                                </label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="langTr" @bind="includeTr" />
                                        <label class="form-check-label" for="langTr">🇹🇷 TR</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="langEn" @bind="includeEn" />
                                        <label class="form-check-label" for="langEn">🇬🇧 EN</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="langAr" @bind="includeAr" />
                                        <label class="form-check-label" for="langAr">🇸🇦 AR</label>
                                    </div>
                                </div>
                            </div>

                            @* Güncelleme Butonu *@
                            <button class="btn btn-success btn-lg w-100"
                                    @onclick="UpdatePost"
                                    disabled="@isSaving">
                                <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-check-circle") me-2"></i>
                                @(isSaving? GetText("updating") : GetText("updateContent"))
                            </button>

                            @* Silme Butonu *@
                            <button class="btn btn-danger btn-lg w-100 mt-2"
                                    @onclick="DeletePost"
                                    disabled="@isSaving">
                                <i class="bi bi-trash me-2"></i>
                                @GetText("deleteContent")
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card admin-card h-100">
                        @* Dil Sekmeleri *@
                        <div class="card-header bg-white border-bottom">
                            <ul class="nav nav-tabs card-header-tabs nav-fill border-0">
                                <li class="nav-item">
                                    <button class='@GetTabClass("tr")' @onclick='() => SwitchLang("tr")' type="button">🇹🇷 Türkçe</button>
                                </li>
                                <li class="nav-item">
                                    <button class='@GetTabClass("en")' @onclick='() => SwitchLang("en")' type="button">🇬🇧 English</button>
                                </li>
                                <li class="nav-item">
                                    <button class='@GetTabClass("ar")' @onclick='() => SwitchLang("ar")' type="button">🇸🇦 العربية</button>
                                </li>
                            </ul>
                        </div>

                        @* Dil İçerikleri *@
                        <div class="card-body">
                            @* Türkçe Alanlar *@
                            <div class='@GetLangClass("tr")'>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("title")</label>
                                    <input class="form-control form-control-lg"
                                           @bind="post.Title_TR"
                                           placeholder="@GetText("titlePlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("slug")</label>
                                    <input class="form-control"
                                           @bind="post.Slug_TR"
                                           placeholder="@GetText("slugPlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("content")</label>
                                    <textarea class="form-control"
                                              rows="10"
                                              @bind="post.Content_TR"
                                              placeholder="@GetText("contentPlaceholder")"></textarea>
                                </div>
                            </div>

                            @* İngilizce Alanlar *@
                            <div class='@GetLangClass("en")'>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("title")</label>
                                    <input class="form-control form-control-lg"
                                           @bind="post.Title_EN"
                                           placeholder="@GetText("titlePlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("slug")</label>
                                    <input class="form-control"
                                           @bind="post.Slug_EN"
                                           placeholder="@GetText("slugPlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("content")</label>
                                    <textarea class="form-control"
                                              rows="10"
                                              @bind="post.Content_EN"
                                              placeholder="@GetText("contentPlaceholder")"></textarea>
                                </div>
                            </div>

                            @* Arapça Alanlar *@
                            <div class='@GetLangClass("ar")' dir="rtl">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("title")</label>
                                    <input class="form-control form-control-lg"
                                           @bind="post.Title_AR"
                                           placeholder="@GetText("titlePlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("slug")</label>
                                    <input class="form-control"
                                           style="direction:ltr"
                                           @bind="post.Slug_AR"
                                           placeholder="@GetText("slugPlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("content")</label>
                                    <textarea class="form-control"
                                              rows="10"
                                              @bind="post.Content_AR"
                                              placeholder="@GetText("contentPlaceholder")"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int PostId { get; set; }

    private Post? post;
    private List<Post> allPosts = new();
    private List<Category> categories = new();
    private string activeLang = "tr";
    private bool isLoading = true;

    private bool showSuccess = false;
    private bool showError = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSaving = false;

    private bool includeTr { get; set; } = true;
    private bool includeEn { get; set; } = false;
    private bool includeAr { get; set; } = false;

    private Dictionary<string, Dictionary<string, string>> translations = new()
    {
        ["tr"] = new()
        {
            ["editPageTitle"] = "İçerik Düzenleme",
            ["editPageSubtitle"] = "Mevcut içeriği düzenleyin ve güncelleyin",
            ["backToList"] = "İçerik Listesine Dön",
            ["loading"] = "Yükleniyor...",
            ["successTitle"] = "Başarılı!",
            ["errorTitle"] = "Hata!",
            ["generalInfo"] = "Genel Bilgiler",
            ["category"] = "Kategori",
            ["selectCategory"] = "Kategori Seçin",
            ["coverImage"] = "Kapak Resmi URL",
            ["preview"] = "Önizleme",
            ["publishDate"] = "Yayın Tarihi",
            ["languagesToSave"] = "Kaydedilecek Diller",
            ["activeState"] = "Durum",
            ["active"] = "Aktif",
            ["passive"] = "Pasif",
            ["updating"] = "Güncelleniyor...",
            ["updateContent"] = "İçeriği Güncelle",
            ["deleteContent"] = "İçeriği Sil",
            ["confirmDelete"] = "Bu içeriği silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            ["title"] = "Başlık",
            ["slug"] = "Slug",
            ["content"] = "İçerik",
            ["titlePlaceholder"] = "İçerik başlığını girin...",
            ["slugPlaceholder"] = "url-icin-slug",
            ["contentPlaceholder"] = "İçeriği buraya yazın...",
            ["selectPostToEdit"] = "Düzenlemek İstediğiniz İçeriği Seçin",
            ["noPostsAvailable"] = "Henüz içerik bulunmamaktadır."
        },
        ["en"] = new()
        {
            ["editPageTitle"] = "Content Editing",
            ["editPageSubtitle"] = "Edit and update existing content",
            ["backToList"] = "Back to Content List",
            ["loading"] = "Loading...",
            ["successTitle"] = "Success!",
            ["errorTitle"] = "Error!",
            ["generalInfo"] = "General Information",
            ["category"] = "Category",
            ["selectCategory"] = "Select Category",
            ["coverImage"] = "Cover Image URL",
            ["preview"] = "Preview",
            ["publishDate"] = "Publish Date",
            ["languagesToSave"] = "Languages to Save",
            ["activeState"] = "Status",
            ["active"] = "Active",
            ["passive"] = "Passive",
            ["updating"] = "Updating...",
            ["updateContent"] = "Update Content",
            ["deleteContent"] = "Delete Content",
            ["confirmDelete"] = "Are you sure you want to delete this content? This action cannot be undone.",
            ["title"] = "Title",
            ["slug"] = "Slug",
            ["content"] = "Content",
            ["titlePlaceholder"] = "Enter title...",
            ["slugPlaceholder"] = "url-slug",
            ["contentPlaceholder"] = "Write content here...",
            ["selectPostToEdit"] = "Select Content to Edit",
            ["noPostsAvailable"] = "No posts available yet."
        },
        ["ar"] = new()
        {
            ["editPageTitle"] = "تعديل المحتوى",
            ["editPageSubtitle"] = "تعديل وتحديث المحتوى الحالي",
            ["backToList"] = "العودة إلى قائمة المحتوى",
            ["loading"] = "جار التحميل...",
            ["successTitle"] = "نجاح!",
            ["errorTitle"] = "خطأ!",
            ["generalInfo"] = "معلومات عامة",
            ["category"] = "الفئة",
            ["selectCategory"] = "اختر الفئة",
            ["coverImage"] = "رابط صورة الغلاف",
            ["preview"] = "معاينة",
            ["publishDate"] = "تاريخ النشر",
            ["languagesToSave"] = "اللغات المراد حفظها",
            ["activeState"] = "الحالة",
            ["active"] = "نشط",
            ["passive"] = "غير نشط",
            ["updating"] = "جاري التحديث...",
            ["updateContent"] = "تحديث المحتوى",
            ["deleteContent"] = "حذف المحتوى",
            ["confirmDelete"] = "هل أنت متأكد من حذف هذا المحتوى؟ لا يمكن التراجع عن هذا الإجراء.",
            ["title"] = "العنوان",
            ["slug"] = "الرابط",
            ["content"] = "المحتوى",
            ["titlePlaceholder"] = "أدخل العنوان...",
            ["slugPlaceholder"] = "url-slug",
            ["contentPlaceholder"] = "اكتب المحتوى هنا...",
            ["selectPostToEdit"] = "اختر المحتوى للتعديل",
            ["noPostsAvailable"] = "لا توجد مشاركات متاحة بعد."
        }
    };

    private string GetText(string key)
    {
        if (translations.ContainsKey(activeLang) && translations[activeLang].ContainsKey(key))
            return translations[activeLang][key];
        return key;
    }

    private string GetTabClass(string lang)
    {
        var baseCls = "nav-link";
        if (activeLang == lang) return $"{baseCls} active";
        return baseCls;
    }

    private string GetLangClass(string lang)
        => activeLang == lang ? "d-block" : "d-none";

    private string GetPreviewImage()
        => string.IsNullOrWhiteSpace(post?.CoverImageUrl)
            ? "https://via.placeholder.com/600x300?text=Kapak+Önizleme"
            : post.CoverImageUrl;

    private void SwitchLang(string lang)
    {
        activeLang = lang;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        showError = false;

        try
        {
            await LoadCategories();

            if (PostId == 0)
            {
                allPosts = await PostService.GetAll();
                isLoading = false;
                return;
            }

            post = await PostService.GetById(PostId);

            if (post == null)
            {
                errorMessage = GetText("errorTitle") + ": " + (activeLang == "tr" ? "İçerik bulunamadı veya pasif durumda." : "Content not found or is inactive.");
                showError = true;
                await Task.Delay(2000);
                Navigation.NavigateTo("/admin/yonetim");
                return;
            }

            includeTr = !string.IsNullOrWhiteSpace(post.Title_TR);
            includeEn = !string.IsNullOrWhiteSpace(post.Title_EN);
            includeAr = !string.IsNullOrWhiteSpace(post.Title_AR);

            if (!includeTr && includeEn) activeLang = "en";
            else if (!includeTr && !includeEn && includeAr) activeLang = "ar";
            else activeLang = "tr";
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Veri yüklenirken hata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAll() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kategori yükleme hatası: {ex.Message}");
        }
    }

    private async Task UpdatePost()
    {
        if (post == null) return;

        showError = false;
        showSuccess = false;

        if (includeTr && string.IsNullOrWhiteSpace(post.Title_TR))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": " + (activeLang == "tr" ? "Türkçe başlık zorunludur." : "Turkish title is required.");
            return;
        }

        if (post.CategoryId == 0)
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": " + (activeLang == "tr" ? "Lütfen kategori seçiniz." : "Please select a category.");
            return;
        }

        try
        {
            isSaving = true;

            post.Category = null;

            // KRİTİK DÜZELTME: Dil bayrakları sadece validasyon için kullanılır.
            // Eğer kullanıcı bir dil checkbox'unu kaldırsa bile, mevcut veri KORUNUR.
            // Kullanıcı manuel olarak içeriği silmek istiyorsa textarea'yı boşaltmalıdır.

            var updatedPost = await PostService.Update(PostId, post);

            if (updatedPost == null)
            {
                throw new InvalidOperationException("Güncelleme işlemi veritabanına yansıtılamadı.");
            }

            successMessage = activeLang switch
            {
                "en" => "Content updated successfully!",
                "ar" => "تم تحديث المحتوى بنجاح!",
                _ => "İçerik başarıyla güncellendi!"
            };

            showSuccess = true;
            await Task.Delay(3000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Error during update: {ex.Message}",
                "ar" => $"خطأ أثناء التحديث: {ex.Message}",
                _ => $"Güncelleme sırasında hata: {ex.Message}"
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePost()
    {
        if (post == null) return;

        if (await JS.InvokeAsync<bool>("confirm", GetText("confirmDelete")))
        {
            try
            {
                isSaving = true;

                var result = await PostService.Delete(PostId);

                if (result)
                {
                    await JS.InvokeVoidAsync("alert", activeLang == "tr" ? "İçerik başarıyla silindi." : "Content deleted successfully.");
                    Navigation.NavigateTo("/admin/yonetim");
                }
                else
                {
                    showError = true;
                    errorMessage = activeLang switch
                    {
                        "en" => "Deletion failed. The content might have already been deleted.",
                        "ar" => "فشل الحذف. قد يكون المحتوى محذوفًا بالفعل.",
                        _ => "Silme başarısız. İçerik zaten silinmiş olabilir."
                    };
                }
            }
            catch (Exception ex)
            {
                showError = true;
                errorMessage = activeLang switch
                {
                    "en" => $"Error during deletion: {ex.Message}",
                    "ar" => $"خطأ أثناء الحذف: {ex.Message}",
                    _ => $"Silme sırasında hata: {ex.Message}"
                };
            }
            finally
            {
                isSaving = false;
            }
        }
    }

    private string GetCategoryName(Category? category)
    {
        if (category == null) return "";
        return activeLang switch
        {
            "en" => category.Name_EN ?? category.Name_TR,
            "ar" => category.Name_AR ?? category.Name_TR,
            _ => category.Name_TR
        };
    }

    private string GetCategoryColorByName(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
            return "#3b82f6";
        return categoryName.ToLowerInvariant() switch
        {
            "hizmetlerimiz" or "our services" => "#366C80",
            "duyurular" or "announcements" => "#5c7341",
            "etkinlikler" or "events" => "#78514A",
            "yayınlar" or "yayinlar" or "publications" => "#dfb899",
            _ => "#3b82f6"
        };
    }
}