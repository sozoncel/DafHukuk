@page "/Error"
@using System.Diagnostics
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@inject NavigationManager Navigation

<PageTitle>Hata Oluştu - DAF Hukuk</PageTitle>

<div class="error-page">
    <div class="error-container">

        <!-- HATA İKONU -->
        <div class="error-illustration">
            <div class="error-icon-wrapper">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="error-animation">
                <div class="error-circle error-circle-1"></div>
                <div class="error-circle error-circle-2"></div>
                <div class="error-circle error-circle-3"></div>
            </div>
        </div>

        <!-- HATA MESAJI -->
        <div class="error-content">
            <h1 class="error-title">Bir Şeyler Ters Gitti!</h1>
            <p class="error-description">
                Üzgünüz, isteğinizi işlerken beklenmeyen bir hata oluştu.
            </p>

            @if (ShowRequestId)
            {
                <div class="error-details">
                    <div class="error-detail-item">
                        <span class="error-detail-label">Hata Kodu:</span>
                        <code class="error-detail-code">@RequestId</code>
                    </div>
                    <div class="error-detail-item">
                        <span class="error-detail-label">Zaman:</span>
                        <code class="error-detail-code">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</code>
                    </div>
                </div>
            }

            <!-- AKSİYON BUTONLARI -->
            <div class="error-actions">
                <button class="error-btn error-btn-primary" @onclick="GoHome">
                    <i class="bi bi-house-door"></i>
                    Ana Sayfaya Dön
                </button>
                <button class="error-btn error-btn-secondary" @onclick="TryAgain">
                    <i class="bi bi-arrow-clockwise"></i>
                    Tekrar Dene
                </button>
            </div>

            <!-- GELİŞTİRİCİ MODU UYARISI -->
            @if (IsDevelopmentMode)
            {
                <div class="error-dev-warning">
                    <div class="dev-warning-header">
                        <i class="bi bi-code-slash"></i>
                        <span>Geliştirici Modu</span>
                    </div>
                    <p class="dev-warning-text">
                        Bu sayfa <strong>Development</strong> ortamında daha detaylı bilgi gösterir.
                        Üretim ortamında bu bilgiler gizlenecektir.
                    </p>
                    <div class="dev-warning-note">
                        <i class="bi bi-shield-exclamation"></i>
                        <span>Güvenlik Uyarısı: Development modu üretim sunucusunda aktif olmamalıdır.</span>
                    </div>
                </div>
            }

            <!-- YARDIM LİNKLERİ -->
            <div class="error-help">
                <p class="error-help-title">Yardıma mı ihtiyacınız var?</p>
                <div class="error-help-links">
                    <a href="/iletisim" class="error-help-link">
                        <i class="bi bi-envelope"></i>
                        İletişime Geç
                    </a>
                    <a href="/" class="error-help-link">
                        <i class="bi bi-question-circle"></i>
                        Destek Merkezi
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private bool IsDevelopmentMode { get; set; }

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        // Geliştirici modunu kontrol et (basit bir örnek)
        IsDevelopmentMode = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development";
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void TryAgain()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}