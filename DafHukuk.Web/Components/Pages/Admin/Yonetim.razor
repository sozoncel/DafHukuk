@page "/admin/yonetim"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject IJSRuntime JS

<link href="~/css/yonetim.css" rel="stylesheet" />

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">İçerik Yönetimi</h2>
            <p class="text-muted mb-0">Yeni içerik ekleyin ve mevcut içerikleri yönetin</p>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Başarılı!</strong> @successMessage
            <button type="button" class="btn-close" @onclick="() => showSuccess = false"></button>
        </div>
    }

    @if (showError)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Hata!</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => showError = false"></button>
        </div>
    }

    <!-- FORM BÖLÜMÜ -->
    <div class="row g-4 mb-5">

        <div class="col-lg-4">
            <div class="card admin-card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Genel Bilgiler
                    </h5>

                    <!-- KATEGORİ SEÇİMİ -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-folder me-1"></i>
                            Kategori
                        </label>
                        <div class="input-group">
                            <select class="form-select" @bind="newPost.CategoryId">
                                <option value="0">-- Kategori Seçin --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name_TR</option>
                                }
                            </select>
                            <button class="btn btn-outline-primary"
                                    @onclick="ToggleAddCategory"
                                    title="Yeni kategori ekle">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>

                        @if (showAddCategory)
                        {
                            <div class="mt-3 p-3 bg-light rounded">
                                <label class="form-label small">Yeni Kategori Adı (TR)</label>
                                <div class="input-group">
                                    <input class="form-control"
                                           @bind="newCategoryName"
                                           placeholder="Örn: Duyurular" />
                                    <button class="btn btn-success" @onclick="AddCategory">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="CancelAddCategory">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- KAPAK RESMİ -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-image me-1"></i>
                            Kapak Resmi URL
                        </label>
                        <input class="form-control"
                               @bind="newPost.CoverImageUrl"
                               placeholder="https://..." />
                        <div class="mt-3 image-preview-wrapper">
                            <img src="@GetPreviewImage()"
                                 class="img-fluid rounded"
                                 alt="Önizleme" />
                        </div>
                    </div>

                    <!-- YAYIN TARİHİ -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-calendar-event me-1"></i>
                            Yayın Tarihi
                        </label>
                        <InputDate class="form-control" @bind-Value="newPost.PublishedDate" />
                    </div>

                    <!-- DİL SEÇİMİ -->
                    <div class="mb-4">
                        <label class="form-label d-block mb-2">
                            <i class="bi bi-translate me-1"></i>
                            Kaydedilecek Diller
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="langTr"
                                       @bind="includeTr" />
                                <label class="form-check-label" for="langTr">
                                    🇹🇷 TR
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="langEn"
                                       @bind="includeEn" />
                                <label class="form-check-label" for="langEn">
                                    🇬🇧 EN
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="langAr"
                                       @bind="includeAr" />
                                <label class="form-check-label" for="langAr">
                                    🇸🇦 AR
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- KAYDET BUTONU -->
                    <button class="btn btn-primary btn-lg w-100"
                            @onclick="SavePost"
                            disabled="@isSaving">
                        <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-save") me-2"></i>
                        @(isSaving ? "Kaydediliyor..." : "İçeriği Kaydet")
                    </button>
                </div>
            </div>
        </div>

        <!-- SAĞ: DİL SEKMELERİ -->
        <div class="col-lg-8">
            <div class="card admin-card h-100">
                <div class="card-header bg-white border-bottom">
                    <ul class="nav nav-tabs card-header-tabs nav-fill border-0">
                        <li class="nav-item">
                            <button class='@GetTabClass("tr")'
                                    @onclick='() => SwitchLang("tr")'
                                    type="button">
                                🇹🇷 Türkçe
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("en")'
                                    @onclick='() => SwitchLang("en")'
                                    type="button">
                                🇬🇧 English
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("ar")'
                                    @onclick='() => SwitchLang("ar")'
                                    type="button">
                                🇸🇦 العربية
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">

                    <!-- TÜRKÇE -->
                    <div class='@GetLangClass("tr")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Başlık (TR)</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_TR"
                                   placeholder="İçerik başlığını girin..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Slug (TR)</label>
                            <input class="form-control"
                                   @bind="newPost.Slug_TR"
                                   placeholder="url-icin-slug" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">İçerik (TR)</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_TR"
                                      placeholder="İçeriği buraya yazın..."></textarea>
                        </div>
                    </div>

                    <!-- İNGİLİZCE -->
                    <div class='@GetLangClass("en")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Title (EN)</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_EN"
                                   placeholder="Enter title..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Slug (EN)</label>
                            <input class="form-control"
                                   @bind="newPost.Slug_EN"
                                   placeholder="url-slug" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Content (EN)</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_EN"
                                      placeholder="Write content here..."></textarea>
                        </div>
                    </div>

                    <!-- ARAPÇA -->
                    <div class='@GetLangClass("ar")' dir="rtl">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">العنوان (AR)</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_AR"
                                   placeholder="أدخل العنوان..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">الرابط (AR)</label>
                            <input class="form-control"
                                   style="direction:ltr"
                                   @bind="newPost.Slug_AR"
                                   placeholder="url-slug" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">المحتوى (AR)</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_AR"
                                      placeholder="اكتب المحتوى هنا..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KATEGORİLER BÖLÜMÜ -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card admin-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-bookmark-fill me-2"></i>
                        Kayıtlı Kategoriler
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        @if (!categories.Any())
                        {
                            <span class="text-muted">Henüz kategori eklenmemiş.</span>
                        }
                        else
                        {
                            @foreach (var c in categories)
                            {
                                <span class="badge bg-primary bg-gradient px-3 py-2 fs-6">
                                    @c.Name_TR
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card admin-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-file-text-fill me-2"></i>
                            Son Yazılar (@FilteredPostsCount)
                        </h5>

                        <!-- FİLTRE VE KONTROLLER -->
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <select class="form-select form-select-sm"
                                    style="width: auto;"
                                    @bind="filterCategoryId"
                                    @bind:after="ApplyFilter">
                                <option value="0">Tüm Kategoriler</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name_TR</option>
                                }
                            </select>

                            @if (VisibleHasMore())
                            {
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="LoadMorePosts"
                                        disabled="@isAutoLoading">
                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                    Daha Fazla (5)
                                </button>

                                <button class="btn btn-sm btn-primary"
                                        @onclick="ToggleAutoLoad">
                                    <i class="bi @(isAutoLoading ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                    @(isAutoLoading ? "Durdur" : "Tümünü Yükle")
                                </button>
                            }

                            <span class="badge bg-light text-dark px-3 py-2">
                                Gösterilen: @visiblePostsCount / @FilteredPostsCount
                            </span>
                        </div>
                    </div>

                    <!-- KARTLAR -->
                    @if (!posts.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted mt-2">Henüz içerik eklenmemiş.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4 content-cards-row">
                            @foreach (var p in GetVisiblePosts())
                            {
                                var url = GetPostUrl(p);

                                <div class="col-lg-4 col-md-6 content-card-wrapper"
                                     data-category="@p.CategoryId">
                                    <div class="admin-content-card h-100">
                                        <div class="admin-card-image">
                                            <img src="@p.CoverImageUrl"
                                                 alt="@p.Title_TR"
                                                 onerror="this.src='https://via.placeholder.com/400x200?text=Görsel+Yok'" />
                                            <span class="admin-category-badge"
                                                  style="background: @GetCategoryColor(p.Category?.Name_TR);">
                                                @p.Category?.Name_TR
                                            </span>
                                        </div>
                                        <div class="admin-card-content">
                                            <p class="admin-card-date">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @p.PublishedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                            </p>
                                            <h6 class="admin-card-title">@p.Title_TR</h6>
                                            <p class="admin-card-excerpt">@GetSummary(p)</p>
                                            <div class="d-flex gap-2 mt-auto">
                                                <a href="@url"
                                                   class="btn btn-sm btn-outline-primary flex-grow-1"
                                                   target="_blank">
                                                    <i class="bi bi-eye me-1"></i>
                                                    Görüntüle
                                                </a>
                                                <button class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    private Post newPost = new() { PublishedDate = DateTime.Now };
    private List<Category> categories = new();
    private List<Post> posts = new();
    private string activeLang = "tr";

    private bool showAddCategory = false;
    private string newCategoryName = string.Empty;

    private bool showSuccess = false;
    private bool showError = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSaving = false;

    private bool includeTr { get; set; } = true;
    private bool includeEn { get; set; } = false;
    private bool includeAr { get; set; } = false;

    private int visiblePostsCount = 9;
    private bool isAutoLoading = false;
    private int filterCategoryId = 0;

    private string GetTabClass(string lang)
    {
        var baseCls = "nav-link";
        if (activeLang == lang) return $"{baseCls} active";
        return baseCls;
    }

    private string GetLangClass(string lang)
        => activeLang == lang ? "d-block" : "d-none";

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        try
        {
            categories = await CategoryService.GetAll() ?? new();
            posts = (await PostService.GetAll())?.OrderByDescending(x => x.PublishedDate).ToList() ?? new();
            visiblePostsCount = Math.Min(9, FilteredPostsCount);
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Veriler yüklenirken hata: " + ex.Message;
        }
    }

    private IEnumerable<Post> GetVisiblePosts()
    {
        return posts
            .Where(p => filterCategoryId == 0 || p.CategoryId == filterCategoryId)
            .OrderByDescending(p => p.PublishedDate)
            .Take(visiblePostsCount);
    }

    private int FilteredPostsCount =>
        posts.Count(p => filterCategoryId == 0 || p.CategoryId == filterCategoryId);

    private bool VisibleHasMore() => visiblePostsCount < FilteredPostsCount;

    private void ApplyFilter()
    {
        visiblePostsCount = Math.Min(9, FilteredPostsCount);
        isAutoLoading = false;
    }

    private async Task LoadMorePosts()
    {
        var total = FilteredPostsCount;
        visiblePostsCount = Math.Min(total, visiblePostsCount + 5);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleAutoLoad()
    {
        if (isAutoLoading)
        {
            isAutoLoading = false;
            return;
        }

        isAutoLoading = true;

        while (isAutoLoading && VisibleHasMore())
        {
            visiblePostsCount = Math.Min(FilteredPostsCount, visiblePostsCount + 5);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);
        }

        isAutoLoading = false;
    }

    private void SwitchLang(string lang)
    {
        activeLang = lang;
    }

    private void ToggleAddCategory()
    {
        showAddCategory = !showAddCategory;
        if (!showAddCategory) newCategoryName = string.Empty;
    }

    private void CancelAddCategory()
    {
        showAddCategory = false;
        newCategoryName = string.Empty;
    }

    private async Task AddCategory()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName))
        {
            showError = true;
            errorMessage = "Kategori ismi boş olamaz.";
            return;
        }

        try
        {
            var cat = new Category
            {
                Name_TR = newCategoryName.Trim(),
                CreatedDate = DateTime.Now,
                IsActive = true
            };

            await CategoryService.Create(cat);

            newCategoryName = string.Empty;
            showAddCategory = false;

            await LoadAll();

            successMessage = "Kategori başarıyla eklendi!";
            showSuccess = true;
            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Kategori eklenirken hata: " + ex.Message;
        }
    }

    private string GetPreviewImage()
        => string.IsNullOrWhiteSpace(newPost.CoverImageUrl)
            ? "https://via.placeholder.com/600x300?text=Kapak+Önizleme"
            : newPost.CoverImageUrl;

    private async Task SavePost()
    {
        showError = false;
        showSuccess = false;

        if (includeTr && string.IsNullOrWhiteSpace(newPost.Title_TR))
        {
            showError = true;
            errorMessage = "Türkçe başlık zorunludur.";
            return;
        }

        if (newPost.CategoryId == 0)
        {
            showError = true;
            errorMessage = "Lütfen kategori seçiniz.";
            return;
        }

        if (!includeTr && !includeEn && !includeAr)
        {
            showError = true;
            errorMessage = "En az bir dil seçmelisiniz.";
            return;
        }

        try
        {
            isSaving = true;

            newPost.CreatedDate = DateTime.Now;
            newPost.IsActive = true;

            if (!includeTr)
            {
                newPost.Title_TR = null;
                newPost.Slug_TR = null;
                newPost.Content_TR = null;
            }
            if (!includeEn)
            {
                newPost.Title_EN = null;
                newPost.Slug_EN = null;
                newPost.Content_EN = null;
            }
            if (!includeAr)
            {
                newPost.Title_AR = null;
                newPost.Slug_AR = null;
                newPost.Content_AR = null;
            }

            await PostService.Create(newPost);
            await LoadAll();

            // Formu temizle
            newPost = new() { PublishedDate = DateTime.Now };
            activeLang = "tr";

            successMessage = "İçerik başarıyla kaydedildi!";
            showSuccess = true;
            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Kayıt sırasında hata: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetPostUrl(Post p)
    {
        if (p?.Category?.Name_TR == null)
            return "#";

        string category = p.Category.Name_TR.Trim().ToLower();

        return category switch
        {
            "hizmetlerimiz" => $"/hizmetlerimiz/{p.Slug_TR}",
            "duyurular" => $"/duyurular/{p.Slug_TR}",
            "etkinlikler" => $"/etkinlikler/{p.Slug_TR}",
            "yayınlar" => $"/yayinlar/{p.Slug_TR}",
            "yayinlar" => $"/yayinlar/{p.Slug_TR}",
            _ => $"/yayinlar/{p.Slug_TR}"
        };
    }

    private string GetCategoryColor(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
            return "#3b82f6";

        return categoryName.ToLowerInvariant() switch
        {
            "hizmetlerimiz" => "#366C80",
            "duyurular" => "#5c7341",
            "etkinlikler" => "#78514A",
            "yayınlar" => "#dfb899",
            "yayinlar" => "#dfb899",
            _ => "#3b82f6"
        };
    }

    private string GetSummary(Post p)
    {
        if (string.IsNullOrWhiteSpace(p.Content_TR)) return "İçerik yok...";
        var content = p.Content_TR.Replace(Environment.NewLine, " ").Trim();
        return content.Length > 100 ? content.Substring(0, 100) + "..." : content;
    }
}