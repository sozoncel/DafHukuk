@page "/admin/yonetim"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject IJSRuntime JS

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@GetText("pageTitle")</h2>
            <p class="text-muted mb-0">@GetText("pageSubtitle")</p>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="modern-alert modern-alert-success" role="alert">
            <div class="modern-alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="modern-alert-content">
                <strong>@GetText("successTitle")</strong>
                <p>@successMessage</p>
            </div>
            <button class="modern-alert-close" @onclick="() => showSuccess = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (showError)
    {
        <div class="modern-alert modern-alert-error" role="alert">
            <div class="modern-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="modern-alert-content">
                <strong>@GetText("errorTitle")</strong>
                <p>@errorMessage</p>
            </div>
            <button class="modern-alert-close" @onclick="() => showError = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <!-- FORM BÖLÜMÜ -->
    <div class="row g-4 mb-5">

        <div class="col-lg-4">
            <div class="card admin-card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        @GetText("generalInfo")
                    </h5>

                    <!-- KATEGORİ SEÇİMİ -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-folder me-1"></i>
                            @GetText("category")
                        </label>
                        <select class="form-select" @bind="newPost.CategoryId">
                            <option value="0">-- @GetText("selectCategory") --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@GetCategoryName(c)</option>
                            }
                        </select>
                    </div>

                    <!-- KAPAK RESMİ -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-image me-1"></i>
                            @GetText("coverImage")
                        </label>
                        <input class="form-control"
                               @bind="newPost.CoverImageUrl"
                               placeholder="https://..." />
                        <div class="mt-3 image-preview-wrapper">
                            <img src="@GetPreviewImage()"
                                 class="img-fluid rounded"
                                 alt="@GetText("preview")" />
                        </div>
                    </div>

                    <!-- YAYIN TARİHİ -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-calendar-event me-1"></i>
                            @GetText("publishDate")
                        </label>
                        <InputDate class="form-control" @bind-Value="newPost.PublishedDate" />
                    </div>

                    <!-- DİL SEÇİMİ -->
                    <div class="mb-4">
                        <label class="form-label d-block mb-2">
                            <i class="bi bi-translate me-1"></i>
                            @GetText("languagesToSave")
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="langTr"
                                       @bind="includeTr" />
                                <label class="form-check-label" for="langTr">
                                    🇹🇷 TR
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="langEn"
                                       @bind="includeEn" />
                                <label class="form-check-label" for="langEn">
                                    🇬🇧 EN
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="langAr"
                                       @bind="includeAr" />
                                <label class="form-check-label" for="langAr">
                                    🇸🇦 AR
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- KAYDET BUTONU -->
                    <button class="btn btn-primary btn-lg w-100"
                            @onclick="SavePost"
                            disabled="@isSaving">
                        <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-save") me-2"></i>
                        @(isSaving ? GetText("saving") : GetText("saveContent"))
                    </button>
                </div>
            </div>
        </div>

        <!-- SAĞ: DİL SEKMELERİ -->
        <div class="col-lg-8">
            <div class="card admin-card h-100">
                <div class="card-header bg-white border-bottom">
                    <ul class="nav nav-tabs card-header-tabs nav-fill border-0">
                        <li class="nav-item">
                            <button class='@GetTabClass("tr")'
                                    @onclick='() => SwitchLang("tr")'
                                    type="button">
                                🇹🇷 Türkçe
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("en")'
                                    @onclick='() => SwitchLang("en")'
                                    type="button">
                                🇬🇧 English
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("ar")'
                                    @onclick='() => SwitchLang("ar")'
                                    type="button">
                                🇸🇦 العربية
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">

                    <!-- TÜRKÇE -->
                    <div class='@GetLangClass("tr")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("title")</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_TR"
                                   placeholder="@GetText("titlePlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control"
                                   @bind="newPost.Slug_TR"
                                   placeholder="@GetText("slugPlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("content")</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_TR"
                                      placeholder="@GetText("contentPlaceholder")"></textarea>
                        </div>
                    </div>

                    <!-- İNGİLİZCE -->
                    <div class='@GetLangClass("en")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("title")</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_EN"
                                   placeholder="@GetText("titlePlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control"
                                   @bind="newPost.Slug_EN"
                                   placeholder="@GetText("slugPlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("content")</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_EN"
                                      placeholder="@GetText("contentPlaceholder")"></textarea>
                        </div>
                    </div>

                    <!-- ARAPÇA -->
                    <div class='@GetLangClass("ar")' dir="rtl">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("title")</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_AR"
                                   placeholder="@GetText("titlePlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control"
                                   style="direction:ltr"
                                   @bind="newPost.Slug_AR"
                                   placeholder="@GetText("slugPlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("content")</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_AR"
                                      placeholder="@GetText("contentPlaceholder")"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KATEGORİLER BÖLÜMÜ -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card admin-card">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-bookmark-fill me-2"></i>
                        @GetText("savedCategories")
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        @if (!categories.Any())
                        {
                            <span class="text-muted">@GetText("noCategories")</span>
                        }
                        else
                        {
                            @foreach (var c in categories)
                            {
                                <span class="badge bg-primary bg-gradient px-3 py-2 fs-6">
                                    @GetCategoryName(c)
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card admin-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-file-text-fill me-2"></i>
                            @GetText("recentPosts") (@FilteredPostsCount)
                        </h5>

                        <!-- FİLTRE VE KONTROLLER -->
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <!-- KATEGORİ FİLTRESİ -->
                            <select class="form-select form-select-sm filter-select"
                                    @bind="filterCategoryId"
                                    @bind:after="ApplyFilter">
                                <option value="0">@GetText("allCategories")</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@GetCategoryName(c)</option>
                                }
                            </select>

                            <!-- DİL FİLTRESİ -->
                            <select class="form-select form-select-sm filter-select"
                                    @bind="filterLanguage"
                                    @bind:after="ApplyFilter">
                                <option value="all">@GetText("allLanguages")</option>
                                <option value="tr">🇹🇷 Türkçe</option>
                                <option value="en">🇬🇧 English</option>
                                <option value="ar">🇸🇦 العربية</option>
                            </select>

                            @if (VisibleHasMore())
                            {
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="LoadMorePosts"
                                        disabled="@isAutoLoading">
                                    <i class="bi bi-arrow-down-circle me-1"></i>
                                    @GetText("loadMore")
                                </button>

                                <button class="btn btn-sm btn-primary"
                                        @onclick="ToggleAutoLoad">
                                    <i class="bi @(isAutoLoading ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                    @(isAutoLoading ? GetText("stop") : GetText("loadAll"))
                                </button>
                            }

                            <span class="badge bg-light text-dark px-3 py-2">
                                @GetText("showing"): @visiblePostsCount / @FilteredPostsCount
                            </span>
                        </div>
                    </div>

                    <!-- KARTLAR -->
                    @if (!posts.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted mt-2">@GetText("noContent")</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4 content-cards-row">
                            @foreach (var p in GetVisiblePosts())
                            {
                                var url = GetPostUrl(p);
                                var title = GetPostTitle(p);
                                var summary = GetPostSummary(p);

                                <div class="col-lg-4 col-md-6 content-card-wrapper"
                                     data-category="@p.CategoryId">
                                    <div class="admin-content-card h-100">
                                        <div class="admin-card-image">
                                            <img src="@p.CoverImageUrl"
                                                 alt="@title"
                                                 onerror="this.src='https://via.placeholder.com/400x200?text=Görsel+Yok'" />
                                            <span class="admin-category-badge"
                                                  style="background: @GetCategoryColor(p.Category?.Name_TR);">
                                                @GetCategoryName(p.Category)
                                            </span>
                                        </div>
                                        <div class="admin-card-content">
                                            <p class="admin-card-date">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @p.PublishedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                            </p>
                                            <h6 class="admin-card-title">@title</h6>
                                            <p class="admin-card-excerpt">@summary</p>
                                            <div class="d-flex gap-2 mt-auto">
                                                <a href="@url"
                                                   class="btn btn-sm btn-outline-primary flex-grow-1"
                                                   target="_blank">
                                                    <i class="bi bi-eye me-1"></i>
                                                    @GetText("view")
                                                </a>
                                                <button class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    private Post newPost = new() { PublishedDate = DateTime.Now };
    private List<Category> categories = new();
    private List<Post> posts = new();
    private string activeLang = "tr";

    private bool showSuccess = false;
    private bool showError = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSaving = false;

    private bool includeTr { get; set; } = true;
    private bool includeEn { get; set; } = false;
    private bool includeAr { get; set; } = false;

    private int visiblePostsCount = 9;
    private bool isAutoLoading = false;
    private int filterCategoryId = 0;
    private string filterLanguage = "all";

    // ÇOK DİLLİ METINLER
    private Dictionary<string, Dictionary<string, string>> translations = new()
    {
        ["tr"] = new()
        {
            ["pageTitle"] = "İçerik Yönetimi",
            ["pageSubtitle"] = "Yeni içerik ekleyin ve mevcut içerikleri yönetin",
            ["successTitle"] = "Başarılı!",
            ["errorTitle"] = "Hata!",
            ["generalInfo"] = "Genel Bilgiler",
            ["category"] = "Kategori",
            ["selectCategory"] = "Kategori Seçin",
            ["coverImage"] = "Kapak Resmi URL",
            ["preview"] = "Önizleme",
            ["publishDate"] = "Yayın Tarihi",
            ["languagesToSave"] = "Kaydedilecek Diller",
            ["saving"] = "Kaydediliyor...",
            ["saveContent"] = "İçeriği Kaydet",
            ["title"] = "Başlık (TR)",
            ["slug"] = "Slug (TR)",
            ["content"] = "İçerik (TR)",
            ["titlePlaceholder"] = "İçerik başlığını girin...",
            ["slugPlaceholder"] = "url-icin-slug",
            ["contentPlaceholder"] = "İçeriği buraya yazın...",
            ["savedCategories"] = "Kayıtlı Kategoriler",
            ["noCategories"] = "Henüz kategori eklenmemiş.",
            ["recentPosts"] = "Son Yazılar",
            ["allCategories"] = "Tüm Kategoriler",
            ["allLanguages"] = "Tüm Diller",
            ["loadMore"] = "Daha Fazla (5)",
            ["stop"] = "Durdur",
            ["loadAll"] = "Tümünü Yükle",
            ["showing"] = "Gösterilen",
            ["noContent"] = "Henüz içerik eklenmemiş.",
            ["view"] = "Görüntüle"
        },
        ["en"] = new()
        {
            ["pageTitle"] = "Content Management",
            ["pageSubtitle"] = "Add new content and manage existing content",
            ["successTitle"] = "Success!",
            ["errorTitle"] = "Error!",
            ["generalInfo"] = "General Information",
            ["category"] = "Category",
            ["selectCategory"] = "Select Category",
            ["coverImage"] = "Cover Image URL",
            ["preview"] = "Preview",
            ["publishDate"] = "Publish Date",
            ["languagesToSave"] = "Languages to Save",
            ["saving"] = "Saving...",
            ["saveContent"] = "Save Content",
            ["title"] = "Title (EN)",
            ["slug"] = "Slug (EN)",
            ["content"] = "Content (EN)",
            ["titlePlaceholder"] = "Enter title...",
            ["slugPlaceholder"] = "url-slug",
            ["contentPlaceholder"] = "Write content here...",
            ["savedCategories"] = "Saved Categories",
            ["noCategories"] = "No categories added yet.",
            ["recentPosts"] = "Recent Posts",
            ["allCategories"] = "All Categories",
            ["allLanguages"] = "All Languages",
            ["loadMore"] = "Load More (5)",
            ["stop"] = "Stop",
            ["loadAll"] = "Load All",
            ["showing"] = "Showing",
            ["noContent"] = "No content added yet.",
            ["view"] = "View"
        },
        ["ar"] = new()
        {
            ["pageTitle"] = "إدارة المحتوى",
            ["pageSubtitle"] = "إضافة محتوى جديد وإدارة المحتوى الحالي",
            ["successTitle"] = "نجاح!",
            ["errorTitle"] = "خطأ!",
            ["generalInfo"] = "معلومات عامة",
            ["category"] = "الفئة",
            ["selectCategory"] = "اختر الفئة",
            ["coverImage"] = "رابط صورة الغلاف",
            ["preview"] = "معاينة",
            ["publishDate"] = "تاريخ النشر",
            ["languagesToSave"] = "اللغات المراد حفظها",
            ["saving"] = "جاري الحفظ...",
            ["saveContent"] = "حفظ المحتوى",
            ["title"] = "العنوان (AR)",
            ["slug"] = "الرابط (AR)",
            ["content"] = "المحتوى (AR)",
            ["titlePlaceholder"] = "أدخل العنوان...",
            ["slugPlaceholder"] = "url-slug",
            ["contentPlaceholder"] = "اكتب المحتوى هنا...",
            ["savedCategories"] = "الفئات المحفوظة",
            ["noCategories"] = "لم يتم إضافة فئات بعد.",
            ["recentPosts"] = "المنشورات الأخيرة",
            ["allCategories"] = "كل الفئات",
            ["allLanguages"] = "كل اللغات",
            ["loadMore"] = "تحميل المزيد (5)",
            ["stop"] = "إيقاف",
            ["loadAll"] = "تحميل الكل",
            ["showing"] = "عرض",
            ["noContent"] = "لم يتم إضافة محتوى بعد.",
            ["view"] = "عرض"
        }
    };

    private string GetText(string key)
    {
        if (translations.ContainsKey(activeLang) && translations[activeLang].ContainsKey(key))
            return translations[activeLang][key];
        return key;
    }

    private string GetTabClass(string lang)
    {
        var baseCls = "nav-link";
        if (activeLang == lang) return $"{baseCls} active";
        return baseCls;
    }

    private string GetLangClass(string lang)
        => activeLang == lang ? "d-block" : "d-none";

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        try
        {
            categories = await CategoryService.GetAll() ?? new();
            posts = (await PostService.GetAll())?.OrderByDescending(x => x.PublishedDate).ToList() ?? new();
            visiblePostsCount = Math.Min(9, FilteredPostsCount);
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Veriler yüklenirken hata: " + ex.Message;
        }
    }

    private IEnumerable<Post> GetVisiblePosts()
    {
        var filtered = posts.Where(p => filterCategoryId == 0 || p.CategoryId == filterCategoryId);

        // Dil filtreleme
        if (filterLanguage != "all")
        {
            filtered = filtered.Where(p =>
            {
                return filterLanguage switch
                {
                    "tr" => !string.IsNullOrWhiteSpace(p.Title_TR),
                    "en" => !string.IsNullOrWhiteSpace(p.Title_EN),
                    "ar" => !string.IsNullOrWhiteSpace(p.Title_AR),
                    _ => true
                };
            });
        }

        return filtered
            .OrderByDescending(p => p.PublishedDate)
            .Take(visiblePostsCount);
    }

    private int FilteredPostsCount
    {
        get
        {
            var filtered = posts.Where(p => filterCategoryId == 0 || p.CategoryId == filterCategoryId);

            if (filterLanguage != "all")
            {
                filtered = filtered.Where(p =>
                {
                    return filterLanguage switch
                    {
                        "tr" => !string.IsNullOrWhiteSpace(p.Title_TR),
                        "en" => !string.IsNullOrWhiteSpace(p.Title_EN),
                        "ar" => !string.IsNullOrWhiteSpace(p.Title_AR),
                        _ => true
                    };
                });
            }

            return filtered.Count();
        }
    }

    private bool VisibleHasMore() => visiblePostsCount < FilteredPostsCount;

    private void ApplyFilter()
    {
        visiblePostsCount = Math.Min(9, FilteredPostsCount);
        isAutoLoading = false;
    }

    private async Task LoadMorePosts()
    {
        var total = FilteredPostsCount;
        visiblePostsCount = Math.Min(total, visiblePostsCount + 5);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleAutoLoad()
    {
        if (isAutoLoading)
        {
            isAutoLoading = false;
            return;
        }

        isAutoLoading = true;

        while (isAutoLoading && VisibleHasMore())
        {
            visiblePostsCount = Math.Min(FilteredPostsCount, visiblePostsCount + 5);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);
        }

        isAutoLoading = false;
    }

    private void SwitchLang(string lang)
    {
        activeLang = lang;
    }

    private string GetPreviewImage()
        => string.IsNullOrWhiteSpace(newPost.CoverImageUrl)
            ? "https://via.placeholder.com/600x300?text=Kapak+Önizleme"
            : newPost.CoverImageUrl;

    private async Task SavePost()
    {
        showError = false;
        showSuccess = false;

        if (includeTr && string.IsNullOrWhiteSpace(newPost.Title_TR))
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => "Turkish title is required.",
                "ar" => "العنوان التركي مطلوب.",
                _ => "Türkçe başlık zorunludur."
            };
            return;
        }

        if (newPost.CategoryId == 0)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => "Please select a category.",
                "ar" => "الرجاء اختيار فئة.",
                _ => "Lütfen kategori seçiniz."
            };
            return;
        }

        if (!includeTr && !includeEn && !includeAr)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => "You must select at least one language.",
                "ar" => "يجب عليك اختيار لغة واحدة على الأقل.",
                _ => "En az bir dil seçmelisiniz."
            };
            return;
        }

        try
        {
            isSaving = true;

            newPost.CreatedDate = DateTime.Now;
            newPost.IsActive = true;

            if (!includeTr)
            {
                newPost.Title_TR = null;
                newPost.Slug_TR = null;
                newPost.Content_TR = null;
            }
            if (!includeEn)
            {
                newPost.Title_EN = null;
                newPost.Slug_EN = null;
                newPost.Content_EN = null;
            }
            if (!includeAr)
            {
                newPost.Title_AR = null;
                newPost.Slug_AR = null;
                newPost.Content_AR = null;
            }

            await PostService.Create(newPost);
            await LoadAll();

            newPost = new() { PublishedDate = DateTime.Now };
            activeLang = "tr";

            successMessage = activeLang switch
            {
                "en" => "Content saved successfully!",
                "ar" => "تم حفظ المحتوى بنجاح!",
                _ => "İçerik başarıyla kaydedildi!"
            };

            showSuccess = true;
            await Task.Delay(3000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Error during save: {ex.Message}",
                "ar" => $"خطأ أثناء الحفظ: {ex.Message}",
                _ => $"Kayıt sırasında hata: {ex.Message}"
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetPostUrl(Post p)
    {
        if (p?.Category?.Name_TR == null)
            return "#";

        string category = p.Category.Name_TR.Trim().ToLower();

        return category switch
        {
            "hizmetlerimiz" => $"/hizmetlerimiz/{p.Slug_TR}",
            "duyurular" => $"/duyurular/{p.Slug_TR}",
            "etkinlikler" => $"/etkinlikler/{p.Slug_TR}",
            "yayınlar" => $"/yayinlar/{p.Slug_TR}",
            "yayinlar" => $"/yayinlar/{p.Slug_TR}",
            _ => $"/yayinlar/{p.Slug_TR}"
        };
    }

    private string GetCategoryName(Category? category)
    {
        if (category == null) return "";

        return activeLang switch
        {
            "en" => category.Name_EN ?? category.Name_TR,
            "ar" => category.Name_AR ?? category.Name_TR,
            _ => category.Name_TR
        };
    }

    private string GetPostTitle(Post p)
    {
        return activeLang switch
        {
            "en" => p.Title_EN ?? p.Title_TR ?? "",
            "ar" => p.Title_AR ?? p.Title_TR ?? "",
            _ => p.Title_TR ?? ""
        };
    }

    private string GetPostSummary(Post p)
    {
        string content = activeLang switch
        {
            "en" => p.Content_EN ?? p.Content_TR ?? "",
            "ar" => p.Content_AR ?? p.Content_TR ?? "",
            _ => p.Content_TR ?? ""
        };

        if (string.IsNullOrWhiteSpace(content)) return "İçerik yok...";
        content = content.Replace(Environment.NewLine, " ").Trim();
        return content.Length > 100 ? content.Substring(0, 100) + "..." : content;
    }

    private string GetCategoryColor(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
            return "#3b82f6";

        return categoryName.ToLowerInvariant() switch
        {
            "hizmetlerimiz" => "#366C80",
            "duyurular" => "#5c7341",
            "etkinlikler" => "#78514A",
            "yayınlar" => "#dfb899",
            "yayinlar" => "#dfb899",
            _ => "#3b82f6"
        };
    }
}