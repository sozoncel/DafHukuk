@page "/admin/yonetim"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout

@using DafHukuk.Core.Entities
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject IJSRuntime JS

<link href="~/css/yonetim.css" rel="stylesheet" />

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Yeni İçerik Ekle</h3>
    </div>

    @if (showSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Başarılı!</strong> İçerik başarıyla kaydedildi.
            <button type="button" class="btn-close" @onclick="() => showSuccess = false"></button>
        </div>
    }

    @if (showError)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Hata!</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => showError = false"></button>
        </div>
    }

    <div class="row">

        <!-- LEFT: General / Meta -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5 class="mb-3 text-primary">Genel Bilgiler</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">Kategori Seçin</label>

                    <div class="d-flex gap-2 mb-2">
                        <select class="form-select form-select-lg" @bind="newPost.CategoryId">
                            <option value="0">-- Kategori Seçin --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name_TR</option>
                            }
                        </select>

                        <button class="btn btn-outline-secondary" @onclick="ToggleAddCategory" title="Yeni kategori ekle">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>

                    @if (showAddCategory)
                    {
                        <div class="d-flex gap-2 mt-2">
                            <input class="form-control" @bind="newCategoryName" placeholder="Yeni kategori (TR)" />
                            <button class="btn btn-primary" @onclick="AddCategory">Ekle</button>
                            <button class="btn btn-outline-secondary" @onclick="CancelAddCategory">İptal</button>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Kapak Resmi URL</label>
                    <input class="form-control" @bind="newPost.CoverImageUrl" placeholder="http://..." />
                    <div class="mt-2 rounded overflow-hidden border">
                        <img src="@GetPreviewImage()" class="img-fluid admin-image-preview" alt="Kapak önizleme" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Yayın Tarihi</label>
                    <InputDate class="form-control" @bind-Value="newPost.PublishedDate" />
                </div>

                <div class="mt-3">
                    <label class="form-label fw-bold d-block mb-2">Kaydedilecek Diller</label>
                    <div class="d-flex gap-2 align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="langTr" @bind="includeTr" />
                            <label class="form-check-label" for="langTr">Türkçe</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="langEn" @bind="includeEn" />
                            <label class="form-check-label" for="langEn">English</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="langAr" @bind="includeAr" />
                            <label class="form-check-label" for="langAr">العربية</label>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary btn-lg w-100 mt-4" @onclick="SavePost" disabled="@isSaving">
                    <i class="bi bi-save2 me-2"></i>
                    @(isSaving ? "Kaydediliyor..." : "İçeriği Kaydet")
                </button>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light p-0">
                    <ul class="nav nav-tabs card-header-tabs nav-fill">

                        <li class="nav-item">
                            <button class='@GetTabClass("tr")'
                                    @onclick='() => SwitchLang("tr")'
                                    type="button">
                                🇹🇷 Türkçe
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class='@GetTabClass("en")'
                                    @onclick='() => SwitchLang("en")'
                                    type="button">
                                🇬🇧 English
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class='@GetTabClass("ar")'
                                    @onclick='() => SwitchLang("ar")'
                                    type="button">
                                🇸🇦 العربية
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <!-- TR -->
                    <div class='@GetLangClass("tr")'>
                        <div class="mb-3">
                            <label class="form-label">Başlık (TR)</label>
                            <input class="form-control form-control-lg" @bind="newPost.Title_TR" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Slug (TR)</label>
                            <input class="form-control bg-light" @bind="newPost.Slug_TR" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">İçerik (TR)</label>
                            <textarea class="form-control" rows="12" @bind="newPost.Content_TR"></textarea>
                        </div>
                    </div>

                    <!-- EN -->
                    <div class='@GetLangClass("en")'>
                        <div class="mb-3">
                            <label class="form-label">Title (EN)</label>
                            <input class="form-control form-control-lg" @bind="newPost.Title_EN" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Slug (EN)</label>
                            <input class="form-control bg-light" @bind="newPost.Slug_EN" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Content (EN)</label>
                            <textarea class="form-control" rows="12" @bind="newPost.Content_EN"></textarea>
                        </div>
                    </div>

                    <!-- AR -->
                    <div class='@GetLangClass("ar")' dir="rtl">
                        <div class="mb-3">
                            <label class="form-label">العنوان (AR)</label>
                            <input class="form-control form-control-lg" @bind="newPost.Title_AR" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الرابط (AR)</label>
                            <input class="form-control bg-light" style="direction:ltr" @bind="newPost.Slug_AR" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">المحتوى (AR)</label>
                            <textarea class="form-control" rows="12" @bind="newPost.Content_AR"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <hr class="my-4" />

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="admin-card-list">
                <h5>Kayıtlı Kategoriler</h5>
                @foreach (var c in categories)
                {
                    <div class="admin-list-item">@c.Name_TR</div>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="admin-card-list">
                <h5>Son Yazılar</h5>

                <div class="d-flex align-items-center gap-2 mb-3 admin-load-controls">
                    <select class="form-select admin-filter" @bind="filterCategoryId">
                        <option value="0">Tümü</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name_TR</option>
                        }
                    </select>

                    <button class="btn btn-outline-primary" @onclick="LoadMorePosts" disabled="@isAutoLoading">
                        Daha Fazla (5)
                    </button>

                    <button class="btn btn-primary" @onclick="ToggleAutoLoad">
                        @(isAutoLoading ? "Durdur" : "Tümünü Yükle (otomatik)")
                    </button>

                    <div class="ms-auto text-muted small">
                        Gösterilen: @visiblePostsCount / @FilteredPostsCount
                    </div>
                </div>

                @foreach (var p in GetVisiblePosts())
                {
                    <div class="admin-list-item">
                        <div class="admin-post-title">@p.Title_TR</div>
                        <div class="admin-post-meta">
                            @p.Category?.Name_TR — @p.PublishedDate.ToString("yyyy-MM-dd")
                        </div>
                    </div>
                }

                @if (VisibleHasMore())
                {
                    <div class="text-center mt-3">
                        <button class="btn btn-outline-secondary" @onclick="LoadMorePosts">Daha Fazla Yükle</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private Post newPost = new() { PublishedDate = DateTime.Now };
    private List<Category> categories = new();
    private List<Post> posts = new();
    private string activeLang = "tr";

    private bool showAddCategory = false;
    private string newCategoryName = string.Empty;

    private bool showSuccess = false;
    private bool showError = false;
    private string errorMessage = string.Empty;
    private bool isSaving = false;

    private bool includeTr { get; set; } = true;
    private bool includeEn { get; set; } = false;
    private bool includeAr { get; set; } = false;

    private int visiblePostsCount = 5;
    private bool isAutoLoading = false;
    private int filterCategoryId = 0;

    private string GetTabClass(string lang)
    {
        var baseCls = "nav-link py-3";
        if (activeLang == lang) return $"{baseCls} active fw-bold";
        return baseCls;
    }

    private string GetLangClass(string lang)
        => activeLang == lang ? "d-block" : "d-none";

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        try
        {
            categories = await CategoryService.GetAll() ?? new();
            posts = (await PostService.GetAll())?.OrderByDescending(x => x.PublishedDate).ToList() ?? new();
            visiblePostsCount = Math.Min(visiblePostsCount, FilteredPostsCount);
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = "Veriler yüklenirken hata: " + ex.Message;
        }
    }

    private IEnumerable<Post> GetVisiblePosts()
    {
        return posts
                .Where(p => filterCategoryId == 0 || p.CategoryId == filterCategoryId)
                .OrderByDescending(p => p.PublishedDate)
                .Take(visiblePostsCount);
    }

    private int FilteredPostsCount =>
        posts.Count(p => filterCategoryId == 0 || p.CategoryId == filterCategoryId);

    private bool VisibleHasMore() => visiblePostsCount < FilteredPostsCount;

    private async Task LoadMorePosts()
    {
        var total = FilteredPostsCount;
        visiblePostsCount = Math.Min(total, visiblePostsCount + 5);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleAutoLoad()
    {
        if (isAutoLoading)
        {
            isAutoLoading = false;
            return;
        }

        isAutoLoading = true;

        while (isAutoLoading && VisibleHasMore())
        {
            visiblePostsCount = Math.Min(FilteredPostsCount, visiblePostsCount + 5);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(600); 
        }

        isAutoLoading = false;
    }

    private void SwitchLang(string lang)
    {
        activeLang = lang;
    }

    private void ToggleAddCategory()
    {
        showAddCategory = !showAddCategory;
        if (!showAddCategory) newCategoryName = string.Empty;
    }

    private void CancelAddCategory()
    {
        showAddCategory = false;
        newCategoryName = string.Empty;
    }

    private async Task AddCategory()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName))
        {
            await JS.InvokeVoidAsync("alert", "Kategori ismi boş olamaz.");
            return;
        }

        try
        {
            var cat = new Category
            {
                Name_TR = newCategoryName.Trim(),
                CreatedDate = DateTime.Now,
                IsActive = true
            };

            await CategoryService.Create(cat);

            newCategoryName = string.Empty;
            showAddCategory = false;

            await LoadAll();

            showSuccess = true;
            await Task.Delay(1200);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = ex.Message;
        }
    }

    private string GetPreviewImage()
        => string.IsNullOrWhiteSpace(newPost.CoverImageUrl)
            ? "https://via.placeholder.com/600x300?text=Kapak+Önizleme"
            : newPost.CoverImageUrl;

    private async Task SavePost()
    {
        showError = false;
        showSuccess = false;

        if (includeTr && string.IsNullOrWhiteSpace(newPost.Title_TR))
        {
            showError = true;
            errorMessage = "Başlık (TR) zorunludur.";
            return;
        }

        if (newPost.CategoryId == 0)
        {
            showError = true;
            errorMessage = "Lütfen kategori seçiniz.";
            return;
        }

        try
        {
            isSaving = true;

            newPost.CreatedDate = DateTime.Now;
            newPost.IsActive = true;

            if (!includeTr)
            {
                newPost.Title_TR = null;
                newPost.Slug_TR = null;
                newPost.Content_TR = null;
            }
            if (!includeEn)
            {
                newPost.Title_EN = null;
                newPost.Slug_EN = null;
                newPost.Content_EN = null;
            }
            if (!includeAr)
            {
                newPost.Title_AR = null;
                newPost.Slug_AR = null;
                newPost.Content_AR = null;
            }

            await PostService.Create(newPost);
            await LoadAll();

            // Temizle
            newPost = new() { PublishedDate = DateTime.Now };

            showSuccess = true;
            await Task.Delay(1500);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
