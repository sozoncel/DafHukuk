@page "/admin/yonetim"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Yeni İçerik Ekle</h3>
    </div>

    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Başarılı!</strong> İçerik başarıyla veritabanına kaydedildi.
        <button type="button" class="btn-close"></button>
    </div>

    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Hata!</strong> Lütfen Kayıt etmek için bir Kategori seçiniz.
        <button type="button" class="btn-close"></button>
    </div>

    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5 class="mb-3 text-primary">Genel Bilgiler</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">Kategori Seçin</label>
                    <select class="form-select form-select-lg">
                        <option value="0">-- Kategori Seçin --</option>
                        <option>Örnek Kategori 1</option>
                        <option>Örnek Kategori 2</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Kapak Resmi URL</label>
                    <input class="form-control" placeholder="http://..." />
                    <div class="mt-2 rounded overflow-hidden border">
                        <img src="https://via.placeholder.com/150" class="img-fluid" style="max-height: 150px; width: 100%; object-fit: cover;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Yayın Tarihi</label>
                    <input type="date" class="form-control" />
                </div>

                <button class="btn btn-primary btn-lg w-100 mt-3">
                    <i class="bi bi-save2 me-2"></i> İçeriği Kaydet
                </button>
            </div>
        </div>

        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-light p-0">
                    <ul class="nav nav-tabs card-header-tabs nav-fill">
                        <li class="nav-item">
                            <button class="nav-link py-3 active fw-bold" type="button">
                                🇹🇷 Türkçe
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-3" type="button">
                                🇬🇧 English
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link py-3" type="button">
                                🇸🇦 العربية
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">

                    <!-- Türkçe -->
                    <div class="d-block">
                        <div class="mb-3">
                            <label class="form-label">Başlık (TR)</label>
                            <input class="form-control form-control-lg" placeholder=" Davas Süreci" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Slug / URL (TR)</label>
                            <input class="form-control bg-light" placeholder="davas-sureci" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">İçerik (TR)</label>
                            <textarea class="form-control" rows="12"></textarea>
                        </div>
                    </div>

                    <!-- İngilizce -->
                    <div class="d-none">
                        <div class="mb-3">
                            <label class="form-label">Title (EN)</label>
                            <input class="form-control form-control-lg" placeholder="Divorce Case Process" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Slug / URL (EN)</label>
                            <input class="form-control bg-light" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Content (EN)</label>
                            <textarea class="form-control" rows="12"></textarea>
                        </div>
                    </div>

                    <!-- Arapça -->
                    <div class="d-none" dir="rtl">
                        <div class="mb-3">
                            <label class="form-label">العنوان (AR)</label>
                            <input class="form-control form-control-lg" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-end">الرابط (AR)</label>
                            <input class="form-control bg-light" style="direction: ltr;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">المحتوى (AR)</label>
                            <textarea class="form-control" rows="12"></textarea>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>
