@page "/"
@layout DafHukuk.Web.Components.Layout.MainLayout
@inject IPostService PostService

<section class="hero-section">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-container">
        <div class="row">
            <div class="col-lg-8 hero-content-col">
                <p class="hero-lead-text">
                    Hukuki danışmanlık alanında Türkiye’nin en güçlü isimlerinden biri olan Paksoy,
                    hizmetlerini derin hukuki deneyime ve farklı alanlarda tecrübeye sahip 120’nin üstünde
                    avukat, danışman ve destek biriminden oluşan yetkin bir ekiple sunmaktadır.
                </p>
            </div>
        </div>
        <div class="hero-bottom-row">
            <div class="slogan-wrapper">
                <div class="slogan-text-style">
                    Your <br> success. <br> Our <br> business.
                </div>
            </div>

            <div class="news-widget">
                <div class="news-title-box">
                    <span>Duyurular & <br> Yayınlar</span>
                </div>

                <div class="news-content-box">
                    @if (lastPost != null)
                    {
                        <div class="news-img-wrapper">
                            <img src="@lastPost.CoverImageUrl" alt="@lastPost.Title_TR" />
                        </div>

                        <div class="news-info">
                            <span class="news-date">
                                @lastPost.PublishedDate.ToString("dd MMMM yyyy")
                            </span>

                            <a href="/@lastPost.Category.Name_TR/@lastPost.Slug_TR" class="news-link">
                                @lastPost.Title_TR
                            </a>
                        </div>
                    }
                    else
                    {
                        <p>Henüz yayınlanmış bir haber bulunmuyor.</p>
                    }
                </div>

            </div>

        </div>
    </div>
</section>

@code {
    private Post lastPost;

    protected override async Task OnInitializedAsync()
    {
        var posts = await PostService.GetAll();

        lastPost = posts
            .OrderByDescending(p => p.PublishedDate)
            .FirstOrDefault();
    }
}