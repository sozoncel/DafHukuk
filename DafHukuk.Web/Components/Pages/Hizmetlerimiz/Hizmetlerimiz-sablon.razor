@page "/hizmetlerimiz/{slug}"
@layout DafHukuk.Web.Components.Layout.MainLayout

@inject IPostService PostService

@code {
    [Parameter] public string slug { get; set; }

    private Post currentPost;
    private Post featuredPost;

    private List<Post> allPosts = new();
    private List<Post> servicePosts = new(); 

    protected override async Task OnInitializedAsync()
    {
        allPosts = await PostService.GetAll();

        currentPost = allPosts.FirstOrDefault(
            x => string.Equals(x.Slug_TR, slug, StringComparison.OrdinalIgnoreCase)
        );

        servicePosts = allPosts
            .Where(p => p.CategoryId == 18 && p.Id != currentPost?.Id)
            .OrderBy(p => p.Title_TR)
            .ToList();

        var dateCutOff = DateTime.Now.AddMonths(-12);

        var recent = allPosts
            .Where(p => p.Id != currentPost?.Id && p.PublishedDate >= dateCutOff)
            .ToList();

        var candidateList = recent.Any()
            ? recent
            : allPosts.Where(p => p.Id != currentPost?.Id).ToList();

        if (candidateList.Any())
        {
            var rnd = new Random();
            featuredPost = candidateList[rnd.Next(candidateList.Count)];
        }
    }

    private string GetFeaturedUrl()
    {
        if (featuredPost == null || featuredPost.Category == null)
            return "#";

        return featuredPost.Category.Name_TR switch
        {
            "Hizmetlerimiz" => $"/hizmetlerimiz/{featuredPost.Slug_TR}",
            "Duyurular" => $"/duyurular/{featuredPost.Slug_TR}",
            "Etkinlikler" => $"/etkinlikler/{featuredPost.Slug_TR}",
            "Yayınlar" => $"/yayinlar/{featuredPost.Slug_TR}",
            _ => $"/hizmetlerimiz/{featuredPost.Slug_TR}"
        };
    }
}

<PageTitle>@currentPost?.Title_TR</PageTitle>


<!-- HERO -->
<section class="hero-servicesTemplate-section">

    <div class="hero-servicesTemplate-bg"
         style="background-image: url('@currentPost?.CoverImageUrl');">
    </div>

    <div class="hero-servicesTemplate-overlay"></div>

    <div class="hero-servicesTemplate-container">
        <div class="hero-servicesTemplate-title-content">
            <h2 class="servicesTemplate-hero-title-upper">Hizmetlerimiz</h2>

            <div class="hero-servicesTemplate-title-wrapper">

                <h1 class="hero-servicesTemplate-title">
                    @currentPost?.Title_TR
                </h1>

                <div class="hero-servicesTemplate-breadcrumb">
                    <a href="/">Ana Sayfa</a> /
                    <a href="/hizmetlerimiz">Hizmetlerimiz</a> /
                    <span>@currentPost?.Title_TR</span>
                </div>

            </div>
        </div>
    </div>
</section>


<section class="page-content service-page-content">

    <!-- ANA İÇERİK -->
    <div class="row">

        <!-- SOL ANA METİN -->
        <div class="col-lg-9">
            <p>@((MarkupString)currentPost?.Content_TR)</p>
        </div>

        <!-- SAĞ SİDEBAR -->
        <div class="col-lg-3">

            <div class="dropdown modern-dropdown w-100 mb-3">
                <button class="btn dropdown-toggle modern-dropdown-toggle w-100"
                        type="button"
                        id="hizmetDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    Hizmet konusu seçin
                </button>

                <ul class="dropdown-menu modern-dropdown-menu w-100" aria-labelledby="hizmetDropdown">
                    @foreach (var post in servicePosts)
                    {
                        <li>
                            <a class="dropdown-item modern-dropdown-item"
                               href="/hizmetlerimiz/@post.Slug_TR">
                                @post.Title_TR
                            </a>
                        </li>
                    }

                    @if (!servicePosts.Any())
                    {
                        <li><span class="dropdown-item text-muted">Diğer hizmet bulunamadı.</span></li>
                    }
                </ul>
            </div>

            <div class="tanitimText">
                <p>“ The firm’s energy and projects department is one of its core strengths. ”</p>
                <span>IFLR 1000</span>
            </div>

        </div>

    </div>




    <!-- ======================================================== -->
    <!--  İLGİLİ KİŞİLER & ÖNE ÇIKAN YAYINLAR -->
    <!-- ======================================================== -->

    <div class="row section-separator">
        <div class="col-12">
            <h4 class="text-start text-lg-start text-center">İlgili kişiler</h4>
        </div>
    </div>

    <div class="row featured align-items-start">

        <!-- İLGİLİ KİŞİLER -->
        <div class="col-lg-9 col-md-12 mb-4">

            <div class="row team-cards-row g-4">

                <!-- KART 1 -->
                <div class="col-12 team-card-col">
                    <div class="hizmetlerimiz-avukat-card">
                        <img src="img/sayfalar/ekibimiz/daf-ekip-01.jpg" class="hizmetlerimiz-avukat-img" alt="Avukat Serdar Bek">
                        <a href="/ekibimiz/template" class="hizmetlerimiz-avukat-name-link">
                            <h3 class="hizmetlerimiz-avukat-name">Serdar Bek</h3>
                        </a>
                        <hr class="card-divider">
                        <a href="mailto:serdarbek@daf.com" class="mail-box-link">
                            <i class="fa fa-envelope-o"></i>
                        </a>
                    </div>
                </div>

                <!-- KART 2 -->
                <div class="col-12 team-card-col">
                    <div class="hizmetlerimiz-avukat-card">
                        <img src="img/sayfalar/ekibimiz/daf-ekip-02.jpg" class="hizmetlerimiz-avukat-img" alt="Avukat Ahmet Yilmaz">
                        <a href="#" class="hizmetlerimiz-avukat-name-link">
                            <h3 class="hizmetlerimiz-avukat-name">Ahmet Yılmaz</h3>
                        </a>
                        <hr class="card-divider">
                        <a href="mailto:ahmetyilmaz@daf.com" class="mail-box-link">
                            <i class="fa fa-envelope-o"></i>
                        </a>
                    </div>
                </div>

                <!-- KART 3 -->
                <div class="col-12 team-card-col">
                    <div class="hizmetlerimiz-avukat-card">
                        <img src="img/sayfalar/ekibimiz/daf-ekip-03.jpg" class="hizmetlerimiz-avukat-img" alt="Avukat Davut Ata">
                        <a href="#" class="hizmetlerimiz-avukat-name-link">
                            <h3 class="hizmetlerimiz-avukat-name">Davut Ata</h3>
                        </a>
                        <hr class="card-divider">
                        <a href="mailto:davutata@daf.com" class="mail-box-link">
                            <i class="fa fa-envelope-o"></i>
                        </a>
                    </div>
                </div>

            </div>

        </div>


        <!-- ÖNE ÇIKAN YAYIN -->
        <div class="col-lg-3 col-md-12">

            <h5 class="featured-publications-title text-center text-lg-start mb-3">
                Öne Çıkan Yayınlar
            </h5>

            @if (featuredPost != null)
            {
                <div class="content-card featured-publication-card">

                    <p class="created-Date">
                        @featuredPost.PublishedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                    </p>

                    <img class="featured-img" src="@featuredPost.CoverImageUrl" alt="@featuredPost.Title_TR">

                    <a href="@GetFeaturedUrl()" class="content-title-link">
                        <h3 class="textContent">@featuredPost.Title_TR</h3>
                    </a>

                    @if (!string.IsNullOrEmpty(featuredPost.Category?.Name_TR))
                    {
                        <a href="@GetFeaturedUrl()" class="content-tag-button">
                            @featuredPost.Category?.Name_TR
                        </a>
                    }

                    <p class="slug-text">@featuredPost.Slug_TR</p>

                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    Öne çıkan yayın bulunamadı.
                </div>
            }

        </div>

    </div>



    <!-- ======== İLİŞKİLİ İÇERİKLER ======== -->

    <div class="row related-content-nav-row mt-5 mb-3">
        <div class="col-sm-12">
            <h3 class="related-content-heading">İlişkili İçerikler</h3>

            <ul class="nav nav-tabs custom-tabs" id="categoryTabs">

                <li class="nav-item">
                    <a class="nav-link active" href="javascript:void(0)" onclick="filterCategory(0)">
                        Hepsini Göster
                    </a>
                </li>

                @foreach (var cat in allPosts
                                .Where(x => x.Category != null)
                                .Select(x => x.Category)
                                .Distinct()
                                .OrderBy(x => x.Name_TR))
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           href="javascript:void(0)"
                           onclick="filterCategory(@cat.Id)">
                            @cat.Name_TR
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>


    <!-- ======== İÇERİK KART GRİD ======== -->

    <div class="row content-cards-row" id="contentContainer">

        @foreach (var p in allPosts
                .Where(x => x.CategoryId != null)
                .OrderByDescending(x => x.PublishedDate))
        {
            var categoryName = p.Category?.Name_TR?.ToLower() ?? "";

            string url = categoryName switch
            {
                "hizmetlerimiz" => $"/hizmetlerimiz/{p.Slug_TR}",
                "duyurular" => $"/duyurular/{p.Slug_TR}",
                "etkinlikler" => $"/etkinlikler/{p.Slug_TR}",
                "yayınlar" => $"/yayinlar/{p.Slug_TR}",
                _ => $"/hizmetlerimiz/{p.Slug_TR}"
            };

            <div class="col-lg-4 mb-4 content-card-wrapper"
                 data-category="@p.CategoryId">

                <div class="content-card">

                    <p class="created-Date">
                        @p.PublishedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                    </p>

                    <a href="@url" class="content-title-link">
                        <h3 class="textContent">@p.Title_TR</h3>
                    </a>

                    <a href="@url">
                        <button class="content-tag-button">@p.Category?.Name_TR</button>
                    </a>

                    <p class="slug-text">
                        @((p.Content_TR?.Length ?? 0) > 120
                                            ? p.Content_TR.Substring(0, 120) + "..."
                                            : p.Content_TR)
                </p>

                </div>
            </div>
                }
    </div>


    <!-- BOŞ MESAJ -->
    <div class="row">
        <div class="col-12 text-center">
            <p id="noContentMessage"
               style="display:none; font-weight:bold; margin-top:20px;">
                Henüz içerik eklenmemiştir.
            </p>
        </div>
    </div>


    <!-- TÜMÜNÜ GÖSTER -->
    <div class="row mt-4 mb-5">
        <div class="col-lg-12 text-center">
            <button id="showAllButton"
                    class="show-all-button"
                    style="display:none"
                    onclick="showAll()">
                Tümünü Göster
            </button>
        </div>
    </div>

</section>
