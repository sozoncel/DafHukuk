                    <div class="carousel-item active">
                        <div class="row g-4">
                            <div class="col-12 col-sm-6 col-md-3">
                                <div class="lawyer-card">
                                    <div class="lawyer-photo">
                                        <img src="https://via.placeholder.com/300x400" alt="Zekican Somay" />
                                    </div>
                                    <h5 class="lawyer-name">Zekican Somay</h5>
                                    <span class="lawyer-title">Kurucu ve Yönetici Ortak</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-3">
                                <div class="lawyer-card">
                                    <div class="lawyer-photo">
                                        <img src="https://via.placeholder.com/300x400" alt="Evrim Somay Ergun" />
                                    </div>
                                    <h5 class="lawyer-name">Evrim Somay Ergun</h5>
                                    <span class="lawyer-title">Kıdemli Ortak Avukat</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-3">
                                <div class="lawyer-card">
                                    <div class="lawyer-photo">
                                        <img src="https://via.placeholder.com/300x400" alt="Mine Yılmaz" />
                                    </div>
                                    <h5 class="lawyer-name">Mine Yılmaz</h5>
                                    <span class="lawyer-title">Kıdemli Avukat</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-3">
                                <div class="lawyer-card">
                                    <div class="lawyer-photo">
                                        <img src="https://via.placeholder.com/300x400" alt="Burak Özyıldırım" />
                                    </div>
                                    <h5 class="lawyer-name">Burak Özyıldırım</h5>
                                    <span class="lawyer-title">Avukat</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="content-card featured-publication-card">
                <p class="created-Date">17 Haziran 2022</p>
                <a href="#" class="content-title-link">
                    <h3 class="textContent">
                        Belediyelerin Yap-İşlet-Devret Modeliyle Altyapı Yatırımları Yapmasının Önü Açıldı
