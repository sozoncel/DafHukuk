@page "/hizmetlerimiz"
@layout DafHukuk.Web.Components.Layout.MainLayout
@inject IPostService PostService

@code {
    private List<Post> posts = new();

    protected override async Task OnInitializedAsync()
    {
        posts = await PostService.GetAll();
    }
}

<section class="hero-services-section">
    <div class="hero-services-bg"></div>
    <div class="hero-services-overlay"></div>

    <div class="hero-services-container">
        <div class="hero-services-title-content">
            <h2 class="services-hero-title-upper">Hizmetlerimiz</h2>
            <div class="hero-services-title-wrapper">
                <h1 class="hero-services-title">Çalışma Alanlarımız</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="hero-about-slogan-wrapper">
                    <div class="hero-about-slogan-text-style">
                        Your <br> success. <br> Our <br> business.
                    </div>
                </div>
                <div class="hero-about-breadcrumb">
                    <a href="/">Ana Sayfa</a> / <span>Hizmetlerimiz</span>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="services-content">
    <div class="services-page-content">
        <div class="content-container intro-container">
            <div class="row align-items-center">

                <div class="col-lg-6">
                    <h3>Hizmetlerimiz</h3>
                    <p>
                        Müvekkillerimize, ulusal ve uluslararası alanda karşılaştıkları hukuki zorluklarda,
                        uzman kadromuz ve geniş tecrübemizle kapsamlı ve stratejik çözümler sunuyoruz.
                        Hukukun her alanında yetkinliğimizle yanınızdayız.
                    </p>
                    <a href="#practiceAreas" class="pageMove">Çalışma Alanları</a>
                </div>

                <div class="col-lg-6">
                    <img src="/img/sayfalar/hizmetlerimiz/daf-hizmetlerimiz.png" alt="Modern Ofis Koridoru">
                </div>

            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <h2 id="practiceAreas" class="section-title">Çalışma Alanları</h2>
            </div>
        </div>

        <div class="row g-4 practice-cards-row">
            @foreach (var post in posts)
            {
                @if (post.CategoryId == 18)
                {
                    <div class="col-lg-3">
                        <div class="practice-card">
                            <img src="@post.CoverImageUrl" alt="@post.Title_TR" />
                            <a href="/hizmetlerimiz/@post.Slug_TR">
                                <h3 class="practice-title">@post.Title_TR</h3>
                            </a>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="row-contact">
            <div class="col-12">
                <p class="contact-text">Birlikte çalışmak için iletişime geçebilirsiniz.</p>
                <a href="/iletisim" class="contact-button">
                    İLETİŞİM <span class="arrow-icon"></span>
                </a>
            </div>
        </div>

    </div>
</section>