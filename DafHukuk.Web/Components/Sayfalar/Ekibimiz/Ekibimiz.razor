@page "/ekibimiz"
@page "/en/team"
@page "/ar/team"
@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@using DafHukuk.Service.Interfaces

@inject ILawyerService LawyerService
@inject DafHukuk.Service.ILanguageService LanguageService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@GetText("pageTitle")</PageTitle>

<section class="modern-team-hero">
    <div class="hero-particles"></div>
    <div class="hero-gradient-overlay"></div>

    <div class="hero-content-wrapper">
      @*   <div class="hero-content-inner">
            <span class="hero-badge">@GetText("pageTitleUpper")</span>
            <h1 class="hero-main-title">
                <span class="title-line">@GetText("mainTitle")</span>
            </h1>
            <div class="hero-breadcrumb-modern">
                <a href="@LanguageService.GetLocalizedUrl("/")" class="breadcrumb-link">@GetText("breadcrumbHome")</a>
                <span class="breadcrumb-separator">/</span>
                <span class="breadcrumb-current">@GetText("breadcrumbTeam")</span>
            </div>
        </div> *@
    </div>
</section>

<section class="modern-team-section">
    <div class="team-container">

       

        <div class="team-grid-modern">
            @if (Lawyers == null)
            {
                <div class="loading-state">
                    <div class="loading-spinner"></div>
                    <p>@GetText("loading")</p>
                </div>
            }
            else if (Lawyers.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <p>@GetText("noMembers")</p>
                </div>
            }
            else
            {
                @foreach (var lawyer in Lawyers)
                {
                    <a href="@GetLocalizedMemberUrl(lawyer)" class="lawyer-card-modern">
                        <div class="lawyer-card-inner">
                            <div class="lawyer-image-container">
                                <div class="image-overlay"></div>
                                <img src="@(string.IsNullOrEmpty(lawyer.ImageUrl) ? "/img/placeholder.jpg" : lawyer.ImageUrl)"
                                     alt="@lawyer.Name"
                                     class="lawyer-image" />
                                <div class="lawyer-hover-info">
                                    <span class="view-profile-text">@GetText("viewProfile")</span>
                                    <i class="bi bi-arrow-right"></i>
                                </div>
                            </div>

                            <div class="lawyer-info-content">
                                <h3 class="lawyer-name-modern">@lawyer.Name</h3>
                                <p class="lawyer-title-modern">@GetLawyerTitle(lawyer)</p>
                                <div class="lawyer-card-divider"></div>
                            </div>
                        </div>
                    </a>
                }
            }
        </div>
        <br />
        <div class="team-intro-wrapper">
            <div class="intro-content">
                <h2 class="section-subtitle">@GetText("teamInfoTitle")</h2>
                <p class="team-description">@GetText("teamInfoText")</p>
            </div>
        </div>
    </div>
</section>

@code {
    private List<Lawyer>? Lawyers { get; set; }
    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
         Lawyers = await LawyerService.GetAll();
        Lawyers = Lawyers.OrderBy(l => l.Id).ToList();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["pageTitle"] = "Ekibimiz - DAF Hukuk ve Danışmanlık",
            ["pageTitleUpper"] = "Ekibimiz",
            ["mainTitle"] = "Hukuk Kadrosu",
            ["breadcrumbHome"] = "Ana Sayfa",
            ["breadcrumbTeam"] = "Ekibimiz",
            ["teamInfoTitle"] = "Profesyonel Ekibimiz",
            ["teamInfoText"] = "Deneyimli avukat ve hukuk uzmanından oluşan ekibimizle, müvekkillerimize en yüksek standartlarda hukuki hizmet sunmaktan gurur duyuyoruz.",
            ["loading"] = "Yükleniyor...",
            ["noMembers"] = "Ekip üyesi bulunamadı.",
            ["viewProfile"] = "Profili Görüntüle"
        },
        ["en"] = new()
        {
            ["pageTitle"] = "Our Team - DAF Law",
            ["pageTitleUpper"] = "Our Team",
            ["mainTitle"] = "Legal Staff",
            ["breadcrumbHome"] = "Home",
            ["breadcrumbTeam"] = "Our Team",
            ["teamInfoTitle"] = "Our Professional Team",
            ["teamInfoText"] = "Experienced lawyers and legal professionals, we take pride in delivering the highest standard of legal services to our clients.",
            ["loading"] = "Loading...",
            ["noMembers"] = "No team members found.",
            ["viewProfile"] = "View Profile"
        },
        ["ar"] = new()
        {
            ["pageTitle"] = "فريقنا - داف",
            ["pageTitleUpper"] = "فريقنا",
            ["mainTitle"] = "الفريق القانوني",
            ["breadcrumbHome"] = "الرئيسية",
            ["breadcrumbTeam"] = "فريقنا",
            ["teamInfoTitle"] = "فريقنا المحترف",
            ["teamInfoText"] = "محاميًا ومتخصصًا قانونيًا ذوي خبرة، نفخر بتقديم أعلى معايير الخدمات القانونية لعملائنا",
            ["loading"] = "جارٍ التحميل...",
            ["noMembers"] = "لا يوجد أعضاء.",
            ["viewProfile"] = "عرض الملف الشخصي"
        }
    };

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) &&
            Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];

        return Translations["tr"].GetValueOrDefault(key, key);
    }

    private string GetLawyerTitle(Lawyer lawyer) =>
        CurrentLang switch
        {
            "en" => lawyer.Title_EN ?? lawyer.Title_TR,
            "ar" => lawyer.Title_AR ?? lawyer.Title_TR,
            _ => lawyer.Title_TR
        };

    private string GetLocalizedMemberUrl(Lawyer lawyer)
    {
        var slug = CurrentLang switch
        {
            "en" => lawyer.Slug_EN,
            "ar" => lawyer.Slug_AR,
            _ => lawyer.Slug_TR
        };

        var basePath = CurrentLang == "tr" ? "ekibimiz" : "team";
        return LanguageService.GetLocalizedUrl($"{basePath}/{slug}");
    }
}