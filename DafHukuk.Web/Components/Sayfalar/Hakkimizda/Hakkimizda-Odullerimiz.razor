            ["mainHeader"] = "Başarımızın ölçüsünün müvekkillerimizin hakkımızdaki memnuniyeti olduğuna inanıyoruz.",
            ["mainText"] = "Bunun yanı sıra, kazandığımız uluslararası ödüller ve saygın uluslararası derecelendirme kuruluşları tarafından adımızın prestijli bir şekilde anılması da bizim için ayrıca değerli.",
            ["listTitle"] = "Geçmiş Ödüllerimizden Bazıları:"
        },
        ["en"] = new()
        {
            ["pageTitle"] = "Awards",
            ["companyName"] = "Daf Law Office",
            ["slogan"] = "Your <br> success. <br> Our <br> business.",
            ["home"] = "Home",
            ["about"] = "About Us",
            ["awards"] = "Awards",
            ["socialResponsibility"] = "Social Responsibility",
            ["mainHeader"] = "We believe that the measure of our success is the satisfaction of our clients about us.",
            ["mainText"] = "In addition, the international awards we have won and the prestigious mention of our name by respected international rating organizations are also valuable to us.",
            ["listTitle"] = "Some of Our Past Awards:"
        },
        ["ar"] = new()
        {
            ["pageTitle"] = "جوائزنا",
            ["companyName"] = "مكتب داف للمحاماة",
            ["slogan"] = "نجاحك <br> هو <br> عملنا",
            ["home"] = "الصفحة الرئيسية",
            ["about"] = "من نحن",
            ["awards"] = "جوائزنا",
            ["socialResponsibility"] = "المسؤولية الاجتماعية",
            ["mainHeader"] = "نعتقد أن مقياس نجاحنا هو رضا عملائنا عنا.",
            ["mainText"] = "بالإضافة إلى ذلك، فإن الجوائز الدولية التي فزنا بها والذكر المرموق لاسمنا من قبل المؤسسات التصنيفية الدولية المحترمة ذات قيمة بالنسبة لنا أيضًا.",
            ["listTitle"] = "بعض من جوائزنا السابقة:"
        }
    };

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];
        return key;
    }

    private string GetLocalizedUrl(string path)
    {
        return LanguageService.GetLocalizedUrl(path);
    }
}