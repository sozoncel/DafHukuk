@page "/hakkimizda/sosyal-sorumluluk"
@page "/en/about/social-responsibility"
@page "/ar/about/social-responsibility"
@layout DafHukuk.Web.Components.Layout.MainLayout
@inject ILanguageService LanguageService
@inject NavigationManager Navigation
@implements IDisposable

<section class="hero-about-section">
    <div class="hero-about-bg social-bg"></div>
    <div class="hero-about-overlay"></div>

    <div class="hero-about-container">
        <div class="hero-about-title-content">
            <h2 class="about-hero-title-upper">@GetText("pageTitle")</h2>
            <div class="hero-about-title-wrapper">
                <h1 class="hero-about-title">@GetText("companyName")</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="hero-about-slogan-wrapper">
                    <div class="hero-about-slogan-text-style">
                        @((MarkupString)GetText("slogan"))
                    </div>
                </div>
                <div class="hero-about-breadcrumb">
                    <a href="@GetLocalizedUrl("")">@GetText("home")</a> / <span>@GetText("about")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-about-sub-nav-bar">
        <div class="hero-about-sub-nav-container">
            <a role="button" href="@GetLocalizedUrl("hakkimizda")" class="button">@GetText("about")</a>
            <a role="button" href="@GetLocalizedUrl("hakkimizda/odullerimiz")" class="button">@GetText("awards")</a>
            <a role="button" href="@GetLocalizedUrl("hakkimizda/sosyal-sorumluluk")" class="button active">@GetText("socialResponsibility")</a>
        </div>
    </div>
</section>

<section class="about-social-section">
    <div class="row">
        <div class="social-main-header">
            <div class="col-lg-12">
                <h2>@GetText("mainHeader")</h2>
                <hr />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <h2 class="social-row-header">@GetText("projectsTitle")</h2>
        </div>
    </div>

    <div class="row social-project-row">
        <div class="col-lg-3">
            <img src="/img/sayfalar/hakkimizda/daf-sosyalsorumluluk-02.jpg" class="img-fluid" alt="social1" />
        </div>
        <div class="col-lg-6">
            <h2 class="social-row-header">
                @GetText("project1Title")
            </h2>
            <p>
                @GetText("project1Text")
            </p>
        </div>
        <div class="col-lg-3"></div>
    </div>

    <div class="row social-project-row">
        <div class="col-lg-3">
            <img src="/img/sayfalar/hakkimizda/daf-sosyalsorumluluk-01.jpg" class="img-fluid" alt="social1" />
        </div>
        <div class="col-lg-6">
            <h2 class="social-row-header">
                @GetText("project2Title")
            </h2>
            <p>
                @GetText("project2Text")
            </p>
        </div>
        <div class="col-lg-3"></div>
    </div>

    <div class="row social-project-row">
        <div class="col-lg-3">
            <img src="/img/sayfalar/hakkimizda/daf-sosyalsorumluluk-03.jpg" class="img-fluid" alt="social1" />
        </div>
        <div class="col-lg-6">
            <h2 class="social-row-header">
                @GetText("project3Title")
            </h2>
            <p>
                @GetText("project3Text")
            </p>
        </div>
        <div class="col-lg-3"></div>
    </div>
</section>

@code {
    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

