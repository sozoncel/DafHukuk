@page "/iletisim"
@page "/en/contact"
@page "/ar/contact"
@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject DafHukuk.Service.ILanguageService LanguageService

<PageTitle>@GetText("pageTitle")</PageTitle>

<section class="hero-iletisim-section">
    <div class="hero-iletisim-bg"></div>
    <div class="hero-iletisim-overlay"></div>

    <div class="hero-iletisim-container">
        <div class="hero-iletisim-title-content">
            <h2 class="iletisim-hero-title-upper">@GetText("pageTitle")</h2>

            <div class="hero-iletisim-title-wrapper">
                <h1 class="hero-iletisim-title">@GetText("mainTitle")</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="hero-iletisim-slogan-wrapper">
                    <div class="hero-iletisim-slogan-text-style">
                        @((MarkupString)GetText("slogan"))
                    </div>
                </div>

                <div class="hero-iletisim-breadcrumb">
                    <a href="@LanguageService.GetLocalizedUrl("/")">@GetText("breadcrumbHome")</a> / <span>@GetText("breadcrumbContact")</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="iletisim-icerik">
    <div class="row">
        <div class="col-lg-6">
            <div class="iletisim-card">
                <div class="iletisim-card-inner">

                    <div class="iletisim-card-top row-card">
                        <div class="col-sm-6 foto-col">
                            <img src="img/sayfalar/iletisim/daf-iletisim-01.png" alt="@GetText("officeName")" class="ofis-img" />
                            <a class="link-no-deco haritada-goster" href="@GetText("mapLink")" target="_blank" rel="noopener">
                                @GetText("showOnMap")
                                <span class="link-external-icon" aria-hidden="true">↗</span>
                            </a>
                        </div>

                        <div class="col-sm-6 meta-col">
                            <p class="ust-baslik">@GetText("officeUpperTitle")</p>
                            <h5 class="ofis-title">@GetText("officeName")</h5>
                            <span class="ofis-line">@GetText("officeAddressLine1")</span>
                            <span class="ofis-line">@GetText("officeAddressLine2")</span>

                            <p class="alt-bilgi">
                                @GetText("officeHours")
                            </p>
                        </div>
                    </div>

                    <hr class="sep" />

                    <div class="iletisim-card-contact row-card2">
                        <h6 class="small-heading">@GetText("generalInquiries")</h6>

                        <div class="contact-line">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <div class="contact-meta">
                                <div class="contact-label">@GetText("emailLabel")</div>
                                <div class="contact-value">@GetText("emailValue")</div>
                            </div>
                        </div>

                        <div class="contact-line">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                            <div class="contact-meta">
                                <div class="contact-label">@GetText("phoneLabel")</div>
                                <div class="contact-value">@GetText("phoneValue")</div>
                            </div>
                        </div>
                    </div>

                    <hr class="sep" />

                    <div class="row-card3">
                        <p>
                            @((MarkupString)GetText("careerText"))
                        </p>

                        <a class="linkedin-btn" href="@GetText("linkedinLink")" target="_blank" rel="noopener">
                            <span class="ln-icon" aria-hidden="true">in</span> LinkedIn
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="contact-form">
                <div class="form-header">
                    <div class="form-tag">@GetText("formTag")</div>
                    <p class="form-intro">@GetText("formIntro")</p>
                </div>

                <form id="contactForm" onsubmit="return handleContactSubmit(event)" novalidate>
                    <div class="form-row">
                        <input type="text" name="ad" placeholder="@GetText("namePlaceholder")" required />
                        <input type="text" name="soyad" placeholder="@GetText("surnamePlaceholder")" required />
                    </div>

                    <div class="form-row">
                        <input type="text" name="sirket" placeholder="@GetText("companyPlaceholder")" />
                        <input type="text" name="pozisyon" placeholder="@GetText("positionPlaceholder")" />
                    </div>

                    <div class="form-row">
                        <input type="email" name="email" placeholder="@GetText("emailPlaceholder")" required />
                        <input type="tel" name="telefon" placeholder="@GetText("phonePlaceholder")" />
                    </div>

                    <div class="form-row single">
                        <textarea name="konu" rows="6" placeholder="@GetText("messagePlaceholder")"></textarea>
                    </div>

                    <div class="form-row checkbox-row">
                        <label class="checkbox-inline">
                            <input type="checkbox" name="kvkk" required />
                            <span>@GetText("kvkkText")</span>
                        </label>
                    </div>

                    <div class="form-row">
                        <button type="submit" class="btn-send">@GetText("sendButton")</button>
                    </div>

                    <p class="form-note">@GetText("formNote")</p>
                </form>
            </div>
        </div>
    </div>

    <div class="row-google-map">
        <div class="col-lg-12">

            <div class="mapouter">
                <div class="gmap_canvas">
                    <iframe class="gmap_iframe"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            src="@GetText("mapEmbedSrc")">
                    </iframe>
                </div>

                <style>
                </style>
            </div>
        </div>
    </div>
</section>

<script>
    function handleContactSubmit(e) {
        e.preventDefault();
        const form = document.getElementById('contactForm');
        const required = form.querySelectorAll('[required]');
        let ok = true;

        required.forEach(r => {
            if (r.name !== 'sirket' && r.name !== 'pozisyon' && r.name !== 'telefon') { 
                if (!r.value || (r.type === 'checkbox' && !r.checked)) ok = false;
            }
        });

        if (!ok) {
            alert('@GetText("formValidationAlert")');
            return false;
        }

        alert('@GetText("formSentAlert")');
        form.reset();
        return false;
    }
</script>


