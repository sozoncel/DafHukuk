@page "/iletisim"
@page "/en/contact"
@page "/ar/contact"
@using System.ComponentModel.DataAnnotations
@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject DafHukuk.Service.ILanguageService LanguageService
@inject DafHukuk.Service.IEmailService EmailService

<PageTitle>@GetText("pageTitle")</PageTitle>

<section class="hero-iletisim-section">
    <div class="hero-iletisim-bg"></div>
    <div class="hero-iletisim-overlay"></div>

    <div class="hero-iletisim-container">
        <div class="hero-iletisim-title-content">
            <h2 class="iletisim-hero-title-upper">@GetText("pageTitle")</h2>

            <div class="hero-iletisim-title-wrapper">
                <h1 class="hero-iletisim-title">@GetText("mainTitle")</h1>
            </div>
        </div>
    </div>
</section>

<section class="iletisim-icerik">
    <div class="row">
        <div class="col-lg-6">
            <div class="iletisim-card">
                <div class="iletisim-card-inner">

                    <div class="iletisim-card-top row-card">
                        <div class="col-sm-6 foto-col">
                            <img src="/img/Ofis Genel/11.jpeg" alt="@GetText("officeName")" class="ofis-img" />
                            <a class="link-no-deco haritada-goster" href="@GetText("mapLink")" target="_blank" rel="noopener">
                                @GetText("showOnMap")
                                <span class="link-external-icon" aria-hidden="true">↗</span>
                            </a>
                        </div>

                        <div class="col-sm-6 meta-col">
                            <p class="ust-baslik">@GetText("officeUpperTitle")</p>
                            <h5 class="ofis-title">@GetText("officeName")</h5>
                            <span class="ofis-line">@GetText("officeAddressLine1")</span>
                            <span class="ofis-line">@GetText("officeAddressLine2")</span>
                            <span class="ofis-line">@GetText("officeAddressLine3")</span>

                            <div class="ofis-hours-wrapper">
                                <p class="hours-title">@GetText("hoursTitle")</p>
                                <div class="hours-line">
                                    <span class="hours-label">@GetText("weekdaysLabel")</span>
                                    <span class="hours-value">@GetText("weekdaysValue")</span>
                                </div>
                                <div class="hours-line">
                                    <span class="hours-label">@GetText("weekendLabel")</span>
                                    <span class="hours-value">@GetText("weekendValue")</span>
                                </div>
                                <div class="hours-line">
                                    <span class="hours-label">@GetText("sundayLabel")</span>
                                    <span class="hours-value hours-closed">@GetText("sundayValue")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="sep" />

                    <div class="iletisim-card-contact row-card2">
                        <h6 class="small-heading">@GetText("generalInquiries")</h6>

                        <div class="contact-line">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <div class="contact-meta">
                                <div class="contact-label">@GetText("emailLabel")</div>
                                <div class="contact-value">@GetText("emailValue")</div>
                            </div>
                        </div>

                        <div class="contact-line">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                            <div class="contact-meta">
                                <div class="contact-label">@GetText("phoneLabel")</div>
                                <div class="contact-value">@GetText("phoneValue")</div>
                            </div>
                        </div>
                    </div>

                    <hr class="sep" />
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="contact-form">
                <div class="form-header">
                    <div class="form-tag">@GetText("formTag")</div>
                    <p class="form-intro">@GetText("formIntro")</p>
                </div>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")" role="alert">
                        @statusMessage
                    </div>
                }

                <EditForm Model="@contactForm" OnValidSubmit="@HandleSubmit" FormName="contactForm">
                    <DataAnnotationsValidator />

                    <div class="form-row">
                        <InputText @bind-Value="contactForm.FirstName" placeholder="@GetText("namePlaceholder")" class="form-control" />
                        <InputText @bind-Value="contactForm.LastName" placeholder="@GetText("surnamePlaceholder")" class="form-control" />
                    </div>

                    <div class="form-row">
                        <InputText @bind-Value="contactForm.Company" placeholder="@GetText("companyPlaceholder")" class="form-control" />
                        <InputText @bind-Value="contactForm.Position" placeholder="@GetText("positionPlaceholder")" class="form-control" />
                    </div>

                    <div class="form-row">
                        <InputText @bind-Value="contactForm.Email" type="email" placeholder="@GetText("emailPlaceholder")" class="form-control" />
                        <InputText @bind-Value="contactForm.Phone" type="tel" placeholder="@GetText("phonePlaceholder")" class="form-control" />
                    </div>

                    <div class="form-row single">
                        <InputTextArea @bind-Value="contactForm.Message" rows="6" placeholder="@GetText("messagePlaceholder")" class="form-control" />
                    </div>

                    <div class="form-row checkbox-row">
                        <label class="checkbox-inline">
                            <InputCheckbox @bind-Value="contactForm.KvkkAccepted" />
                            <span>@GetText("kvkkText")</span>
                        </label>
                        <ValidationMessage For="@(() => contactForm.KvkkAccepted)" />
                    </div>

                    <div class="form-row">
                        <button type="submit" class="btn-send" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span>@GetText("sending")</span>
                            }
                            else
                            {
                                <span>@GetText("sendButton")</span>
                            }
                        </button>
                    </div>

                    <p class="form-note">@GetText("formNote")</p>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="row-google-map">
        <div class="col-lg-12">
            <div class="mapouter">
                <div class="gmap_canvas">
                    <iframe class="gmap_iframe"
                            frameborder="0"
                            scrolling="no"
                            marginheight="0"
                            marginwidth="0"
                            src="@GetText("mapEmbedSrc")">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>

