    private string CurrentLang => LanguageService.GetCurrentLanguage();



    private async Task HandleSubmit()
    {
        if (!contactForm.KvkkAccepted)
        {
            statusMessage = GetText("errorMessage");
            isSuccess = false;
            return;
        }

        isSubmitting = true;
        statusMessage = "";

        try
        {
            bool result = await EmailService.SendContactFormEmail(
                contactForm.FirstName,
                contactForm.LastName,
                contactForm.Email,
                contactForm.Phone ?? "",
                contactForm.Company ?? "",
                contactForm.Position ?? "",
                contactForm.Message ?? ""
            );

            if (result)
            {
                statusMessage = GetText("successMessage");
                isSuccess = true;
                contactForm = new ContactFormModel(); // Formu temizle
            }
            else
            {
                statusMessage = GetText("errorMessage");
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = GetText("errorMessage");
            isSuccess = false;
            Console.WriteLine($"Form gönderim hatası: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];

        if (Translations["tr"].ContainsKey(key))
            return Translations["tr"][key];

        return key;
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Ad zorunludur")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Soyad zorunludur")]
        public string LastName { get; set; } = "";

        public string? Company { get; set; }
        public string? Position { get; set; }

        [Required(ErrorMessage = "E-posta zorunludur")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta adresi girin")]
        public string Email { get; set; } = "";

        public string? Phone { get; set; }
        public string? Message { get; set; }

        [MustBeTrue(ErrorMessage = "KVKK metnini kabul etmelisiniz")]
        public bool KvkkAccepted { get; set; }
    }

    public class MustBeTrueAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value)
        {
            return value is bool b && b;
        }
    }
