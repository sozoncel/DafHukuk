@page "/cozum-ortaklari"
@page "/en/partners"
@page "/ar/partners"
@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@using DafHukuk.Service.Interfaces

@inject ISolutionPartnerService PartnerService
@inject DafHukuk.Service.ILanguageService LanguageService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@GetText("pageTitle")</PageTitle>

<section class="modern-partners-hero">
    <div class="hero-animated-background"></div>
    <div class="hero-gradient-overlay"></div>

    <div class="hero-partners-container">
        <div class="hero-partners-inner">
            <span class="partners-badge-modern">@GetText("pageTitleUpper")</span>
            <h1 class="partners-main-title">
                <span class="title-gradient">@GetText("mainTitle")</span>
            </h1>
            <div class="partners-breadcrumb">
                <a href="@LanguageService.GetLocalizedUrl("/")" class="breadcrumb-link">@GetText("breadcrumbHome")</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-active">@GetText("breadcrumbPartners")</span>
            </div>
        </div>
    </div>
</section>

<section class="partners-main-section">
    <div class="partners-content-wrapper">

        <div class="partners-intro-section">
            <div class="intro-content-box">
                <h2 class="intro-subtitle">@GetText("partnershipTitle")</h2>
                <p class="intro-description">@GetText("partnersInfoText")</p>
            </div>
        </div>

        @if (Partners == null)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p class="loading-text">@GetText("loading")</p>
            </div>
        }
        else if (Partners.Count == 0)
        {
            <div class="empty-container">
                <i class="bi bi-building"></i>
                <p class="empty-text">@GetText("noPartners")</p>
            </div>
        }
        else
        {
            <div class="partners-grid">
                @foreach (var partner in Partners)
                {
                    <a href="@GetLocalizedPartnerUrl(partner)" class="partner-card-modern">
                        <div class="partner-card-inner">
                            <div class="partner-logo-section">
                                <div class="logo-background-pattern"></div>
                                <div class="image-overlay-cozum"></div>
                                <img src="@(string.IsNullOrEmpty(partner.ImageUrl) ? "/img/placeholder.jpg" : partner.ImageUrl)"
                                     alt="@partner.Name"
                                     class="partner-logo-img" />
                                <div class="partner-hover-info">
                                    <span class="view-details-text">@GetText("viewDetails")</span>
                                    <i class="bi bi-arrow-right"></i>
                                </div>
                            </div>

                            <div class="partner-info-section">
                                <h3 class="partner-name">@partner.Name</h3>
                                <p class="partner-desc">@GetPartnerDescription(partner)</p>
                                <div class="partner-card-divider"></div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<SolutionPartner>? Partners { get; set; }
    private string CurrentLang => LanguageService.GetCurrentLanguage();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Partners = await PartnerService.GetAll();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["pageTitle"] = "Çözüm Ortaklarımız - DAF Hukuk ve Danışmanlık",
            ["pageTitleUpper"] = "Çözüm Ortaklarımız",
            ["mainTitle"] = "İş Birliği Yaptığımız Kurumlar",
            ["breadcrumbHome"] = "Ana Sayfa",
            ["breadcrumbPartners"] = "Çözüm Ortaklarımız",
            ["partnershipTitle"] = "Güvenilir İş Ortaklıkları",
            ["partnersInfoText"] = "Müvekkillerimize en iyi hizmeti sunmak için güvenilir çözüm ortaklarımızla stratejik iş birlikleri geliştiriyoruz.",
            ["loading"] = "Yükleniyor...",
            ["noPartners"] = "Henüz ortak eklenmedi.",
            ["viewDetails"] = "Detayları Görüntüle"
        },
        ["en"] = new()
        {
            ["pageTitle"] = "Our Partners - DAF Law",
            ["pageTitleUpper"] = "Our Partners",
            ["mainTitle"] = "Trusted Business Partners",
            ["breadcrumbHome"] = "Home",
            ["breadcrumbPartners"] = "Our Partners",
            ["partnershipTitle"] = "Trusted Partnerships",
            ["partnersInfoText"] = "We develop strategic partnerships with trusted solution partners to provide the best service to our clients.",
            ["loading"] = "Loading...",
            ["noPartners"] = "No partners added yet.",
            ["viewDetails"] = "View Details"
        },
        ["ar"] = new()
        {
            ["pageTitle"] = "شركاؤنا - داف",
            ["pageTitleUpper"] = "شركاؤنا",
            ["mainTitle"] = "شركاء الأعمال الموثوقون",
            ["breadcrumbHome"] = "الرئيسية",
            ["breadcrumbPartners"] = "شركاؤنا",
            ["partnershipTitle"] = "شراكات موثوقة",
            ["partnersInfoText"] = "نقوم بتطوير شراكات استراتيجية مع شركاء حلول موثوقين لتقديم أفضل خدمة لعملائنا.",
            ["loading"] = "جارٍ التحميل...",
            ["noPartners"] = "لا يوجد شركاء بعد.",
            ["viewDetails"] = "عرض التفاصيل"
        }
    };

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];
        return Translations["tr"].GetValueOrDefault(key, key);
    }

    private string GetPartnerDescription(SolutionPartner partner)
    {
        var desc = CurrentLang switch
        {
            "en" => partner.Description_EN ?? partner.Description_TR,
            "ar" => partner.Description_AR ?? partner.Description_TR,
            _ => partner.Description_TR
        };

        if (string.IsNullOrWhiteSpace(desc)) return "";
        return desc.Length > 120 ? desc.Substring(0, 120) + "..." : desc;
    }

    private string GetLocalizedPartnerUrl(SolutionPartner partner)
    {
        var slug = CurrentLang switch
        {
            "en" => partner.Slug_EN,
            "ar" => partner.Slug_AR,
            _ => partner.Slug_TR
        };

        var basePath = CurrentLang == "tr" ? "cozum-ortaklari" : "partners";
        return LanguageService.GetLocalizedUrl($"{basePath}/{slug}");
    }
}