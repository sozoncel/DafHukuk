@page "/cozum-ortaklari/{slug}"
@page "/en/partners/{slug}"
@page "/ar/partners/{slug}"
@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@using DafHukuk.Core.Entities
@using DafHukuk.Service.Interfaces

@inject ISolutionPartnerService PartnerService
@inject IPostService PostService
@inject ICategoryService CategoryService
@inject DafHukuk.Service.ILanguageService LanguageService
@inject NavigationManager NavManager

@if (Partner == null)
{
    <PageTitle>@GetText("loadingTitle")</PageTitle>
    <section class="loading-full-page">
        <div class="spinner-large"></div>
        <h2 class="loading-title">@GetText("loading")</h2>
    </section>
}
else
{
    <PageTitle>@Partner.Name - @GetText("pageTitle")</PageTitle>

    <section class="partner-hero-detail">
        <div class="hero-detail-pattern"></div>
        <div class="partner-hero-grid">
            <div class="partner-logo-area">
                <div class="logo-frame-wrapper">
                    <div class="logo-frame-decoration"></div>
                    <img src="@(string.IsNullOrEmpty(Partner.ImageUrl) ? "/img/placeholder.jpg" : Partner.ImageUrl)"
                         alt="@Partner.Name"
                         class="partner-hero-logo" />
                </div>
            </div>

            <div class="partner-hero-info">
                <div class="hero-info-content">
                    <div class="partner-badge">@GetText("solutionPartner")</div>
                    <h1 class="partner-hero-name">@Partner.Name</h1>
                    <div class="partner-hero-divider"></div>
                    <p class="partner-hero-desc">@GetPartnerDescription(Partner)</p>

                    @if (!string.IsNullOrWhiteSpace(Partner.WebsiteUrl))
                    {
                        <a href="@Partner.WebsiteUrl" target="_blank" rel="noopener" class="partner-website-button">
                            <i class="bi bi-globe"></i>
                            <span>@GetText("visitWebsite")</span>
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="partner-about-section">
        <div class="partner-about-wrapper">
            <div class="about-inner-content">
                <div class="about-section-header">
                    <span class="about-section-badge">@GetText("overview")</span>
                    <h2 class="about-section-title">@GetText("aboutPartner")</h2>
                </div>
                <div class="about-section-text">
                    <p>@GetPartnerFullDescription(Partner)</p>
                </div>
            </div>
        </div>
    </section>

    @if (relatedPosts.Any() || servicePosts.Any())
    {
        <section class="partner-related-content">
            <div class="related-content-wrapper">
                <div class="related-section-header">
                    <span class="related-section-badge">@GetText("contentBadge")</span>
                    <h2 class="related-section-title">@GetText("relatedContentHeading")</h2>
                </div>

                <div class="related-tabs-container">
                    <button class="@(CurrentFilterCategory == 0 ? "related-tab active" : "related-tab")"
                            @onclick="() => FilterCategory(0)">
                        <span>@GetText("showAll")</span>
                    </button>

                    @if (servicePosts.Any())
                    {
                        <button class="@(CurrentFilterCategory == -1 ? "related-tab active" : "related-tab")"
                                @onclick="() => FilterCategory(-1)">
                            <span>@GetText("servicesHeading")</span>
                        </button>
                    }

                    @foreach (var cat in distinctCategories)
                    {
                        <button class="@(CurrentFilterCategory == cat.Id ? "related-tab active" : "related-tab")"
                                @onclick="() => FilterCategory(cat.Id)">
                            <span>@GetCategoryName(cat)</span>
                        </button>
                    }
                </div>

                <div class="related-posts-grid">
                    @if (!GetDisplayedRelatedPosts().Any())
                    {
                        <div class="empty-posts-state">
                            <i class="bi bi-inbox"></i>
                            <p>@GetText("noContentMessage")</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var p in GetDisplayedRelatedPosts())
                        {
                            var url = GetPostUrl(p);
                            var categoryName = GetCategoryName(p.Category);

                            <a href="@LanguageService.GetLocalizedUrl(url)" class="related-post-card">
                                <div class="post-card-image-wrapper">
                                    <img src="@(string.IsNullOrEmpty(p.CoverImageUrl) ? "/img/placeholder.jpg" : p.CoverImageUrl)"
                                         alt="@GetPostTitle(p)"
                                         class="post-card-image" />
                                    <div class="post-card-overlay"></div>
                                </div>
                                <div class="post-card-content">
                                    <span class="post-card-date">
                                        <i class="bi bi-calendar3"></i>
                                        @p.PublishedDate.ToString("dd MMM yyyy", GetCulture())
                                    </span>
                                    <h3 class="post-card-title">@GetPostTitle(p)</h3>
                                    <span class="post-category-tag" data-category="@categoryName">@categoryName</span>
                                </div>
                            </a>
                        }
                    }
                </div>

                @if (GetDisplayedRelatedPosts().Count() < FilteredPosts.Count() && !ShowingAll && FilteredPosts.Any())
                {
                    <div class="load-more-wrapper">
                        <button class="load-more-button" @onclick="ShowAll">
                            <span>@GetText("showAll")</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private SolutionPartner? Partner;
    private List<Post> relatedPosts = new();
    private List<Post> FilteredPosts = new();
    private List<Post> servicePosts = new();
    private List<Category> distinctCategories = new();
    private int CurrentFilterCategory = 0;
    private bool ShowingAll = false;
    private int InitialDisplayCount = 8;

    private string CurrentLang => LanguageService.GetCurrentLanguage();

    private Dictionary<string, Dictionary<string, string>> Translations = new()
    {
        ["tr"] = new()
        {
            ["pageTitle"] = "DAF Hukuk ve Danışmanlık",
            ["loadingTitle"] = "Yükleniyor...",
            ["loading"] = "Ortak bilgileri yükleniyor...",
            ["solutionPartner"] = "Çözüm Ortağı",
            ["visitWebsite"] = "Web Sitesini Ziyaret Et",
            ["overview"] = "Genel Bakış",
            ["aboutPartner"] = "Ortak Hakkında",
            ["servicesHeading"] = "Hizmetlerimiz",
            ["contentBadge"] = "İçerikler",
            ["relatedContentHeading"] = "İlişkili İçerikler",
            ["showAll"] = "Tümünü Göster",
            ["noContentMessage"] = "Bu kategoride içerik bulunmamaktadır."
        },
        ["en"] = new()
        {
            ["pageTitle"] = "DAF Law",
            ["loadingTitle"] = "Loading...",
            ["loading"] = "Loading partner information...",
            ["solutionPartner"] = "Solution Partner",
            ["visitWebsite"] = "Visit Website",
            ["overview"] = "Overview",
            ["aboutPartner"] = "About Partner",
            ["servicesHeading"] = "Our Services",
            ["contentBadge"] = "Content",
            ["relatedContentHeading"] = "Related Content",
            ["showAll"] = "Show All",
            ["noContentMessage"] = "No content found in this category."
        },
        ["ar"] = new()
        {
            ["pageTitle"] = "داف للمحاماة",
            ["loadingTitle"] = "جار التحميل...",
            ["loading"] = "جار تحميل معلومات الشريك...",
            ["solutionPartner"] = "شريك الحلول",
            ["visitWebsite"] = "زيارة الموقع",
            ["overview"] = "نظرة عامة",
            ["aboutPartner"] = "حول الشريك",
            ["servicesHeading"] = "خدماتنا",
            ["contentBadge"] = "المحتوى",
            ["relatedContentHeading"] = "المحتوى ذو الصلة",
            ["showAll"] = "عرض الكل",
            ["noContentMessage"] = "لم يتم العثور على محتوى في هذه الفئة."
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Partner = await GetPartnerBySlug(Slug, CurrentLang);

        if (Partner == null)
        {
            NavManager.NavigateTo(LanguageService.GetLocalizedUrl("NotFound"), replace: true);
            return;
        }

        var allPosts = await PostService.GetAll();
        var categories = await CategoryService.GetAll();
        var serviceCategory = categories.FirstOrDefault(c =>
            string.Equals(c.Name_TR?.Trim(), "Hizmetlerimiz", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(c.Name_EN?.Trim(), "Our Services", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(c.Name_AR?.Trim(), "خدماتنا", StringComparison.OrdinalIgnoreCase)
        );

        if (serviceCategory != null)
        {
            servicePosts = allPosts
                .Where(p => p.CategoryId == serviceCategory.Id &&
                           p.IsActive &&
                           HasContentInCurrentLanguage(p)) 
                .OrderBy(p => GetPostTitle(p))
                .ToList();
        }

        relatedPosts = allPosts
            .Where(p => p.Category != null
                && !p.Category.Name_TR.Equals("Hizmetlerimiz", StringComparison.OrdinalIgnoreCase)
                && p.IsActive
                && HasContentInCurrentLanguage(p)) 
            .OrderByDescending(p => p.PublishedDate)
            .ToList();

        distinctCategories = relatedPosts
            .Select(p => p.Category!)
            .DistinctBy(c => c.Id)
            .OrderBy(c => GetCategoryName(c))
            .ToList();

        FilteredPosts = relatedPosts.Concat(servicePosts).ToList();
    }

    
    private bool HasContentInCurrentLanguage(Post post)
    {
        return CurrentLang switch
        {
            "en" => !string.IsNullOrWhiteSpace(post.Title_EN) && !string.IsNullOrWhiteSpace(post.Content_EN),
            "ar" => !string.IsNullOrWhiteSpace(post.Title_AR) && !string.IsNullOrWhiteSpace(post.Content_AR),
            _ => !string.IsNullOrWhiteSpace(post.Title_TR) && !string.IsNullOrWhiteSpace(post.Content_TR)
        };
    }

    private async Task<SolutionPartner?> GetPartnerBySlug(string? slug, string lang)
    {
        if (string.IsNullOrWhiteSpace(slug)) return null;

        var allPartners = await PartnerService.GetAll();
        var lowerSlug = slug.ToLower();

        return lang switch
        {
            "en" => allPartners.FirstOrDefault(p => p.Slug_EN != null && p.Slug_EN.ToLower() == lowerSlug),
            "ar" => allPartners.FirstOrDefault(p => p.Slug_AR != null && p.Slug_AR.ToLower() == lowerSlug),
            _ => allPartners.FirstOrDefault(p => p.Slug_TR != null && p.Slug_TR.ToLower() == lowerSlug)
        };
    }

    private void FilterCategory(int categoryId)
    {
        CurrentFilterCategory = categoryId;
        ShowingAll = false;

        if (categoryId == -1)
        {
            FilteredPosts = servicePosts;
        }
        else if (categoryId == 0)
        {
            FilteredPosts = relatedPosts.Concat(servicePosts).ToList();
        }
        else
        {
            FilteredPosts = relatedPosts.Where(p => p.CategoryId == categoryId).ToList();
        }
    }

    private void ShowAll()
    {
        ShowingAll = true;
    }

    private List<Post> GetDisplayedRelatedPosts()
    {
        if (ShowingAll)
        {
            return FilteredPosts;
        }
        else
        {
            return FilteredPosts.Take(InitialDisplayCount).ToList();
        }
    }

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];
        return key;
    }

    private string GetPartnerDescription(SolutionPartner partner)
    {
        var desc = CurrentLang switch
        {
            "en" => partner.Description_EN ?? partner.Description_TR,
            "ar" => partner.Description_AR ?? partner.Description_TR,
            _ => partner.Description_TR
        };

        if (string.IsNullOrWhiteSpace(desc)) return "";
        return desc.Length > 200 ? desc.Substring(0, 200) + "..." : desc;
    }

    private string GetPartnerFullDescription(SolutionPartner partner)
    {
        return CurrentLang switch
        {
            "en" => partner.Description_EN ?? partner.Description_TR ?? GetText("noContentMessage"),
            "ar" => partner.Description_AR ?? partner.Description_TR ?? GetText("noContentMessage"),
            _ => partner.Description_TR ?? GetText("noContentMessage")
        };
    }

    private string GetPostTitle(Post p)
    {
        return CurrentLang switch
        {
            "en" => p.Title_EN ?? p.Title_TR,
            "ar" => p.Title_AR ?? p.Title_TR,
            _ => p.Title_TR ?? ""
        };
    }

    private string GetCategoryName(Category? c)
    {
        if (c == null) return "";
        return CurrentLang switch
        {
            "en" => c.Name_EN ?? c.Name_TR,
            "ar" => c.Name_AR ?? c.Name_TR,
            _ => c.Name_TR ?? ""
        };
    }

    private string GetPostUrl(Post p)
    {
        if (p?.Category?.Name_TR == null) return "#";

        var categorySlug = p.Category.Name_TR.ToLowerInvariant() switch
        {
            "hizmetlerimiz" => CurrentLang == "en" ? "services" : CurrentLang == "ar" ? "services" : "hizmetlerimiz",
            "duyurular" => CurrentLang == "en" ? "announcements" : CurrentLang == "ar" ? "announcements" : "duyurular",
            "etkinlikler" => CurrentLang == "en" ? "events" : CurrentLang == "ar" ? "events" : "etkinlikler",
            "yayınlar" or "yayinlar" => CurrentLang == "en" ? "publications" : CurrentLang == "ar" ? "publications" : "yayinlar",
            _ => CurrentLang == "en" ? "publications" : CurrentLang == "ar" ? "publications" : "yayinlar"
        };

        var postSlug = CurrentLang switch
        {
            "en" => p.Slug_EN ?? p.Slug_TR,
            "ar" => p.Slug_AR ?? p.Slug_TR,
            _ => p.Slug_TR
        };

        return CurrentLang switch
        {
            "en" => $"/en/{categorySlug}/{postSlug}",
            "ar" => $"/ar/{categorySlug}/{postSlug}",
            _ => $"/{categorySlug}/{postSlug}"
        };
    }

    private System.Globalization.CultureInfo GetCulture()
    {
        return CurrentLang switch
        {
            "en" => new System.Globalization.CultureInfo("en-US"),
            "ar" => new System.Globalization.CultureInfo("ar-SA"),
            _ => new System.Globalization.CultureInfo("tr-TR")
        };
    }
}