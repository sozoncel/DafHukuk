    private string CurrentLang => LanguageService.GetCurrentLanguage();

    // Metinleri mevcut dile göre döndüren yardımcı metod
    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];

        // Varsayılan olarak Türkçe metni döndür (veya anahtarı)
        return Translations["tr"].ContainsKey(key) ? Translations["tr"][key] : key;
    }

    protected override void OnInitialized()
    {
        // Tarayıcının mevcut dilini (CurrentLang) sunucuya bildirerek Culture ayarını yapma veya yönlendirme mantığı burada olmalı.
        // Mevcut yapınızda bu LanguageRedirect.razor veya Program.cs içerisinde ele alınmış gibi görünüyor.
        // Blazor Server/Interactive rendering kullandığınız için JS fonksiyonunu burada tetiklemeye gerek yoktur.
    }
}


@* Sekme değiştirme JavaScript kodu aynı kalacaktır *@
<script>
    function showTab(id) {
        document.querySelectorAll(".tab-content").forEach(el => el.classList.add("hidden"));
        document.getElementById(id).classList.remove("hidden");

        document.querySelectorAll(".kariyer-sub-nav-bar .button")
            .forEach(btn => btn.classList.remove("active"));

        // Event nesnesini kontrol et
        const event = window.event;
        if (event && event.target) {
             event.target.classList.add("active");
        } else {
            // Eğer event yoksa, id ile eşleşen butonu bulup aktif yap (Blazor yaşam döngüsü dışında çağrılabilir)
            const buttons = document.querySelectorAll(".kariyer-sub-nav-bar .button");
            buttons.forEach(btn => {
                if (btn.textContent.includes(id === 'kariyer' ? '@GetText("tabCareerAtDaf")' : '@GetText("tabGeneralApplication")')) {
                    btn.classList.add("active");
                }
            });
        }
    }

    // İlk yüklemede doğru sekmeyi aktif yap
    document.addEventListener("DOMContentLoaded", () => {
        const kariyerButton = document.querySelector(".kariyer-sub-nav-bar .button:first-child");
        if (kariyerButton) {
             kariyerButton.classList.add("active");
        }
    });

</script>