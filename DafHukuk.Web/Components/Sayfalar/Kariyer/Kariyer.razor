@page "/kariyer"
@page "/en/career"
@page "/ar/career"
@layout DafHukuk.Web.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject DafHukuk.Service.ILanguageService LanguageService
@inject NavigationManager Navigation

<PageTitle>@GetText("pageTitle")</PageTitle>

<section class="hero-kariyer-section">

    <div class="hero-kariyer-bg"></div>
    <div class="hero-kariyer-overlay"></div>

    <div class="hero-kariyer-container">

        <div class="hero-kariyer-title-content">
            <h2 class="kariyer-hero-title-upper">@GetText("upperTitle")</h2>

            <div class="hero-kariyer-title-wrapper">
                <h1 class="hero-kariyer-title">@GetText("mainTitle")</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">

                <div class="hero-kariyer-slogan-wrapper">
                    <div class="hero-kariyer-slogan-text-style">
                        @((MarkupString)GetText("slogan"))
                    </div>
                </div>

                <div class="hero-kariyer-breadcrumb">
                    <a href="@LanguageService.GetLocalizedUrl("/")">@GetText("breadcrumbHome")</a> / <span>@GetText("breadcrumbCareer")</span>
                </div>

            </div>
        </div>

    </div>

</section>


<section class="kariyer-sub-nav-bar">
    <div class="kariyer-sub-nav-container">
        <button class="button active" onclick="showTab('kariyer')">@GetText("tabCareerAtDaf")</button>
        <button class="button" onclick="showTab('pozisyon')">@GetText("tabGeneralApplication")</button>
    </div>
</section>



<section class="kariyer-icerik">

    <div class="tab-content" id="kariyer">

        <div class="row">
            <div class="col-lg-6">
                <span>
                    @GetText("careerIntroSpan")
                </span>

                <p>
                    @GetText("careerIntroP")
                </p>
            </div>

            <div class="col-lg-6">

                <a href="#" class="apply-btn">
                    <i class="linkedin-icon"></i> @GetText("joinOurTeam")
                </a>

                <div class="kariyer-card">
                    <div class="card-body">
                        <h5 class="card-title">@GetText("jobTitleFinance")</h5>
                        <h6 class="card-subtitle">@GetText("jobSummaryText")</h6>
                        <p class="card-text">@GetText("jobDetailsFinance")</p>

                        <a href="#" class="card-link underline-anim">
                            @GetText("easyApply")
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>



    <div class="tab-content hidden" id="pozisyon">

        <div class="row positions-row">

            <div class="col-sm-3">
                <div class="position-card">
                    <a href="#"><h5>@GetText("posLawyer")</h5></a>
                    <a href="#" class="underline-anim small-link">@GetText("viewDetails")</a>
                </div>
            </div>

            <div class="col-sm-3">
                <div class="position-card">
                    <a href="#"><h5>@GetText("posSupportTeam")</h5></a>
                    <a href="#" class="underline-anim small-link">@GetText("viewDetails")</a>
                </div>
            </div>

            <div class="col-sm-3">
                <div class="position-card">
                    <a href="#"><h5>@GetText("posLegalIntern")</h5></a>
                    <a href="#" class="underline-anim small-link">@GetText("viewDetails")</a>
                </div>
            </div>

            <div class="col-sm-3">
                <div class="position-card">
                    <a href="#"><h5>@GetText("posSummerIntern")</h5></a>
                    <a href="#" class="underline-anim small-link">@GetText("viewDetails")</a>
                </div>
            </div>

        </div>


        <div class="row">
            <div class="col-lg-4">

                <a href="#" class="apply-btn">
                    <i class="linkedin-icon"></i> @GetText("joinOurTeam")
                </a>

                <div class="kariyer-card">
                    <div class="card-body">
                        <h5 class="card-title">@GetText("jobTitlePosition")</h5>
                        <h6 class="card-subtitle">@GetText("jobSummaryText")</h6>
                        <p class="card-text">@GetText("jobDetailsPosition")</p>

                        <a href="#" class="card-link underline-anim">
                            @GetText("easyApply")
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>



    <div class="row degismeyen-icerik">

        <div class="down-description">

            <div class="row">
                <div class="centered-header col-12">
                    <h2>@GetText("valuesTitle")</h2>
                </div>
            </div>

            <div class="row values-row-1">
                <div class="col-lg-3 value-box">
                    <div class="value-img-wrapper">
                        <img src="/img/sayfalar/kariyer/daf-kariyer-01.png" class="value-img" alt="@GetText("valueImage1Alt")">
                    </div>
                </div>
                <div class="col-lg-3 value-box">
                    <h2>
                        @GetText("valueTitle1")
                    </h2>
                    <p>
                        @GetText("valueDesc1")
                    </p>
                </div>
                <div class="col-lg-3 value-box">
                    <h2>
                        @GetText("valueTitle2")
                    </h2>
                    <p>
                        @GetText("valueDesc2")
                    </p>
                </div>
                <div class="col-lg-3 value-box">
                    <h2>
                        @GetText("valueTitle3")
                    </h2>
                    <p>
                        @GetText("valueDesc3")
                    </p>
                </div>
            </div>

            <div class="row values-row-2">
                <div class="col-lg-3 value-box">
                    <h2>
                        @GetText("valueTitle4")
                    </h2><p>
                        @GetText("valueDesc4")
                    </p>
                </div>

                <div class="col-lg-3 value-box">
                    <div class="value-img-wrapper">
                        <img src="/img/sayfalar/kariyer/daf-kariyer-02.png" class="value-img" alt="@GetText("valueImage2Alt")">
                    </div>
                </div>

                <div class="col-lg-3 value-box">
                    <h2>
                        @GetText("valueTitle5")
                    </h2><p>
                        @GetText("valueDesc5")
                    </p>
                </div>

                <div class="col-lg-3 value-box">
                    <div class="value-img-wrapper">
                        <img src="/img/sayfalar/kariyer/daf-kariyer-01.png" class="value-img" alt="@GetText("valueImage3Alt")">
                    </div>
                </div>
            </div>

        </div>
    </div>

</section>


