    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(100);
                await JS.InvokeVoidAsync("blazorImageUpload.initDragDrop", dropZoneId, inputFileId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Drag-drop init error: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("blazorImageUpload.disposeDragDrop", dropZoneId);
        }
        catch { }
    }

    private string GetText(string key)
    {
        if (translations.ContainsKey(activeLang) && translations[activeLang].ContainsKey(key))
            return translations[activeLang][key];
        return key;
    }

    private string GetTabClass(string lang) => activeLang == lang ? "nav-link active" : "nav-link";
    private string GetLangClass(string lang) => activeLang == lang ? "d-block" : "d-none";
    private string GetPreviewImage() => string.IsNullOrWhiteSpace(newPartner.ImageUrl) ? "https://via.placeholder.com/400x300?text=Logo" : newPartner.ImageUrl;
    private void SwitchLang(string lang) { activeLang = lang; }
    private void HandleDragEnter() { isDragging = true; }
    private void HandleDragLeave() { isDragging = false; }
    private void HandleDrop(Microsoft.AspNetCore.Components.Web.DragEventArgs e) { isDragging = false; }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            await ProcessImageFile(file);
        }
    }

    private async Task ProcessImageFile(IBrowserFile file)
    {
        try
        {
            isUploading = true;
            StateHasChanged();

            var formFile = new BrowserFileFormFile(file);
            var result = await ImageService.UploadImageAsync(formFile, "partners", maxWidth: 800, maxHeight: 1000);

            if (!result.Success)
            {
                showError = true;
                errorMessage = result.Message;
                return;
            }

            newPartner.ImageUrl = result.FilePath;

            showSuccess = true;
            successMessage = activeLang switch
            {
                "en" => "Logo uploaded successfully!",
                "ar" => "تم رفع الشعار بنجاح!",
                _ => "Logo başarıyla yüklendi!"
            };

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Upload error: {ex.Message}",
                "ar" => $"خطأ في الرفع: {ex.Message}",
                _ => $"Yükleme hatası: {ex.Message}"
            };
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPartners();
    }

    private async Task LoadPartners()
    {
        isListLoading = true;
        try
        {
            partners = await PartnerService.GetAll() ?? new();
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Yükleme hatası: {ex.Message}";
        }
        finally
        {
            isListLoading = false;
        }
    }

    private async Task CreatePartner()
    {
        showError = false;
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(newPartner.Name))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": Şirket adı zorunludur!";
            return;
        }

        if (includeTr && string.IsNullOrWhiteSpace(newPartner.Description_TR))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": Türkçe açıklama zorunludur!";
            return;
        }

        if (includeTr && string.IsNullOrWhiteSpace(newPartner.Slug_TR))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": Türkçe slug zorunludur!";
            return;
        }

        try
        {
            isSaving = true;

            if (!includeTr)
            {
                newPartner.Description_TR = null;
                newPartner.Slug_TR = null;
            }
            if (!includeEn)
            {
                newPartner.Description_EN = null;
                newPartner.Slug_EN = null;
            }
            if (!includeAr)
            {
                newPartner.Description_AR = null;
                newPartner.Slug_AR = null;
            }

            var created = await PartnerService.Create(newPartner);

            successMessage = activeLang switch
            {
                "en" => "Partner added successfully!",
                "ar" => "تمت إضافة الشريك بنجاح!",
                _ => "Ortak başarıyla eklendi!"
            };

            newPartner = new SolutionPartner { IsActive = true };
            includeTr = true;
            includeEn = false;
            includeAr = false;
            await LoadPartners();

            showSuccess = true;
            await Task.Delay(3000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Kaydetme hatası: {ex.Message}";
            Console.WriteLine($"Create error: {ex}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditPartner(SolutionPartner partner)
    {
        // Orijinal veriyi deep copy ile sakla
        originalPartner = new SolutionPartner
        {
            Id = partner.Id,
            Name = partner.Name,
            WebsiteUrl = partner.WebsiteUrl,
            ImageUrl = partner.ImageUrl,
            Description_TR = partner.Description_TR,
            Slug_TR = partner.Slug_TR,
            Description_EN = partner.Description_EN,
            Slug_EN = partner.Slug_EN,
            Description_AR = partner.Description_AR,
            Slug_AR = partner.Slug_AR,
            IsActive = partner.IsActive
        };

        // Düzenleme için yeni kopya oluştur
        newPartner = new SolutionPartner
        {
            Id = partner.Id,
            Name = partner.Name,
            WebsiteUrl = partner.WebsiteUrl,
            ImageUrl = partner.ImageUrl,
            Description_TR = partner.Description_TR,
            Slug_TR = partner.Slug_TR,
            Description_EN = partner.Description_EN,
            Slug_EN = partner.Slug_EN,
            Description_AR = partner.Description_AR,
            Slug_AR = partner.Slug_AR,
            IsActive = partner.IsActive
        };

        // Dil seçimlerini ayarla
        includeTr = !string.IsNullOrWhiteSpace(partner.Description_TR);
        includeEn = !string.IsNullOrWhiteSpace(partner.Description_EN);
        includeAr = !string.IsNullOrWhiteSpace(partner.Description_AR);

        isEditMode = true;
        JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private async Task UpdatePartner()
    {
        if (originalPartner == null) return;

        showError = false;
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(newPartner.Name))
        {
            showError = true;
            errorMessage = "Şirket adı zorunludur!";
            return;
        }

        // ✅ TR alanları kontrol et (Required olduğu için)
        if (string.IsNullOrWhiteSpace(newPartner.Description_TR) ||
            string.IsNullOrWhiteSpace(newPartner.Slug_TR))
        {
            showError = true;
            errorMessage = "Türkçe açıklama ve slug zorunludur!";
            return;
        }

        try
        {
            isSaving = true;

            // ✅ Basit yaklaşım: newPartner'ı direkt kullan
            // Seçilmeyen diller için orijinal değerleri koru
            if (!includeTr)
            {
                newPartner.Description_TR = originalPartner.Description_TR;
                newPartner.Slug_TR = originalPartner.Slug_TR;
            }
            else
            {
                newPartner.Description_TR = newPartner.Description_TR?.Trim();
                newPartner.Slug_TR = newPartner.Slug_TR?.Trim();
            }

            if (!includeEn)
            {
                newPartner.Description_EN = originalPartner.Description_EN;
                newPartner.Slug_EN = originalPartner.Slug_EN;
            }
            else
            {
                newPartner.Description_EN = newPartner.Description_EN?.Trim();
                newPartner.Slug_EN = newPartner.Slug_EN?.Trim();
            }

            if (!includeAr)
            {
                newPartner.Description_AR = originalPartner.Description_AR;
                newPartner.Slug_AR = originalPartner.Slug_AR;
            }
            else
            {
                newPartner.Description_AR = newPartner.Description_AR?.Trim();
                newPartner.Slug_AR = newPartner.Slug_AR?.Trim();
            }

            // ✅ Temel alanları temizle
            newPartner.Name = newPartner.Name?.Trim();
            newPartner.WebsiteUrl = newPartner.WebsiteUrl?.Trim();
            newPartner.ImageUrl = newPartner.ImageUrl?.Trim();

            // Service'e gönder
            var updated = await PartnerService.Update(newPartner.Id, newPartner);

            if (updated == null)
            {
                throw new Exception("Güncelleme başarısız oldu!");
            }

            successMessage = "✓ Ortak başarıyla güncellendi!";
            showSuccess = true;

            // Listeyi yenile
            await LoadPartners();

            // Edit modunu kapat
            CancelEdit();

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Güncelleme hatası: {ex.Message}";

            Console.WriteLine($"Update error: {ex}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner exception: {ex.InnerException.Message}");
                errorMessage += $" | İç Hata: {ex.InnerException.Message}";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelEdit()
    {
        isEditMode = false;
        newPartner = new SolutionPartner { IsActive = true };
        originalPartner = null;
        includeTr = true;
        includeEn = false;
        includeAr = false;
    }

    private async Task DeletePartner(int id, string name)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"{name} isimli ortağı silmek istediğinizden emin misiniz?"))
        {
            try
            {
                var result = await PartnerService.Delete(id);
                if (result)
                {
                    successMessage = $"'{name}' başarıyla silindi.";
                    showSuccess = true;
                    await LoadPartners();

                    if (isEditMode && newPartner.Id == id)
                    {
                        CancelEdit();
                    }

                    await Task.Delay(3000);
                    showSuccess = false;
                }
            }
            catch (Exception ex)
            {
                showError = true;
                errorMessage = $"Silme hatası: {ex.Message}";
            }
        }
    }

    private async Task SearchPartners()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadPartners();
            return;
        }

        isListLoading = true;
        try
        {
            var allPartners = await PartnerService.GetAll();
            partners = allPartners
                .Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           (p.Description_TR != null && p.Description_TR.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Arama hatası: {ex.Message}";
        }
        finally
        {
            isListLoading = false;
        }
    }

    private string GetPartnerDescription(SolutionPartner partner)
    {
        var desc = activeLang switch
        {
            "en" => partner.Description_EN ?? partner.Description_TR,
            "ar" => partner.Description_AR ?? partner.Description_TR,
            _ => partner.Description_TR ?? ""
        };

        if (string.IsNullOrWhiteSpace(desc)) return "";
        return desc.Length > 100 ? desc.Substring(0, 100) + "..." : desc;
    }

    private class BrowserFileFormFile : IFormFile
    {
        private readonly IBrowserFile _file;

        public BrowserFileFormFile(IBrowserFile file)
        {
            _file = file;
        }

        public string ContentType => _file.ContentType;
        public string ContentDisposition => $"form-data; name=\"file\"; filename=\"{_file.Name}\"";
        public IHeaderDictionary Headers => new HeaderDictionary();
        public long Length => _file.Size;
        public string Name => "file";
        public string FileName => _file.Name;

        public Stream OpenReadStream() => _file.OpenReadStream(_file.Size);

        public void CopyTo(Stream target) => OpenReadStream().CopyTo(target);

        public async Task CopyToAsync(Stream target, CancellationToken cancellationToken = default)
        {
            await using var stream = OpenReadStream();
            await stream.CopyToAsync(target, cancellationToken);
        }
    }
}