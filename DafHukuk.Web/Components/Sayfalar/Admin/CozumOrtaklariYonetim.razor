@page "/admin/cozum-ortaklari"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@rendermode InteractiveServer
@implements IAsyncDisposable

@using DafHukuk.Core.Entities
@using System.Net.Http.Json
@inject ISolutionPartnerService PartnerService
@inject IImageService ImageService
@inject IJSRuntime JS

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@GetText("pageTitle")</h2>
            <p class="text-muted mb-0">@GetText("pageSubtitle")</p>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="modern-alert modern-alert-success" role="alert">
            <div class="modern-alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="modern-alert-content">
                <strong>@GetText("successTitle")</strong>
                <p>@successMessage</p>
            </div>
            <button class="modern-alert-close" @onclick="() => showSuccess = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (showError)
    {
        <div class="modern-alert modern-alert-error" role="alert">
            <div class="modern-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="modern-alert-content">
                <strong>@GetText("errorTitle")</strong>
                <p>@errorMessage</p>
            </div>
            <button class="modern-alert-close" @onclick="() => showError = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card admin-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode? GetText("editPartner") : GetText("newPartner"))
                    </h5>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-building me-1"></i>
                            @GetText("name") *
                        </label>
                        <input class="form-control" @bind="newPartner.Name" placeholder="@GetText("namePlaceholder")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-link-45deg me-1"></i>
                            @GetText("website")
                        </label>
                        <input class="form-control" type="url" @bind="newPartner.WebsiteUrl" placeholder="https://..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-image me-1"></i>
                            @GetText("logo")
                        </label>

                        <label for="@inputFileId"
                               class="upload-drop-zone @(isDragging ? "drag-over" : "")"
                               id="@dropZoneId"
                               @ondragenter="HandleDragEnter"
                               @ondragenter:preventDefault
                               @ondragleave="HandleDragLeave"
                               @ondragleave:preventDefault
                               @ondragover:preventDefault
                               @ondrop="HandleDrop"
                               @ondrop:preventDefault
                               style="cursor: pointer; display: block;">
                            <i class="bi bi-cloud-upload fs-1 text-muted mb-2"></i>
                            <p class="mb-1 fw-semibold">@GetText("dragDropLogo")</p>
                            <p class="text-muted small mb-0">@GetText("orClickToSelect")</p>
                            <p class="text-muted small mt-1">@GetText("logoRequirements")</p>
                        </label>

                        <InputFile id="@inputFileId"
                                   OnChange="HandleImageUpload"
                                   accept="image/jpeg,image/png,image/webp"
                                   style="display: none;" />

                        <input class="form-control mt-2" @bind="newPartner.ImageUrl" placeholder="@GetText("orEnterUrl")" />

                        <div class="mt-3 image-preview-wrapper">
                            <img src="@GetPreviewImage()"
                                 class="img-fluid rounded"
                                 alt="@GetText("preview")" />
                        </div>

                        @if (isUploading)
                        {
                            <div class="text-center mt-2">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">@GetText("uploading")</span>
                                </div>
                                <span class="ms-2 text-muted small">@GetText("uploading")</span>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block mb-2">
                            <i class="bi bi-activity me-1"></i>
                            @GetText("activeState")
                        </label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActiveSwitch" @bind="newPartner.IsActive">
                            <label class="form-check-label" for="isActiveSwitch">
                                @(newPartner.IsActive? GetText("active") : GetText("passive"))
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block mb-2">
                            <i class="bi bi-translate me-1"></i>
                            @GetText("languagesToSave")
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="langTr" @bind="includeTr" />
                                <label class="form-check-label" for="langTr">🇹🇷 TR</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="langEn" @bind="includeEn" />
                                <label class="form-check-label" for="langEn">🇬🇧 EN</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="langAr" @bind="includeAr" />
                                <label class="form-check-label" for="langAr">🇸🇦 AR</label>
                            </div>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <button class="btn btn-success btn-lg w-100 mb-2" @onclick="UpdatePartner" disabled="@isSaving">
                            <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-check-circle") me-2"></i>
                            @(isSaving? GetText("updating") : GetText("updatePartner"))
                        </button>
                        <button class="btn btn-outline-secondary btn-lg w-100" @onclick="CancelEdit">
                            <i class="bi bi-x-circle me-2"></i>
                            @GetText("cancel")
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-lg w-100" @onclick="CreatePartner" disabled="@isSaving">
                            <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-save") me-2"></i>
                            @(isSaving? GetText("saving") : GetText("savePartner"))
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card admin-card">
                <div class="card-header bg-white border-bottom">
                    <ul class="nav nav-tabs card-header-tabs nav-fill border-0">
                        <li class="nav-item">
                            <button class='@GetTabClass("tr")' @onclick='() => SwitchLang("tr")' type="button">🇹🇷 Türkçe</button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("en")' @onclick='() => SwitchLang("en")' type="button">🇬🇧 English</button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("ar")' @onclick='() => SwitchLang("ar")' type="button">🇸🇦 العربية</button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">
                    <div class='@GetLangClass("tr")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("description") *</label>
                            <textarea class="form-control" rows="4" @bind="newPartner.Description_TR" placeholder="@GetText("descriptionPlaceholder")"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug") *</label>
                            <input class="form-control" @bind="newPartner.Slug_TR" placeholder="@GetText("slugPlaceholder")" />
                        </div>
                    </div>

                    <div class='@GetLangClass("en")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("description")</label>
                            <textarea class="form-control" rows="4" @bind="newPartner.Description_EN" placeholder="@GetText("descriptionPlaceholder")"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control" @bind="newPartner.Slug_EN" placeholder="@GetText("slugPlaceholder")" />
                        </div>
                    </div>

                    <div class='@GetLangClass("ar")' dir="rtl">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("description")</label>
                            <textarea class="form-control" rows="4" @bind="newPartner.Description_AR" placeholder="@GetText("descriptionPlaceholder")"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control" style="direction:ltr" @bind="newPartner.Slug_AR" placeholder="@GetText("slugPlaceholder")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-globe me-2"></i>
            @GetText("partnerList") (@partners.Count)
        </h3>

        <div class="input-group search-input-group">
            <input type="text" class="form-control" @bind-value="searchTerm" @bind-value:event="oninput" placeholder="@GetText("searchPlaceholder")" />
            <button class="btn btn-outline-secondary" @onclick="SearchPartners">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    @if (isListLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-secondary" role="status">
                <span class="visually-hidden">@GetText("loadingList")</span>
            </div>
            <p class="text-muted mt-2">@GetText("loadingList")</p>
        </div>
    }
    else if (partners.Count == 0)
    {
        <div class="text-center py-5 border rounded bg-light text-muted">
            <i class="bi bi-inbox fs-1 mb-3"></i>
            <p>@GetText("noPartners")</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var partner in partners)
            {
                <div class="col">
                    <div class="admin-content-card h-100 d-flex flex-column">
                        <div class="admin-card-image">
                            <img src="@(string.IsNullOrWhiteSpace(partner.ImageUrl) ? "https://via.placeholder.com/400x300?text=Logo" : partner.ImageUrl)"
                                 class="card-img-top" alt="@partner.Name" />
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2 fw-bold">@partner.Name</h5>
                            @if (!string.IsNullOrWhiteSpace(partner.WebsiteUrl))
                            {
                                <p class="card-text text-muted small mb-2">
                                    <i class="bi bi-link-45deg me-1"></i>
                                    <a href="@partner.WebsiteUrl" target="_blank" rel="noopener">@partner.WebsiteUrl</a>
                                </p>
                            }
                            <p class="card-text flex-grow-1">@GetPartnerDescription(partner)</p>

                            @if (!partner.IsActive)
                            {
                                <span class="badge bg-secondary mb-2">@GetText("passive")</span>
                            }
                        </div>

                        <div class="card-footer bg-white pt-0 border-0">
                            <div class="d-flex gap-2 mt-auto">
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1" @onclick="() => EditPartner(partner)" title="@GetText("edit")">
                                    <i class="bi bi-pencil me-1"></i> @GetText("edit")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePartner(partner.Id, partner.Name)" title="@GetText("delete")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

