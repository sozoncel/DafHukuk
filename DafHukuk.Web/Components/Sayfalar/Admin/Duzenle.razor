    private async Task ProcessImageFile(IBrowserFile file)
    {
        try
        {
            isUploading = true;
            StateHasChanged();

            var formFile = new BrowserFileFormFile(file);
            var result = await ImageService.UploadImageAsync(formFile, "posts", maxWidth: 1200, maxHeight: 800);
            if (!result.Success)
            {
                showError = true;
                errorMessage = result.Message;
                return;
            }

            post.CoverImageUrl = result.FilePath;
            showSuccess = true;
            successMessage = activeLang switch
            {
                "en" => "Image uploaded successfully!",
                "ar" => "تم رفع الصورة بنجاح!",
                _ => "Görsel başarıyla yüklendi!"
            };

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Upload error: {ex.Message}",
                "ar" => $"خطأ في الرفع: {ex.Message}",
                _ => $"Yükleme hatası: {ex.Message}"
            };
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
