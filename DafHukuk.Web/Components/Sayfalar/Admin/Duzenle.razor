    }

    private void GenerateSuggestedSlugs()
    {
        if (post == null) return;

        if (!string.IsNullOrEmpty(post.Title_TR)) suggestedSlugTR = GenerateSlug(post.Title_TR);
        if (!string.IsNullOrEmpty(post.Title_EN)) suggestedSlugEN = GenerateSlug(post.Title_EN);
        if (!string.IsNullOrEmpty(post.Title_AR)) suggestedSlugAR = GenerateSlug(post.Title_AR);
    }

    private string GenerateSlug(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;

        var slug = text.ToLowerInvariant();

        // Türkçe karakterleri değiştir
        slug = slug.Replace("ı", "i")
                   .Replace("ğ", "g")
                   .Replace("ü", "u")
                   .Replace("ş", "s")
                   .Replace("ö", "o")
                   .Replace("ç", "c")
                   .Replace(" ", "-");

        // Geçersiz karakterleri temizle (Regex)
        slug = Regex.Replace(slug, @"[^a-z0-9\s-]", "");

        // Birden fazla tireyi tek tireye indir
        slug = Regex.Replace(slug, @"\s+", " ").Trim();
        slug = Regex.Replace(slug, @"-+", "-");

        return slug;
    }

    private async Task UpdatePost()
    {
        if (post == null || originalPost == null) return;
        showError = false;
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(post.Title_TR) && string.IsNullOrWhiteSpace(post.Title_EN) && string.IsNullOrWhiteSpace(post.Title_AR))
        {
            showError = true;
            errorMessage = activeLang == "tr" ? "En az bir dilde başlık girmelisiniz!" : "You must enter a title in at least one language!";
            return;
        }

        if (post.CategoryId == 0)
        {
            showError = true;
            errorMessage = activeLang == "tr" ? "Lütfen kategori seçiniz!" : "Please select a category!";
            return;
        }

        try
        {
            isSaving = true;
            // Entity oluştur
            var updatePost = new Post
            {
                Id = PostId,
                CategoryId = post.CategoryId,
                IsActive = post.IsActive,
                PublishedDate = post.PublishedDate,
                CoverImageUrl = post.CoverImageUrl,
                ServiceType = post.ServiceType // ✅ ServiceType eklendi
            };

            // Dil seçimlerini eşle
            updatePost.Title_TR = includeTr ? post.Title_TR : originalPost.Title_TR;
            updatePost.Content_TR = includeTr ? post.Content_TR : originalPost.Content_TR;
            updatePost.Slug_TR = includeTr ? post.Slug_TR : originalPost.Slug_TR;

            updatePost.Title_EN = includeEn ? post.Title_EN : originalPost.Title_EN;
            updatePost.Content_EN = includeEn ? post.Content_EN : originalPost.Content_EN;
            updatePost.Slug_EN = includeEn ? post.Slug_EN : originalPost.Slug_EN;

            updatePost.Title_AR = includeAr ? post.Title_AR : originalPost.Title_AR;
            updatePost.Content_AR = includeAr ? post.Content_AR : originalPost.Content_AR;
            updatePost.Slug_AR = includeAr ? post.Slug_AR : originalPost.Slug_AR;

            var updatedPost = await PostService.Update(PostId, updatePost);
            if (updatedPost == null)
            {
                throw new Exception("Güncelleme başarısız oldu!");
            }

            successMessage = activeLang == "tr" ? "✓ İçerik başarıyla güncellendi!" : "✓ Content updated successfully!";
            showSuccess = true;

            await Task.Delay(1000);
            post = updatedPost;

            // Orijinali güncelle ve kategori değişim bayrağını sıfırla
            originalCategoryId = post.CategoryId;
            categoryChanged = false;

            originalPost = new Post
            {
                Id = post.Id,
                Title_TR = post.Title_TR,
                Content_TR = post.Content_TR,
                Slug_TR = post.Slug_TR,
                Title_EN = post.Title_EN,
                Content_EN = post.Content_EN,
                Slug_EN = post.Slug_EN,
                Title_AR = post.Title_AR,
                Content_AR = post.Content_AR,
                Slug_AR = post.Slug_AR,
                CategoryId = post.CategoryId,
                CoverImageUrl = post.CoverImageUrl,
                PublishedDate = post.PublishedDate,
                IsActive = post.IsActive,
                ServiceType = post.ServiceType
            };

            includeTr = !string.IsNullOrWhiteSpace(post.Title_TR);
            includeEn = !string.IsNullOrWhiteSpace(post.Title_EN);
            includeAr = !string.IsNullOrWhiteSpace(post.Title_AR);

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"❌ Hata: {ex.Message}";
            Console.WriteLine($"Update error: {ex}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePost()
    {
        if (post == null) return;
        if (await JS.InvokeAsync<bool>("confirm", GetText("confirmDelete")))
        {
            try
            {
                isSaving = true;
                var result = await PostService.Delete(PostId);

                if (result)
                {
                    await JS.InvokeVoidAsync("alert", activeLang == "tr" ? "İçerik başarıyla silindi." : "Content deleted successfully.");
                    Navigation.NavigateTo("/admin/yonetim");
                }
                else
                {
                    showError = true;
                    errorMessage = activeLang switch
                    {
                        "en" => "Deletion failed. The content might have already been deleted.",
                        "ar" => "فشل الحذف. قد يكون المحتوى محذوفًا بالفعل.",
                        _ => "Silme başarısız. İçerik zaten silinmiş olabilir."
                    };
                }
            }
            catch (Exception ex)
            {
                showError = true;
                errorMessage = activeLang switch
                {
                    "en" => $"Error during deletion: {ex.Message}",
                    "ar" => $"خطأ أثناء الحذف: {ex.Message}",
                    _ => $"Silme sırasında hata: {ex.Message}"
                };
            }
            finally
            {
                isSaving = false;
            }
        }
    }

    private class BrowserFileFormFile : IFormFile
    {
        private readonly IBrowserFile _file;
        public BrowserFileFormFile(IBrowserFile file)
        {
            _file = file;
        }

        public string ContentType => _file.ContentType;
        public string ContentDisposition => $"form-data; name=\"file\"; filename=\"{_file.Name}\"";
        public IHeaderDictionary Headers => new HeaderDictionary();
        public long Length => _file.Size;
        public string Name => "file";
        public string FileName => _file.Name;

        public Stream OpenReadStream() => _file.OpenReadStream(_file.Size);
        public void CopyTo(Stream target) => OpenReadStream().CopyTo(target);
        public async Task CopyToAsync(Stream target, CancellationToken cancellationToken = default)
        {
            await using var stream = OpenReadStream();
            await stream.CopyToAsync(target, cancellationToken);
        }
    }

