    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("blazorImageUpload.initDragDrop", dropZoneId, inputFileId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("blazorImageUpload.disposeDragDrop", dropZoneId);
        }
        catch { }
    }

    private string GetText(string key)
    {
        if (translations.ContainsKey(activeLang) && translations[activeLang].ContainsKey(key))
            return translations[activeLang][key];
        return key;
    }

    private string GetTabClass(string lang) => activeLang == lang ? "nav-link active" : "nav-link";
    private string GetLangClass(string lang) => activeLang == lang ? "d-block" : "d-none";
    private string GetPreviewImage() => string.IsNullOrWhiteSpace(post?.CoverImageUrl) ? "https://via.placeholder.com/600x300?text=Kapak+Önizleme" : post.CoverImageUrl;
    private void SwitchLang(string lang) { activeLang = lang; }
    private void HandleDragEnter() { isDragging = true; }
    private void HandleDragLeave() { isDragging = false; }
    private void HandleDrop(Microsoft.AspNetCore.Components.Web.DragEventArgs e) { isDragging = false; }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            await ProcessImageFile(file);
        }
    }

    private async Task ProcessImageFile(IBrowserFile file)
    {
        const long maxFileSize = 10 * 1024 * 1024;

        if (file.Size > maxFileSize)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => "File size must be less than 10MB!",
                "ar" => "يجب أن يكون حجم الملف أقل من 10 ميجابايت!",
                _ => "Dosya boyutu 10MB'dan küçük olmalıdır!"
            };
            return;
        }

        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Invalid file format. Allowed: {string.Join(", ", allowedExtensions)}",
                "ar" => $"تنسيق ملف غير صالح. المسموح: {string.Join(", ", allowedExtensions)}",
                _ => $"Geçersiz dosya formatı. İzin verilen: {string.Join(", ", allowedExtensions)}"
            };
            return;
        }

        try
        {
            isUploading = true;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("/api/image/upload?entityType=posts", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImageUploadResult>();
                if (result?.Success == true && !string.IsNullOrWhiteSpace(result.FilePath))
                {
                    post.CoverImageUrl = result.FilePath;

                    showSuccess = true;
                    successMessage = activeLang switch
                    {
                        "en" => "Image uploaded successfully!",
                        "ar" => "تم رفع الصورة بنجاح!",
                        _ => "Görsel başarıyla yüklendi!"
                    };

                    await Task.Delay(2000);
                    showSuccess = false;
                }
                else
                {
                    showError = true;
                    errorMessage = result?.Message ?? (activeLang switch
                    {
                        "en" => "Image could not be uploaded.",
                        "ar" => "لم يتم رفع الصورة.",
                        _ => "Görsel yüklenemedi."
                    });
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<ImageUploadResult>();
                showError = true;
                errorMessage = errorResult?.Message ?? (activeLang switch
                {
                    "en" => "Image upload failed.",
                    "ar" => "فشل رفع الصورة.",
                    _ => "Görsel yükleme başarısız oldu."
                });
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Upload error: {ex.Message}",
                "ar" => $"خطأ في الرفع: {ex.Message}",
                _ => $"Yükleme hatası: {ex.Message}"
            };
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        showError = false;
        showSuccess = false;

        try
        {
            await LoadCategories();

            if (PostId == 0)
            {
                allPosts = await PostService.GetAll();
                isLoading = false;
                return;
            }

            post = await PostService.GetById(PostId);

            if (post == null)
            {
                errorMessage = activeLang == "tr" ? "İçerik bulunamadı!" : "Content not found!";
                showError = true;
                await Task.Delay(2000);
                Navigation.NavigateTo("/admin/yonetim");
                return;
            }

            originalPost = new Post
            {
                Id = post.Id,
                Title_TR = post.Title_TR,
                Content_TR = post.Content_TR,
                Slug_TR = post.Slug_TR,
                Title_EN = post.Title_EN,
                Content_EN = post.Content_EN,
                Slug_EN = post.Slug_EN,
                Title_AR = post.Title_AR,
                Content_AR = post.Content_AR,
                Slug_AR = post.Slug_AR,
                CategoryId = post.CategoryId,
                CoverImageUrl = post.CoverImageUrl,
                PublishedDate = post.PublishedDate,
                IsActive = post.IsActive
            };

            includeTr = !string.IsNullOrWhiteSpace(post.Title_TR);
            includeEn = !string.IsNullOrWhiteSpace(post.Title_EN);
            includeAr = !string.IsNullOrWhiteSpace(post.Title_AR);

            if (includeTr) activeLang = "tr";
            else if (includeEn) activeLang = "en";
            else if (includeAr) activeLang = "ar";
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAll() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kategori yükleme hatası: {ex.Message}");
        }
    }

    private async Task UpdatePost()
    {
        if (post == null || originalPost == null) return;

        showError = false;
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(post.Title_TR) && string.IsNullOrWhiteSpace(post.Title_EN) && string.IsNullOrWhiteSpace(post.Title_AR))
        {
            showError = true;
            errorMessage = activeLang == "tr" ? "En az bir dilde başlık girmelisiniz!" : "You must enter a title in at least one language!";
            return;
        }

        if (post.CategoryId == 0)
        {
            showError = true;
            errorMessage = activeLang == "tr" ? "Lütfen kategori seçiniz!" : "Please select a category!";
            return;
        }

        try
        {
            isSaving = true;

            var updatePost = new Post
            {
                Id = PostId,
                CategoryId = post.CategoryId,
                IsActive = post.IsActive,
                PublishedDate = post.PublishedDate,
                CoverImageUrl = post.CoverImageUrl
            };

            if (includeTr)
            {
                updatePost.Title_TR = post.Title_TR;
                updatePost.Content_TR = post.Content_TR;
                updatePost.Slug_TR = post.Slug_TR;
            }
            else
            {
                updatePost.Title_TR = originalPost.Title_TR;
                updatePost.Content_TR = originalPost.Content_TR;
                updatePost.Slug_TR = originalPost.Slug_TR;
            }

            if (includeEn)
            {
                updatePost.Title_EN = post.Title_EN;
                updatePost.Content_EN = post.Content_EN;
                updatePost.Slug_EN = post.Slug_EN;
            }
            else
            {
                updatePost.Title_EN = originalPost.Title_EN;
                updatePost.Content_EN = originalPost.Content_EN;
                updatePost.Slug_EN = originalPost.Slug_EN;
            }

            if (includeAr)
            {
                updatePost.Title_AR = post.Title_AR;
                updatePost.Content_AR = post.Content_AR;
                updatePost.Slug_AR = post.Slug_AR;
            }
            else
            {
                updatePost.Title_AR = originalPost.Title_AR;
                updatePost.Content_AR = originalPost.Content_AR;
                updatePost.Slug_AR = originalPost.Slug_AR;
            }

            updatePost.Category = null;

            var updatedPost = await PostService.Update(PostId, updatePost);

            if (updatedPost == null)
            {
                throw new Exception("Güncelleme başarısız oldu!");
            }

            successMessage = activeLang == "tr" ? "✓ İçerik başarıyla güncellendi!" : "✓ Content updated successfully!";
            showSuccess = true;

            await Task.Delay(1000);
            post = updatedPost;

            originalPost = new Post
            {
                Id = post.Id,
                Title_TR = post.Title_TR,
                Content_TR = post.Content_TR,
                Slug_TR = post.Slug_TR,
                Title_EN = post.Title_EN,
                Content_EN = post.Content_EN,
                Slug_EN = post.Slug_EN,
                Title_AR = post.Title_AR,
                Content_AR = post.Content_AR,
                Slug_AR = post.Slug_AR,
                CategoryId = post.CategoryId,
                CoverImageUrl = post.CoverImageUrl,
                PublishedDate = post.PublishedDate,
                IsActive = post.IsActive
            };

            includeTr = !string.IsNullOrWhiteSpace(post.Title_TR);
            includeEn = !string.IsNullOrWhiteSpace(post.Title_EN);
            includeAr = !string.IsNullOrWhiteSpace(post.Title_AR);

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"❌ Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePost()
    {
        if (post == null) return;

        if (await JS.InvokeAsync<bool>("confirm", GetText("confirmDelete")))
        {
            try
            {
                isSaving = true;

                var result = await PostService.Delete(PostId);

                if (result)
                {
                    await JS.InvokeVoidAsync("alert", activeLang == "tr" ? "İçerik başarıyla silindi." : "Content deleted successfully.");
                    Navigation.NavigateTo("/admin/yonetim");
                }
                else
                {
                    showError = true;
                    errorMessage = activeLang switch
                    {
                        "en" => "Deletion failed. The content might have already been deleted.",
                        "ar" => "فشل الحذف. قد يكون المحتوى محذوفًا بالفعل.",
                        _ => "Silme başarısız. İçerik zaten silinmiş olabilir."
                    };
                }
            }
            catch (Exception ex)
            {
                showError = true;
                errorMessage = activeLang switch
                {
                    "en" => $"Error during deletion: {ex.Message}",
                    "ar" => $"خطأ أثناء الحذف: {ex.Message}",
                    _ => $"Silme sırasında hata: {ex.Message}"
                };
            }
            finally
            {
                isSaving = false;
            }
        }
    }

    private string GetCategoryName(Category? category)
    {
        if (category == null) return "";
        return activeLang switch
        {
            "en" => category.Name_EN ?? category.Name_TR,
            "ar" => category.Name_AR ?? category.Name_TR,
            _ => category.Name_TR
        };
    }

    private string GetCategoryColorByName(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName)) return "#3b82f6";
        return categoryName.ToLowerInvariant() switch
        {
            "hizmetlerimiz" or "our services" => "#366C80",
            "duyurular" or "announcements" => "#5c7341",
            "etkinlikler" or "events" => "#78514A",
            "yayınlar" or "yayinlar" or "publications" => "#dfb899",
            _ => "#3b82f6"
        };
    }

