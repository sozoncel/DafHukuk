    // ✅ Kategori değişimi kontrolü ve ServiceType gösterimi
    private void OnCategoryChanged()
    {
        if (post != null && originalCategoryId != post.CategoryId)
        {
            categoryChanged = true;
            GenerateSuggestedSlugs();
        }
        else
        {
            categoryChanged = false;
        }

        // ServiceType kontrolü
        CheckIfServiceCategory();
    }

    // ✅ ServiceType kontrolü - Hizmetlerimiz kategorisinde mi?
    private void CheckIfServiceCategory()
    {
        if (post == null) return;

        var selectedCategory = categories.FirstOrDefault(c => c.Id == post.CategoryId);
        if (selectedCategory != null)
        {
            var categoryName = (selectedCategory.Name_TR ?? selectedCategory.Name_EN ?? "").ToLowerInvariant();
            isServiceCategory = categoryName.Contains("hizmet") || categoryName.Contains("service");
        }
        else
        {
            isServiceCategory = false;
        }

        // Eğer Hizmetlerimiz kategorisi değilse ServiceType'ı None yap
        if (!isServiceCategory)
        {
            post.ServiceType = ServiceType.None;
        }
    }

