@page "/admin/duzenle/{PostId:int}"
@page "/admin/duzenle"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@rendermode InteractiveServer
@implements IAsyncDisposable

@using DafHukuk.Core.Entities
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject IImageService ImageService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@GetText("editPageTitle")</h2>
            <p class="text-muted mb-0">@GetText("editPageSubtitle")</p>
        </div>
        <a href="/admin/yonetim" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>
            @GetText("backToList")
        </a>
    </div>

    @if (PostId == 0)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card admin-card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">
                            <i class="bi bi-search me-2"></i>
                            @GetText("selectPostToEdit")
                        </h5>

                        @if (allPosts.Count == 0)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
                                <p class="text-muted">@GetText("noPostsAvailable")</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var p in allPosts)
                                {
                                    <a href="@($"/admin/duzenle/{p.Id}")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="post-select-icon">
                                                <i class="bi bi-file-text"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1">@(p.Title_TR ?? p.Title_EN ?? p.Title_AR ?? "Başlıksız")</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>@p.PublishedDate.ToShortDateString()
                                                    @if (p.Category != null)
                                                    {
                                                        <span class="ms-2 badge" style="background-color: @GetCategoryColorByName(p.Category.Name_TR);">
                                                            @p.Category.Name_TR
                                                        </span>
                                                    }
                                                    @if (p.ServiceType != ServiceType.None)
                                                    {
                                                        <span class="ms-1 badge bg-light text-dark">
                                                            @GetServiceTypeName(p.ServiceType)
                                                        </span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@GetText("loading")</span>
                </div>
                <p class="text-muted mt-2">@GetText("loading")</p>
            </div>
        }
        else if (post == null)
        {
            <div class="modern-alert modern-alert-error" role="alert">
                <div class="modern-alert-icon"><i class="bi bi-x-octagon-fill"></i></div>
                <div class="modern-alert-content">
                    <strong>@GetText("errorTitle")</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }
        else
        {
            @if (showSuccess)
            {
                <div class="modern-alert modern-alert-success" role="alert">
                    <div class="modern-alert-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="modern-alert-content">
                        <strong>@GetText("successTitle")</strong>
                        <p>@successMessage</p>
                    </div>
                    <button class="modern-alert-close" @onclick="() => showSuccess = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            @if (showError)
            {
                <div class="modern-alert modern-alert-error" role="alert">
                    <div class="modern-alert-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="modern-alert-content">
                        <strong>@GetText("errorTitle")</strong>
                        <p>@errorMessage</p>
                    </div>
                    <button class="modern-alert-close" @onclick="() => showError = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }

            <div class="row g-4 mb-5">
                <div class="col-lg-4">
                    <div class="card admin-card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-4">
                                <i class="bi bi-info-circle me-2"></i>
                                @GetText("generalInfo")
                            </h5>

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-folder me-1"></i>
                                    @GetText("category")
                                </label>
                                <select class="form-select" @bind="post.CategoryId" @bind:after="OnCategoryChanged">
                                    <option value="0">-- @GetText("selectCategory") --</option>
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c.Id">@GetCategoryName(c)</option>
                                    }
                                </select>
                                @if (categoryChanged)
                                {
                                    <div class="alert alert-warning mt-2 small">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Kategori değişti! Slug (URL) yollarını kontrol ediniz.
                                    </div>
                                }
                            </div>

                            @* ✅ ServiceType Dropdown - Sadece Hizmetlerimiz kategorisinde görünür *@
                            @if (isServiceCategory)
                            {
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="bi bi-gear me-1"></i>
                                        @GetText("serviceType")
                                    </label>
                                    <select class="form-select" @bind="post.ServiceType">
                                        <option value="@ServiceType.None">-- @GetText("selectServiceType") --</option>
                                        <option value="@ServiceType.GeneralServices">@GetText("generalServices")</option>
                                        <option value="@ServiceType.SpecialConsultancy">@GetText("specialConsultancy")</option>
                                        <option value="@ServiceType.ExpertOpinion">@GetText("expertOpinion")</option>
                                        <option value="@ServiceType.Mediation">@GetText("mediation")</option>
                                    </select>
                                    <small class="text-muted">@GetText("serviceTypeHelp")</small>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-image me-1"></i>
                                    @GetText("coverImage")
                                </label>

                                <label for="@inputFileId"
                                       class="upload-drop-zone @(isDragging ? "drag-over" : "")"
                                       id="@dropZoneId"
                                       @ondragenter="HandleDragEnter"
                                       @ondragenter:preventDefault
                                       @ondragleave="HandleDragLeave"
                                       @ondragleave:preventDefault
                                       @ondragover:preventDefault
                                       @ondrop="HandleDrop"
                                       @ondrop:preventDefault
                                       style="cursor: pointer; display: block;">
                                    <i class="bi bi-cloud-upload fs-1 text-muted mb-2"></i>
                                    <p class="mb-1 fw-semibold">@GetText("dragDropImage")</p>
                                    <p class="text-muted small mb-0">@GetText("orClickToSelect")</p>
                                    <p class="text-muted small mt-1">@GetText("imageRequirements")</p>
                                </label>

                                <InputFile id="@inputFileId"
                                           OnChange="HandleImageUpload"
                                           accept="image/jpeg,image/png,image/webp"
                                           style="display: none;" />

                                <input class="form-control mt-2"
                                       @bind="post.CoverImageUrl"
                                       placeholder="@GetText("orEnterUrl")" />

                                <div class="mt-3 image-preview-wrapper">
                                    <img src="@GetPreviewImage()"
                                         class="img-fluid rounded"
                                         alt="@GetText("preview")" />
                                </div>

                                @if (isUploading)
                                {
                                    <div class="text-center mt-2">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">@GetText("uploading")</span>
                                        </div>
                                        <span class="ms-2 text-muted small">@GetText("uploading")</span>
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @GetText("publishDate")
                                </label>
                                <InputDate class="form-control" @bind-Value="post.PublishedDate" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label d-block mb-2">
                                    <i class="bi bi-activity me-1"></i>
                                    @GetText("activeState")
                                </label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isActiveSwitch" @bind="post.IsActive">
                                    <label class="form-check-label" for="isActiveSwitch">
                                        @(post.IsActive? GetText("active") : GetText("passive"))
                                    </label>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label d-block mb-2">
                                    <i class="bi bi-translate me-1"></i>
                                    @GetText("languagesToSave")
                                </label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="langTr" @bind="includeTr" />
                                        <label class="form-check-label" for="langTr">🇹🇷 TR</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="langEn" @bind="includeEn" />
                                        <label class="form-check-label" for="langEn">🇬🇧 EN</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="langAr" @bind="includeAr" />
                                        <label class="form-check-label" for="langAr">🇸🇦 AR</label>
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-success btn-lg w-100"
                                    @onclick="UpdatePost"
                                    disabled="@isSaving">
                                <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-check-circle") me-2"></i>
                                @(isSaving? GetText("updating") : GetText("updateContent"))
                            </button>

                            <button class="btn btn-danger btn-lg w-100 mt-2"
                                    @onclick="DeletePost"
                                    disabled="@isSaving">
                                <i class="bi bi-trash me-2"></i>
                                @GetText("deleteContent")
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card admin-card h-100">
                        <div class="card-header bg-white border-bottom">
                            <ul class="nav nav-tabs card-header-tabs nav-fill border-0">
                                <li class="nav-item">
                                    <button class='@GetTabClass("tr")' @onclick='() => SwitchLang("tr")' type="button">🇹🇷 Türkçe</button>
                                </li>
                                <li class="nav-item">
                                    <button class='@GetTabClass("en")' @onclick='() => SwitchLang("en")' type="button">🇬🇧 English</button>
                                </li>
                                <li class="nav-item">
                                    <button class='@GetTabClass("ar")' @onclick='() => SwitchLang("ar")' type="button">🇸🇦 العربية</button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body">
                            <div class='@GetLangClass("tr")'>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("title")</label>
                                    <input class="form-control form-control-lg"
                                           @bind="post.Title_TR"
                                           @bind:after="UpdateSlugTR"
                                           placeholder="@GetText("titlePlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("slug")</label>
                                    <input class="form-control"
                                           @bind="post.Slug_TR"
                                           placeholder="@GetText("slugPlaceholder")" />
                                    @if (categoryChanged && !string.IsNullOrEmpty(suggestedSlugTR))
                                    {
                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ApplySuggestedSlugTR">
                                            <i class="bi bi-magic me-1"></i>
                                            Önerilen: @suggestedSlugTR
                                        </button>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("content")</label>
                                 @*    <textarea class="form-control"
                                              rows="10"
                                              @bind="post.Content_TR"
                                              placeholder="@GetText("contentPlaceholder")"></textarea> *@
                                    <RadzenHtmlEditor @bind-Value="post.Content_TR" style="height: 350px;" Placeholder="@GetText("contentPlaceholder")">
                                        <RadzenHtmlEditorUndo />
                                        <RadzenHtmlEditorRedo />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorBold />
                                        <RadzenHtmlEditorItalic />
                                        <RadzenHtmlEditorUnderline />
                                        <RadzenHtmlEditorStrikeThrough />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorAlignLeft />
                                        <RadzenHtmlEditorAlignCenter />
                                        <RadzenHtmlEditorAlignRight />
                                        <RadzenHtmlEditorJustify />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorFormatBlock /> <RadzenHtmlEditorUnorderedList /> <RadzenHtmlEditorOrderedList /> <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorLink />
                                        <RadzenHtmlEditorUnlink />
                                    </RadzenHtmlEditor>
                                   
                                </div>
                            </div>

                            <div class='@GetLangClass("en")'>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("title")</label>
                                    <input class="form-control form-control-lg"
                                           @bind="post.Title_EN"
                                           @bind:after="UpdateSlugEN"
                                           placeholder="@GetText("titlePlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("slug")</label>
                                    <input class="form-control"
                                           @bind="post.Slug_EN"
                                           placeholder="@GetText("slugPlaceholder")" />
                                    @if (categoryChanged && !string.IsNullOrEmpty(suggestedSlugEN))
                                    {
                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ApplySuggestedSlugEN">
                                            <i class="bi bi-magic me-1"></i>
                                            Suggested: @suggestedSlugEN
                                        </button>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("content")</label>
                                   @*  <textarea class="form-control"
                                              rows="10"
                                              @bind="post.Content_EN"
                                              placeholder="@GetText("contentPlaceholder")"></textarea> *@
                                    <RadzenHtmlEditor @bind-Value="post.Content_EN" style="height: 350px;" Placeholder="@GetText("contentPlaceholder")">
                                        <RadzenHtmlEditorUndo />
                                        <RadzenHtmlEditorRedo />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorBold />
                                        <RadzenHtmlEditorItalic />
                                        <RadzenHtmlEditorUnderline />
                                        <RadzenHtmlEditorStrikeThrough />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorAlignLeft />
                                        <RadzenHtmlEditorAlignCenter />
                                        <RadzenHtmlEditorAlignRight />
                                        <RadzenHtmlEditorJustify />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorFormatBlock /> <RadzenHtmlEditorUnorderedList /> <RadzenHtmlEditorOrderedList /> <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorLink />
                                        <RadzenHtmlEditorUnlink />
                                    </RadzenHtmlEditor>
                                </div>
                            </div>

                            <div class='@GetLangClass("ar")' dir="rtl">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("title")</label>
                                    <input class="form-control form-control-lg"
                                           @bind="post.Title_AR"
                                           @bind:after="UpdateSlugAR"
                                           placeholder="@GetText("titlePlaceholder")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("slug")</label>
                                    <input class="form-control"
                                           style="direction:ltr"
                                           @bind="post.Slug_AR"
                                           placeholder="@GetText("slugPlaceholder")" />
                                    @if (categoryChanged && !string.IsNullOrEmpty(suggestedSlugAR))
                                    {
                                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ApplySuggestedSlugAR">
                                            <i class="bi bi-magic me-1"></i>
                                            مقترح: @suggestedSlugAR
                                        </button>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@GetText("content")</label>
                                   @*  <textarea class="form-control"
                                              rows="10"
                                              @bind="post.Content_AR"
                                              placeholder="@GetText("contentPlaceholder")"></textarea> *@
                                    <RadzenHtmlEditor @bind-Value="post.Content_AR" style="height: 350px;" Placeholder="@GetText("contentPlaceholder")">
                                        <RadzenHtmlEditorUndo />
                                        <RadzenHtmlEditorRedo />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorBold />
                                        <RadzenHtmlEditorItalic />
                                        <RadzenHtmlEditorUnderline />
                                        <RadzenHtmlEditorStrikeThrough />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorAlignLeft />
                                        <RadzenHtmlEditorAlignCenter />
                                        <RadzenHtmlEditorAlignRight />
                                        <RadzenHtmlEditorJustify />
                                        <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorFormatBlock /> <RadzenHtmlEditorUnorderedList /> <RadzenHtmlEditorOrderedList /> <RadzenHtmlEditorSeparator />
                                        <RadzenHtmlEditorLink />
                                        <RadzenHtmlEditorUnlink />
                                    </RadzenHtmlEditor>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

