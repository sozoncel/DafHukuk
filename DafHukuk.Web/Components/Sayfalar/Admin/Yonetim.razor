            "ar" => category.Name_AR ?? category.Name_TR ?? "عام",
            _ => category.Name_TR ?? "Genel"
        };
    }

    private string GetCategoryName(Category? category)
    {
        if (category == null) return "Genel";
        return activeLang switch
        {
            "en" => category.Name_EN ?? category.Name_TR ?? "General",
            "ar" => category.Name_AR ?? category.Name_TR ?? "عام",
            _ => category.Name_TR ?? "Genel"
        };
    }

    private string GetPostTitle(Post p)
    {
        return filterLanguage switch
        {
            "en" => p.Title_EN ?? p.Title_TR ?? "",
            "ar" => p.Title_AR ?? p.Title_TR ?? "",
            _ => p.Title_TR ?? ""
        };
    }

    private string GetPostSummary(Post p)
    {
        string content = filterLanguage switch
        {
            "en" => p.Content_EN ?? p.Content_TR ?? "",
            "ar" => p.Content_AR ?? p.Content_TR ?? "",
            _ => p.Content_TR ?? ""
        };

        if (string.IsNullOrWhiteSpace(content)) return "İçerik yok...";
        content = content.Replace(Environment.NewLine, " ").Trim();
        return content.Length > 100 ? content.Substring(0, 100) + "..." : content;
    }

    private string GetPostUrl(Post p)
    {
        if (p?.Category == null) return "#";

        string categoryName = filterLanguage switch
        {
            "en" => p.Category.Name_EN ?? p.Category.Name_TR,
            "ar" => p.Category.Name_AR ?? p.Category.Name_TR,
            _ => p.Category.Name_TR
        };

        string slug = filterLanguage switch
        {
            "en" => p.Slug_EN ?? p.Slug_TR,
            "ar" => p.Slug_AR ?? p.Slug_TR,
            _ => p.Slug_TR
        };

        if (string.IsNullOrWhiteSpace(categoryName) || string.IsNullOrWhiteSpace(slug))
            return "#";

        return $"/{categoryName.Trim().ToLower()}/{slug}";
    }

    private string GetCategoryColor(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
            return "#3b82f6";
        return categoryName.ToLowerInvariant() switch
        {
            "hizmetlerimiz" or "our services" => "#366C80",
            "duyurular" or "announcements" => "#5c7341",
            "etkinlikler" or "events" => "#78514A",
            "yayınlar" or "yayinlar" or "publications" => "#dfb899",
            _ => "#3b82f6"
        };
    }
