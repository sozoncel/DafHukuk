    private async Task HandlePostImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            await ProcessImageFile(file);
        }
    }

    private async Task ProcessImageFile(IBrowserFile file)
    {
        try
        {
            isUploading = true;
            StateHasChanged();

            var formFile = new BrowserFileFormFile(file);
            var result = await ImageService.UploadImageAsync(formFile, "posts", maxWidth: 1200, maxHeight: 800);

            if (!result.Success)
            {
                showError = true;
                errorMessage = result.Message;
                return;
            }

            newPost.CoverImageUrl = result.FilePath;

            showSuccess = true;
            successMessage = activeLang switch
            {
                "en" => "Image uploaded successfully!",
                "ar" => "تم رفع الصورة بنجاح!",
                _ => "Görsel başarıyla yüklendi!"
            };

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Upload error: {ex.Message}",
                "ar" => $"خطأ في الرفع: {ex.Message}",
                _ => $"Yükleme hatası: {ex.Message}"
            };
            Console.WriteLine($"Exception: {ex}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadPosts();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAll() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kategori yükleme hatası: {ex.Message}");
        }
    }

    private async Task LoadPosts()
    {
        isListLoading = true;
        try
        {
            if (filterCategoryId > 0)
            {
                posts = await PostService.GetAll(filterCategoryId);
            }
            else
            {
                posts = await PostService.GetAll();
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"İçerikler yüklenirken hata: {ex.Message}";
            posts = new List<Post>();
        }
        finally
        {
            isListLoading = false;
        }
    }

    private class BrowserFileFormFile : IFormFile
    {
        private readonly IBrowserFile _file;

        public BrowserFileFormFile(IBrowserFile file)
        {
            _file = file;
        }

        public string ContentType => _file.ContentType;
        public string ContentDisposition => $"form-data; name=\"file\"; filename=\"{_file.Name}\"";
        public IHeaderDictionary Headers => new HeaderDictionary();
        public long Length => _file.Size;
        public string Name => "file";
        public string FileName => _file.Name;

        public Stream OpenReadStream() => _file.OpenReadStream(_file.Size);

        public void CopyTo(Stream target) => OpenReadStream().CopyTo(target);

        public async Task CopyToAsync(Stream target, CancellationToken cancellationToken = default)
        {
            await using var stream = OpenReadStream();
            await stream.CopyToAsync(target, cancellationToken);
        }
    }

    private async Task OnFilterChange()
    {
        await LoadPosts();
    }

    private async Task SearchContent()
    {
        isListLoading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                await LoadPosts();
                return;
            }
            posts = await PostService.Search(searchTerm);
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Arama yapılırken hata: {ex.Message}";
            posts = new List<Post>();
        }
        finally
        {
            isListLoading = false;
        }
    }

    private async Task CreatePost()
    {
        showError = false;
        showSuccess = false;

        if (includeTr && string.IsNullOrWhiteSpace(newPost.Title_TR))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": " + (activeLang == "tr" ? "Türkçe başlık zorunludur." : "Turkish title is required.");
            return;
        }

        if (newPost.CategoryId == 0)
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": " + (activeLang == "tr" ? "Lütfen kategori seçiniz." : "Please select a category.");
            return;
        }

        if (!includeTr && !includeEn && !includeAr)
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": " + (activeLang == "tr" ? "En az bir dil seçmelisiniz." : "You must select at least one language.");
            return;
        }

        try
        {
            isSaving = true;
            if (!includeTr)
            {
                newPost.Title_TR = null;
                newPost.Slug_TR = null;
                newPost.Content_TR = null;
            }
            if (!includeEn)
            {
                newPost.Title_EN = null;
                newPost.Slug_EN = null;
                newPost.Content_EN = null;
            }
            if (!includeAr)
            {
                newPost.Title_AR = null;
                newPost.Slug_AR = null;
                newPost.Content_AR = null;
            }

            var createdPost = await PostService.Create(newPost);
            if (createdPost == null || createdPost.Id == 0)
            {
                throw new InvalidOperationException("Post oluşturulamadı.");
            }

            successMessage = activeLang switch
            {
                "en" => "Content created successfully!",
                "ar" => "تم إنشاء المحتوى بنجاح!",
                _ => "İçerik başarıyla eklendi!"
            };

            newPost = new Post { PublishedDate = DateTime.Today, IsActive = true, ServiceType = ServiceType.None };
            isServiceCategory = false;
            await LoadPosts();

            showSuccess = true;
            await Task.Delay(3000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Error during saving: {ex.Message}",
                "ar" => $"خطأ أثناء الحفظ: {ex.Message}",
                _ => $"Kaydetme sırasında hata: {ex.Message}"
            };
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePost(int postId, string postTitle)
    {
        var confirmationMessage = $"{postTitle} başlıklı içeriği silmek istediğinizden emin misiniz?";
        if (filterLanguage == "en") confirmationMessage = $"Are you sure you want to delete the content titled {postTitle}?";
        if (filterLanguage == "ar") confirmationMessage = $"هل أنت متأكد من حذف المحتوى بعنوان {postTitle}؟";

        if (await JS.InvokeAsync<bool>("confirm", confirmationMessage))
        {
            try
            {
                var result = await PostService.Delete(postId);
                if (result)
                {
                    await LoadPosts();
                    showSuccess = true;
                    successMessage = filterLanguage switch
                    {
                        "en" => $"Content '{postTitle}' deleted successfully.",
                        "ar" => $"تم حذف المحتوى '{postTitle}' بنجاح.",
                        _ => $"'{postTitle}' başlıklı içerik başarıyla silindi."
                    };
                    await Task.Delay(3000);
                    showSuccess = false;
                }
                else
                {
                    showError = true;
                    errorMessage = filterLanguage switch
                    {
                        "en" => "Deletion failed. The content might have already been deleted.",
                        "ar" => "فشل الحذف. قد يكون المحتوى محذوفًا بالفعل.",
                        _ => "Silme başarısız. İçerik zaten silinmiş olabilir."
                    };
                }
            }
            catch (Exception ex)
            {
                showError = true;
                errorMessage = filterLanguage switch
                {
                    "en" => $"Error during deletion: {ex.Message}",
                    "ar" => $"خطأ أثناء الحذف: {ex.Message}",
                    _ => $"Silme sırasında hata: {ex.Message}"
                };
            }
        }
    }

    private string GetCategoryNameByFilter(Category? category)
