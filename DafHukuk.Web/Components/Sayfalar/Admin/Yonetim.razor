@page "/admin/yonetim"
@layout DafHukuk.Web.Components.Layout.AdminMainLayout
@rendermode InteractiveServer
@implements IAsyncDisposable

@using DafHukuk.Core.Entities
@using System.Net.Http.Json
@inject ICategoryService CategoryService
@inject IPostService PostService
@inject IImageService ImageService
@inject IJSRuntime JS

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@GetText("pageTitle")</h2>
            <p class="text-muted mb-0">@GetText("pageSubtitle")</p>
        </div>
    </div>

    @if (showSuccess)
    {
        <div class="modern-alert modern-alert-success" role="alert">
            <div class="modern-alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="modern-alert-content">
                <strong>@GetText("successTitle")</strong>
                <p>@successMessage</p>
            </div>
            <button class="modern-alert-close" @onclick="() => showSuccess = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (showError)
    {
        <div class="modern-alert modern-alert-error" role="alert">
            <div class="modern-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="modern-alert-content">
                <strong>@GetText("errorTitle")</strong>
                <p>@errorMessage</p>
            </div>
            <button class="modern-alert-close" @onclick="() => showError = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="row g-4 mb-5">
        <div class="col-lg-4">
            <div class="card admin-card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-plus-circle me-2"></i>
                        @GetText("newContentTitle")
                    </h5>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-folder me-1"></i>
                            @GetText("category")
                        </label>
                        <select class="form-select" @bind="newPost.CategoryId" @bind:after="OnCategoryChanged">
                            <option value="0">-- @GetText("selectCategory") --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@GetCategoryName(c)</option>
                            }
                        </select>
                    </div>

                    @if (isServiceCategory)
                    {
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-gear me-1"></i>
                                @GetText("serviceType")
                            </label>
                            <select class="form-select" @bind="newPost.ServiceType">
                                <option value="@ServiceType.None">-- @GetText("selectServiceType") --</option>
                                <option value="@ServiceType.GeneralServices">@GetText("generalServices")</option>
                                <option value="@ServiceType.SpecialConsultancy">@GetText("specialConsultancy")</option>
                                <option value="@ServiceType.ExpertOpinion">@GetText("expertOpinion")</option>
                                <option value="@ServiceType.Mediation">@GetText("mediation")</option>
                            </select>
                            <small class="text-muted">@GetText("serviceTypeHelp")</small>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-image me-1"></i>
                            @GetText("coverImage")
                        </label>

                        <label for="@inputFileId"
                               class="upload-drop-zone @(isDragging ? "drag-over" : "")"
                               id="@dropZoneId"
                               @ondragenter="HandleDragEnter"
                               @ondragenter:preventDefault
                               @ondragleave="HandleDragLeave"
                               @ondragleave:preventDefault
                               @ondragover:preventDefault
                               @ondrop="HandlePostDrop"
                               @ondrop:preventDefault
                               style="cursor: pointer; display: block;">
                            <i class="bi bi-cloud-upload fs-1 text-muted mb-2"></i>
                            <p class="mb-1 fw-semibold">@GetText("dragDropImage")</p>
                            <p class="text-muted small mb-0">@GetText("orClickToSelect")</p>
                            <p class="text-muted small mt-1">@GetText("imageRequirements")</p>
                        </label>

                        <InputFile id="@inputFileId"
                                   OnChange="HandlePostImageUpload"
                                   accept="image/jpeg,image/png,image/webp"
                                   style="display: none;" />

                        <input class="form-control mt-2"
                               @bind="newPost.CoverImageUrl"
                               placeholder="@GetText("orEnterUrl")" />

                        <div class="mt-3 image-preview-wrapper">
                            <img src="@GetPreviewImage()"
                                 class="img-fluid rounded"
                                 alt="@GetText("preview")" />
                        </div>

                        @if (isUploading)
                        {
                            <div class="text-center mt-2">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">@GetText("uploading")</span>
                                </div>
                                <span class="ms-2 text-muted small">@GetText("uploading")</span>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-calendar-event me-1"></i>
                            @GetText("publishDate")
                        </label>
                        <InputDate class="form-control" @bind-Value="newPost.PublishedDate" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block mb-2">
                            <i class="bi bi-activity me-1"></i>
                            @GetText("activeState")
                        </label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActiveSwitch" @bind="newPost.IsActive">
                            <label class="form-check-label" for="isActiveSwitch">
                                @(newPost.IsActive? GetText("active") : GetText("passive"))
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block mb-2">
                            <i class="bi bi-translate me-1"></i>
                            @GetText("languagesToSave")
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="langTr" @bind="includeTr" />
                                <label class="form-check-label" for="langTr">🇹🇷 TR</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="langEn" @bind="includeEn" />
                                <label class="form-check-label" for="langEn">🇬🇧 EN</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="langAr" @bind="includeAr" />
                                <label class="form-check-label" for="langAr">🇸🇦 AR</label>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-lg w-100"
                            @onclick="CreatePost"
                            disabled="@isSaving">
                        <i class="bi @(isSaving ? "bi-hourglass-split" : "bi-save") me-2"></i>
                        @(isSaving? GetText("saving") : GetText("saveContent"))
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card admin-card">
                <div class="card-header bg-white border-bottom">
                    <ul class="nav nav-tabs card-header-tabs nav-fill border-0">
                        <li class="nav-item">
                            <button class='@GetTabClass("tr")' @onclick='() => SwitchLang("tr")' type="button">🇹🇷 Türkçe</button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("en")' @onclick='() => SwitchLang("en")' type="button">🇬🇧 English</button>
                        </li>
                        <li class="nav-item">
                            <button class='@GetTabClass("ar")' @onclick='() => SwitchLang("ar")' type="button">🇸🇦 العربية</button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">
                    <div class='@GetLangClass("tr")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("title")</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_TR"
                                   placeholder="@GetText("titlePlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control"
                                   @bind="newPost.Slug_TR"
                                   placeholder="@GetText("slugPlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("content")</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_TR"
                                      placeholder="@GetText("contentPlaceholder")"></textarea>
                        </div>
                    </div>

                    <div class='@GetLangClass("en")'>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("title")</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_EN"
                                   placeholder="@GetText("titlePlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control"
                                   @bind="newPost.Slug_EN"
                                   placeholder="@GetText("slugPlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("content")</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_EN"
                                      placeholder="@GetText("contentPlaceholder")"></textarea>
                        </div>
                    </div>

                    <div class='@GetLangClass("ar")' dir="rtl">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("title")</label>
                            <input class="form-control form-control-lg"
                                   @bind="newPost.Title_AR"
                                   placeholder="@GetText("titlePlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("slug")</label>
                            <input class="form-control"
                                   style="direction:ltr"
                                   @bind="newPost.Slug_AR"
                                   placeholder="@GetText("slugPlaceholder")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@GetText("content")</label>
                            <textarea class="form-control"
                                      rows="10"
                                      @bind="newPost.Content_AR"
                                      placeholder="@GetText("contentPlaceholder")"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-list-columns-reverse me-2"></i>
            @GetText("contentList") (@posts.Count)
        </h3>

        <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2 w-100 w-md-auto">
            <div class="input-group search-input-group">
                <input type="text" class="form-control" @bind-value="searchTerm" @bind-value:event="oninput" placeholder="@GetText("searchPlaceholder")" />
                <button class="btn btn-outline-secondary" @onclick="SearchContent">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            <select class="form-select filter-select" @bind="filterCategoryId" @bind:after="OnFilterChange">
                <option value="0">@GetText("allCategories")</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@GetCategoryNameByFilter(c)</option>
                }
            </select>

            <select class="form-select filter-select" @bind="filterLanguage" @bind:after="OnFilterChange">
                <option value="tr">🇹🇷 TR</option>
                <option value="en">🇬🇧 EN</option>
                <option value="ar">🇸🇦 AR</option>
            </select>
        </div>
    </div>

    @if (isListLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-secondary" role="status">
                <span class="visually-hidden">@GetText("loadingList")</span>
            </div>
            <p class="text-muted mt-2">@GetText("loadingList")</p>
        </div>
    }
    else if (posts.Count == 0)
    {
        <div class="text-center py-5 border rounded bg-light text-muted">
            <i class="bi bi-inbox fs-1 mb-3"></i>
            <p>@GetText("noContent")</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var p in posts)
            {
                var categoryName = p.Category != null ? GetCategoryNameByFilter(p.Category) : "Genel";
                var url = GetPostUrl(p);

                <div class="col">
                    <div class="admin-content-card h-100 d-flex flex-column position-relative">

                        <div class="admin-category-badge"
                             style="background-color: @GetCategoryColor(categoryName);
                                           position: absolute;
                                           top: 10px;
                                           left: 10px;
                                           z-index: 10;
                                           padding: 5px 10px;
                                           border-radius: 5px;
                                           color: white;
                                           font-size: 0.8rem;
                                           font-weight: bold;
                                           box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                            @categoryName
                            @if (p.ServiceType != ServiceType.None)
                            {
                                <span class="badge bg-light text-dark ms-1">@GetServiceTypeName(p.ServiceType)</span>
                            }
                        </div>

                        <div class="admin-card-image">
                            <img src="@(string.IsNullOrWhiteSpace(p.CoverImageUrl) ? "https://via.placeholder.com/600x300?text=Görsel+Yok" : p.CoverImageUrl)"
                                 class="card-img-top" alt="@GetPostTitle(p)" />
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2 fw-bold">@GetPostTitle(p)</h5>
                            <p class="card-text text-muted small mb-3">
                                <i class="bi bi-calendar me-1"></i> @p.PublishedDate.ToShortDateString()
                            </p>
                            <p class="card-text flex-grow-1">@GetPostSummary(p)</p>
                        </div>

                        <div class="card-footer bg-white pt-0 border-0">
                            <div class="d-flex gap-2 mt-auto">
                                <a href="@url"
                                   class="btn btn-sm btn-outline-primary flex-grow-1" target="_blank">
                                    <i class="bi bi-eye me-1"></i> @GetTextForList("view")
                                </a>

                                <a href="@($"/admin/duzenle/{p.Id}")"
                                   class="btn btn-sm btn-outline-secondary"
                                   title="@GetTextForList("edit")">
                                    <i class="bi bi-pencil me-1"></i> @GetTextForList("edit")
                                </a>

                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePost(p.Id, GetPostTitle(p))" title="@GetTextForList("delete")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
