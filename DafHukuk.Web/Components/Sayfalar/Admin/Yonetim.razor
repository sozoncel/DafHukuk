    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(100);
                await JS.InvokeVoidAsync("blazorImageUpload.initDragDrop", dropZoneId, inputFileId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Drag-drop init error: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("blazorImageUpload.disposeDragDrop", dropZoneId);
        }
        catch { }
    }

    private void OnCategoryChanged()
    {
        var selectedCategory = categories.FirstOrDefault(c => c.Id == newPost.CategoryId);
        if (selectedCategory != null)
        {
            var categoryName = (selectedCategory.Name_TR ?? selectedCategory.Name_EN ?? "").ToLowerInvariant();
            isServiceCategory = categoryName.Contains("hizmet") || categoryName.Contains("service");
        }
        else
        {
            isServiceCategory = false;
        }

        if (!isServiceCategory)
        {
            newPost.ServiceType = ServiceType.None;
        }
    }

    private string GetServiceTypeName(ServiceType serviceType)
    {
        return serviceType switch
        {
            ServiceType.GeneralServices => activeLang == "tr" ? "Genel" : activeLang == "en" ? "General" : "عام",
            ServiceType.SpecialConsultancy => activeLang == "tr" ? "Özel" : activeLang == "en" ? "Special" : "خاص",
            ServiceType.ExpertOpinion => activeLang == "tr" ? "Uzman" : activeLang == "en" ? "Expert" : "خبير",
            ServiceType.Mediation => activeLang == "tr" ? "Arabulucu" : activeLang == "en" ? "Mediation" : "وساطة",
            _ => ""
        };
    }

