    private string GetText(string key)
    {
        if (translations.ContainsKey(activeLang) && translations[activeLang].ContainsKey(key))
            return translations[activeLang][key];
        return key;
    }

    private string GetTabClass(string lang) => activeLang == lang ? "nav-link active" : "nav-link";
    private string GetLangClass(string lang) => activeLang == lang ? "d-block" : "d-none";
    private string GetPreviewImage() => string.IsNullOrWhiteSpace(newLawyer.ImageUrl) ? "https://via.placeholder.com/400x400?text=Avatar" : newLawyer.ImageUrl;
    private void SwitchLang(string lang) { activeLang = lang; }

    private void HandleDragEnter()
    {
        isDragging = true;
    }

    private void HandleDragLeave()
    {
        isDragging = false;
    }

    private async Task HandleLawyerDrop(Microsoft.AspNetCore.Components.Web.DragEventArgs e)
    {
        isDragging = false;
        if (lawyerImageInput?.Element != null)
        {
            await lawyerImageInput.Element.Value.FocusAsync();
        }
    }

    private async Task OpenLawyerFileDialog()
    {
        if (lawyerImageInput?.Element != null)
        {
            await lawyerImageInput.Element.Value.FocusAsync();
            await JS.InvokeVoidAsync("eval", "arguments[0].click()", lawyerImageInput.Element);
        }
    }

    private async Task HandleLawyerImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            await ProcessImageFile(file);
        }
    }

    private async Task ProcessImageFile(IBrowserFile file)
    {
        const long maxFileSize = 10 * 1024 * 1024;

        if (file.Size > maxFileSize)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => "File size must be less than 10MB!",
                "ar" => "يجب أن يكون حجم الملف أقل من 10 ميجابايت!",
                _ => "Dosya boyutu 10MB'dan küçük olmalıdır!"
            };
            return;
        }

        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Invalid file format. Allowed: {string.Join(", ", allowedExtensions)}",
                "ar" => $"تنسيق ملف غير صالح. المسموح: {string.Join(", ", allowedExtensions)}",
                _ => $"Geçersiz dosya formatı. İzin verilen: {string.Join(", ", allowedExtensions)}"
            };
            return;
        }

        try
        {
            isUploading = true;
            StateHasChanged();

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("/api/image/upload?entityType=lawyers", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImageUploadResult>();
                if (result?.Success == true && !string.IsNullOrWhiteSpace(result.FilePath))
                {
                    newLawyer.ImageUrl = result.FilePath;

                    showSuccess = true;
                    successMessage = activeLang switch
                    {
                        "en" => "Photo uploaded successfully!",
                        "ar" => "تم رفع الصورة بنجاح!",
                        _ => "Fotoğraf başarıyla yüklendi!"
                    };

                    await Task.Delay(2000);
                    showSuccess = false;
                }
                else
                {
                    showError = true;
                    errorMessage = result?.Message ?? (activeLang switch
                    {
                        "en" => "Photo could not be uploaded.",
                        "ar" => "لم يتم رفع الصورة.",
                        _ => "Fotoğraf yüklenemedi."
                    });
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<ImageUploadResult>();
                showError = true;
                errorMessage = errorResult?.Message ?? (activeLang switch
                {
                    "en" => "Photo upload failed.",
                    "ar" => "فشل رفع الصورة.",
                    _ => "Fotoğraf yükleme başarısız oldu."
                });
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = activeLang switch
            {
                "en" => $"Upload error: {ex.Message}",
                "ar" => $"خطأ في الرفع: {ex.Message}",
                _ => $"Yükleme hatası: {ex.Message}"
            };
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLawyers();
    }

    private async Task LoadLawyers()
    {
        isListLoading = true;
        try
        {
            lawyers = await LawyerService.GetAll() ?? new();
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Yükleme hatası: {ex.Message}";
        }
        finally
        {
            isListLoading = false;
        }
    }

    private async Task CreateLawyer()
    {
        showError = false;
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(newLawyer.Name))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": Ad Soyad zorunludur!";
            return;
        }

        if (includeTr && string.IsNullOrWhiteSpace(newLawyer.Title_TR))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": Türkçe ünvan zorunludur!";
            return;
        }

        if (includeTr && string.IsNullOrWhiteSpace(newLawyer.Slug_TR))
        {
            showError = true;
            errorMessage = GetText("errorTitle") + ": Türkçe slug zorunludur!";
            return;
        }

        try
        {
            isSaving = true;

            if (!includeTr)
            {
                newLawyer.Title_TR = null;
                newLawyer.Slug_TR = null;
                newLawyer.Biography_TR = null;
            }
            if (!includeEn)
            {
                newLawyer.Title_EN = null;
                newLawyer.Slug_EN = null;
                newLawyer.Biography_EN = null;
            }
            if (!includeAr)
            {
                newLawyer.Title_AR = null;
                newLawyer.Slug_AR = null;
                newLawyer.Biography_AR = null;
            }

            var created = await LawyerService.Create(newLawyer);

            successMessage = activeLang switch
            {
                "en" => "Lawyer added successfully!",
                "ar" => "تمت إضافة المحامي بنجاح!",
                _ => "Avukat başarıyla eklendi!"
            };

            newLawyer = new Lawyer { IsActive = true };
            includeTr = true;
            includeEn = false;
            includeAr = false;
            await LoadLawyers();

            showSuccess = true;
            await Task.Delay(3000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Kaydetme hatası: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

