    private async Task UpdateLawyer()
    {
        if (originalLawyer == null) return;

        showError = false;
        showSuccess = false;

        if (string.IsNullOrWhiteSpace(newLawyer.Name))
        {
            showError = true;
            errorMessage = "Ad Soyad zorunludur!";
            return;
        }

        try
        {
            isSaving = true;

            var updateLawyer = new Lawyer
            {
                Id = newLawyer.Id,
                Name = newLawyer.Name,
                Email = newLawyer.Email,
                MobilePhone = newLawyer.MobilePhone,
                OfficePhone = newLawyer.OfficePhone,
                Location = newLawyer.Location,
                ImageUrl = newLawyer.ImageUrl,
                IsActive = newLawyer.IsActive
            };

            if (includeTr)
            {
                updateLawyer.Title_TR = newLawyer.Title_TR;
                updateLawyer.Slug_TR = newLawyer.Slug_TR;
                updateLawyer.Biography_TR = newLawyer.Biography_TR;
            }
            else
            {
                updateLawyer.Title_TR = originalLawyer.Title_TR;
                updateLawyer.Slug_TR = originalLawyer.Slug_TR;
                updateLawyer.Biography_TR = originalLawyer.Biography_TR;
            }

            if (includeEn)
            {
                updateLawyer.Title_EN = newLawyer.Title_EN;
                updateLawyer.Slug_EN = newLawyer.Slug_EN;
                updateLawyer.Biography_EN = newLawyer.Biography_EN;
            }
            else
            {
                updateLawyer.Title_EN = originalLawyer.Title_EN;
                updateLawyer.Slug_EN = originalLawyer.Slug_EN;
                updateLawyer.Biography_EN = originalLawyer.Biography_EN;
            }

            if (includeAr)
            {
                updateLawyer.Title_AR = newLawyer.Title_AR;
                updateLawyer.Slug_AR = newLawyer.Slug_AR;
                updateLawyer.Biography_AR = newLawyer.Biography_AR;
            }
            else
            {
                updateLawyer.Title_AR = originalLawyer.Title_AR;
                updateLawyer.Slug_AR = originalLawyer.Slug_AR;
                updateLawyer.Biography_AR = originalLawyer.Biography_AR;
            }

            var updated = await LawyerService.Update(newLawyer.Id, updateLawyer);

            successMessage = "✓ Avukat başarıyla güncellendi!";
            showSuccess = true;

            await LoadLawyers();
            CancelEdit();

            await Task.Delay(2000);
            showSuccess = false;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Güncelleme hatası: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelEdit()
    {
        isEditMode = false;
        newLawyer = new Lawyer { IsActive = true };
        originalLawyer = null;
        includeTr = true;
        includeEn = false;
        includeAr = false;
    }

    private async Task DeleteLawyer(int id, string name)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"{name} isimli avukatı silmek istediğinizden emin misiniz?"))
        {
            try
            {
                var result = await LawyerService.Delete(id);
                if (result)
                {
                    successMessage = $"'{name}' başarıyla silindi.";
                    showSuccess = true;
                    await LoadLawyers();

                    if (isEditMode && newLawyer.Id == id)
                    {
                        CancelEdit();
                    }

                    await Task.Delay(3000);
                    showSuccess = false;
                }
            }
            catch (Exception ex)
            {
                showError = true;
                errorMessage = $"Silme hatası: {ex.Message}";
            }
        }
    }

    private async Task SearchLawyers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadLawyers();
            return;
        }

        isListLoading = true;
        try
        {
            var allLawyers = await LawyerService.GetAll();
            lawyers = allLawyers
                .Where(l => l.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                           (l.Email != null && l.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                           (l.Title_TR != null && l.Title_TR.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Arama hatası: {ex.Message}";
        }
        finally
        {
            isListLoading = false;
        }
    }

    private string GetLawyerTitle(Lawyer lawyer)
    {
        return activeLang switch
        {
            "en" => lawyer.Title_EN ?? lawyer.Title_TR ?? "",
            "ar" => lawyer.Title_AR ?? lawyer.Title_TR ?? "",
            _ => lawyer.Title_TR ?? ""
        };
    }

