            ["contactButton"] = "اتصل"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadServices();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task LoadServices()
    {
        IsLoading = true;
        try
        {
            // ServiceType.GeneralServices olan postları getir
            ServicePosts = await PostService.GetByServiceType(ServiceType.GeneralServices);
            ServicePosts = ServicePosts.Where(p => p.IsActive).OrderBy(p => GetPostTitle(p)).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hata: {ex.Message}");
            ServicePosts = new List<Post>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetPostUrl(Post post)
    {
        if (post?.Category == null) return "#";
        var categorySlug = "hizmetlerimiz";
        var postSlug = GetPostSlug(post);
        return CurrentLang switch
        {
            "en" => $"/en/services/{postSlug}",
            "ar" => $"/ar/services/{postSlug}",
            _ => $"/{categorySlug}/{postSlug}"
        };
    }

    private string GetText(string key)
    {
        if (Translations.ContainsKey(CurrentLang) && Translations[CurrentLang].ContainsKey(key))
            return Translations[CurrentLang][key];
        return key;
    }

    private string GetPostTitle(Post post)
    {
        return CurrentLang switch
        {
            "en" => post.Title_EN ?? post.Title_TR ?? "",
            "ar" => post.Title_AR ?? post.Title_TR ?? "",
            _ => post.Title_TR ?? ""
        };
    }

    private string GetPostSlug(Post post)
    {
        return CurrentLang switch
        {
            "en" => post.Slug_EN ?? post.Slug_TR ?? "",
            "ar" => post.Slug_AR ?? post.Slug_TR ?? "",
            _ => post.Slug_TR ?? ""
        };
    }

    private string GetLocalizedUrl(string path)
    {
        return LanguageService.GetLocalizedUrl(path);
    }
}